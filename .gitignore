# OIB source data and registry
/data/oib_registry.json
/data/*.zip

# Local environment and job stores
.env
deploy/.env
jobs.db
summaries.db
checkpoints.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# `lib/` above is a Python build-artifact pattern, but it matches at ANY depth —
# without these negations it also swallows source directories named `lib/` in the
# JS/TS frontends. That failure is silent: the file builds locally, is simply
# absent from the branch, and CI fails on an unresolvable import.
!frontends/*/src/**/lib/
!frontends/ui/src/**/lib/
!frontends/ui/tests/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

