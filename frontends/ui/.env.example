# =============================================================================
# AIQ Blueprint UI - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# =============================================================================
# Backend Configuration
# =============================================================================
# Backend URL - runtime configurable (no rebuild needed for containers)
# BACKEND_URL=http://localhost:8000

# =============================================================================
# Authentication
# =============================================================================
# Authentication is DISABLED by default. The app works with "Default User"
# and no login is required.
#
# To enable WorkOS AuthKit authentication, set REQUIRE_AUTH=true and configure
# the WorkOS settings below.
# REQUIRE_AUTH=true

# =============================================================================
# WorkOS AuthKit (required when REQUIRE_AUTH=true)
# =============================================================================
# WORKOS_CLIENT_ID=client_xxx
# WORKOS_API_KEY=sk_test_xxx
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# WORKOS_COOKIE_PASSWORD=replace-with-32-byte-random-string

# =============================================================================
# File Upload Configuration
# =============================================================================
# These settings control file upload validation in the knowledge layer.
# Values should match backend limits for consistent user experience.

# Accepted file extensions (comma-separated, include leading dots)
# Images (.png,.jpg,.jpeg) are opt-in and NOT shipped in the defaults: image
# ingestion requires a configured VLM (AIQ_VLM_* on the backend), so add the
# image types here AND enable the WorkOS `image-upload` feature flag (FB-15a) —
# they must be configured together. When the flag is off, image types are
# stripped from the client accept-list and rejected server-side (400).
# FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.txt,.md,.docx,.pptx
#   with images (requires VLM + image-upload flag):
#   FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.txt,.md,.docx,.pptx,.png,.jpg,.jpeg

# Maximum total file size in MB
# FILE_UPLOAD_MAX_SIZE_MB=100

# Maximum number of files per session
# FILE_UPLOAD_MAX_FILE_COUNT=10

# Hours after upload before files may expire on the backend (0 = no expiry shown),
#this should ideally match TTL of the files on the backend (e.g. 12 hours)
# FILE_EXPIRATION_CHECK_INTERVAL_HOURS=0

# =============================================================================
# SeaweedFS / S3-compatible object storage
# =============================================================================
# SEAWEED_ENDPOINT=http://localhost:8333
# SEAWEED_ACCESS_KEY=seaweedadmin
# SEAWEED_SECRET_KEY=seaweedadmin
# SEAWEED_BUCKET=grid-documents
# SEAWEED_PRESIGNED_URL_TTL_SECONDS=600

# Per-organization buckets (ADR-0043). `true` writes each org's objects into its
# own bucket instead of a key prefix inside SEAWEED_BUCKET. Safe to flip: the
# bucket is recorded on every document row, so existing objects stay readable
# where they are and only new writes move.
# SEAWEED_PER_ORG_BUCKETS=false
# SEAWEED_TENANT_BUCKET_PREFIX=grid-org-

# Credential allowed to CREATE and DROP tenant buckets — separate from the keys
# above because SeaweedFS grants CreateBucket and DeleteBucket as one action, so
# this is what keeps "drop a tenant" off the upload path. Unset falls back to
# SEAWEED_ACCESS_KEY / SEAWEED_SECRET_KEY, which is fine while per-org buckets
# are off (nothing calls it there).
# SEAWEED_TENANT_ADMIN_ACCESS_KEY=seaweedadmin
# SEAWEED_TENANT_ADMIN_SECRET_KEY=seaweedadmin

# =============================================================================
# Grid App Database
# =============================================================================
GRID_APP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grid_app
