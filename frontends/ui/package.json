{
  "name": "aiq-blueprint-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names \",next\" \"npm run dev:proxy\" \"npm run dev:next\"",
    "dev:proxy": "node server.js",
    "dev:next": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "migrate:storage": "node scripts/migrate-storage.mjs",
    "generate:cards": "node scripts/generate-card-schemas.mjs",
    "provision:audit-schemas": "node scripts/provision-workos-audit-schemas.mjs",
    "test": "TZ=UTC vitest --no-watch",
    "test:watch": "TZ=UTC vitest",
    "test:ci": "TZ=UTC vitest run --coverage",
    "ci:local": "./scripts/ci-check.sh",
    "ci:quick": "./scripts/ci-check.sh --quick",
    "ci:fast": "./scripts/ci-check.sh --no-clean",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.13",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^3.3.0",
    "@react-pdf/renderer": "^4.3.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-form": "^1.23.0",
    "@tanstack/react-query": "^5.101.2",
    "@uppy/core": "^5.2.0",
    "@uppy/react": "^5.2.0",
    "@uppy/xhr-upload": "^5.2.0",
    "@workos-inc/authkit-nextjs": "^4.1.4",
    "@workos-inc/node": "^10.7.0",
    "@workos-inc/widgets": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.6.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "http-proxy": "^1.18.1",
    "ioredis": "^5.11.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.545.0",
    "marked": "^16.4.2",
    "motion": "^12.42.2",
    "next": "^16.2.9",
    "postgres": "^3.4.0",
    "react": "^18.2.0",
    "react-complex-tree": "^2.6.2",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "roughjs": "^4.6.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "uuid": "^11.1.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@mswjs/data": "^0.16.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "15.5.15",
    "happy-dom": "^20.3.4",
    "husky": "^9.1.7",
    "json-schema-to-zod": "^2.6.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.10",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tailwindcss": "^4.0.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
