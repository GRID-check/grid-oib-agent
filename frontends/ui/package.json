{
  "name": "aiq-blueprint-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names \",next\" \"bun run dev:proxy\" \"bun run dev:next\"",
    "dev:proxy": "node server.js",
    "dev:next": "node scripts/copy-pdfjs-assets.mjs && next dev --turbopack -p 3001",
    "build": "node scripts/copy-pdfjs-assets.mjs && next build",
    "start": "NODE_ENV=production node server.js",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "lint": "node scripts/check-static-utility-modifiers.mjs && oxlint src tests",
    "lint:fix": "node scripts/check-static-utility-modifiers.mjs && oxlint src tests --fix",
    "format": "prettier --write .",
    "type-check": "bun check",
    "db:migrate": "drizzle-kit migrate",
    "migrate:storage": "node scripts/migrate-storage.mjs",
    "generate:cards": "node scripts/generate-card-schemas.mjs",
    "generate:wire": "node scripts/generate-wire-schemas.mjs",
    "provision:audit-schemas": "node scripts/provision-workos-audit-schemas.mjs",
    "test": "TZ=UTC vitest --no-watch",
    "test:watch": "TZ=UTC vitest",
    "test:ci": "TZ=UTC vitest run --coverage",
    "test:shard": "TZ=UTC vitest run --coverage --reporter=blob",
    "test:merge": "TZ=UTC vitest run --merge-reports=.vitest-reports --coverage",
    "ci:local": "task -d ../.. fe:verify",
    "ci:quick": "task -d ../.. verify:fast",
    "prepare": "husky",
    "provision:authz": "bun scripts/provision-workos-authz.ts",
    "migrate:folder-grants": "bun scripts/migrate-folder-grants-to-workos.ts",
    "regrant:office-shelf": "bun scripts/regrant-office-shelf-permission.ts",
    "provision:workos-env": "bun scripts/provision-workos-environment.ts"
  },
  "dependencies": {
