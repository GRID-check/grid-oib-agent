---
import '../styles/global.css'
import { getImage } from 'astro:assets'
import heroImage from '../assets/hero.jpg'
import NavBar from '../components/molecules/NavBar.astro'
import SheetIndex from '../components/molecules/SheetIndex.astro'
import Footer from '../components/molecules/Footer.astro'
import { ui, defaultLang, type Locale } from '../i18n/ui'
import { getLangFromUrl, getPathWithoutLocale } from '../i18n/utils'

interface Props {
  title?: string
  description?: string
  locale?: Locale
  alternates?: { de: string; en: string } | false
  switchTo?: string
  /** Keep the page out of the index — error pages, not content. */
  noindex?: boolean
}
const {
  title,
  description,
  locale = getLangFromUrl(Astro.url),
  alternates,
  switchTo,
  noindex = false,
} = Astro.props

const t = ui[locale]
const pageTitle = title ?? t.meta.title
const pageDescription = description ?? t.meta.description

const autoDe = getPathWithoutLocale(Astro.url.pathname)
const auto = { de: autoDe, en: `/en${autoDe === '/' ? '/' : autoDe}` }
const paths = alternates === false ? null : (alternates ?? auto)
const canonicalPath = (paths ?? auto)[locale]
const canonical = new URL(canonicalPath, Astro.site)
const other: Locale = locale === defaultLang ? 'en' : defaultLang
const switchPath = switchTo ?? (paths ?? auto)[other]

// Social preview. The hero plate is the only illustration the site owns, so it
// is reprocessed once at build time into the 1.91:1 box every card reader wants
// rather than shipped at its native 16:9 and cropped differently everywhere.
// `layout: 'none'` matters: the project default is `constrained`, which would
// emit a six-width srcset of a card image nothing responsive ever renders — six
// unreferenced JPEGs shipped in the client bundle.
const OG = { width: 1200, height: 630 }
const ogImage = await getImage({
  src: heroImage,
  format: 'jpeg',
  quality: 82,
  layout: 'none',
  ...OG,
})
const ogImageUrl = new URL(ogImage.src, Astro.site)

// Deliberately minimal: only facts this repo can stand behind. No founder,
// no address, no rating — the Impressum is still a placeholder.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Piloti',
  url: new URL('/', Astro.site).href,
  email: 'hallo@piloti.eu',
  description: pageDescription,
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {
      paths && (
        <>
          <link rel="alternate" hreflang="de" href={new URL(paths.de, Astro.site)} />
          <link rel="alternate" hreflang="en" href={new URL(paths.en, Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(paths.de, Astro.site)} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Piloti" />
    <meta property="og:locale" content={locale === 'de' ? 'de_AT' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'de' ? 'en_GB' : 'de_AT'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG.width)} />
    <meta property="og:image:height" content={String(OG.height)} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#f7f7f3" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/archivo-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- The mark is drawn as paths, not as a `<text>` element: the data-URI
         favicon this replaces rendered its "P" in whatever the reader's default
         sans happened to be, so the logo changed shape per platform. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
      >{t.skipLink}</a
    >
    <NavBar locale={locale} switchTo={switchPath} />
    <SheetIndex />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<script>
  import { initNav } from '../scripts/nav'
  import { initSignIn } from '../scripts/sign-in'
  initNav()
  initSignIn()
</script>
