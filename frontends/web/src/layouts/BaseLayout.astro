---
import '../styles/global.css'
import NavBar from '../components/molecules/NavBar.astro'
import SheetIndex from '../components/molecules/SheetIndex.astro'
import Footer from '../components/molecules/Footer.astro'
import SeoHead from '../components/seo/SeoHead.astro'
import { ui, defaultLang, type Locale } from '../i18n/ui'
import { getLangFromUrl, getPathWithoutLocale } from '../i18n/utils'
import type { Article, OgImage } from '../lib/seo'
import pageTransitions from '../scripts/page-transitions.js?raw'

interface Props {
  title?: string
  description?: string
  locale?: Locale
  alternates?: { de: string; en: string } | false
  switchTo?: string
  /** Share image; defaults to `defaultOgImage(locale)` in lib/seo.ts. */
  ogImage?: OgImage
  /** Marks the page an article (og:type, article:published_time). */
  article?: Article
  /** Page-specific JSON-LD nodes, added to the site graph every page carries. */
  jsonLd?: object[]
  /** Keeps the page out of search indexes (404, anything unfinished). */
  noindex?: boolean
}
const {
  title,
  description,
  locale = getLangFromUrl(Astro.url),
  alternates,
  switchTo,
  ogImage,
  article,
  jsonLd,
  noindex,
} = Astro.props

const t = ui[locale]

const autoDe = getPathWithoutLocale(Astro.url.pathname)
const auto = { de: autoDe, en: `/en${autoDe === '/' ? '/' : autoDe}` }
const paths = alternates === false ? null : (alternates ?? auto)
const other: Locale = locale === defaultLang ? 'en' : defaultLang
const switchPath = switchTo ?? (paths ?? auto)[other]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title ?? t.meta.title}
      description={description ?? t.meta.description}
      locale={locale}
      paths={paths}
      selfPath={Astro.url.pathname}
      ogImage={ogImage}
      article={article}
      jsonLd={jsonLd}
      noindex={noindex}
    />
    <!-- Only the faces the first screen sets: body, display voice, wordmark.
         Archivo (35 KB) sets headings further down; preloading it made it
         compete with the hero's LCP text for the phone's first round trips. -->
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/instrument-serif-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    <!-- Page transitions: must be a classic script in <head>, see the file. -->
    <script is:inline set:html={pageTransitions} />
    <!-- Hold the first paint of an arriving page until <main> is parsed, so a
         title flying in from a card has somewhere to land. -->
    <link rel="expect" href="#main-end" blocking="render" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
      >{t.skipLink}</a
    >
    <NavBar locale={locale} switchTo={switchPath} />
    <SheetIndex />
    <main id="main">
      <slot />
      <span id="main-end" hidden></span>
    </main>
    <Footer locale={locale} />
  </body>
</html>

<script>
  import { initNav } from '../scripts/nav'
  import { initSignIn } from '../scripts/sign-in'
  initNav()
  initSignIn()
</script>
