---
/**
 * A hand-drawn underline under the slotted words, in two strokes the way a
 * pencil goes back over a line. It draws itself in once when scrolled into
 * view; without motion or script it is already drawn.
 *
 *   Werden Sie <PencilUnderline>Pilotbüro</PencilUnderline>.
 *
 * The words stay together (no wrap inside); the line is aria-hidden.
 */

interface Props {
  tone?: 'lime' | 'olive'
  class?: string
}
const { tone = 'lime', class: className = '' } = Astro.props
---

<span class:list={['craft-pencil', `craft-pencil--${tone}`, className]} data-craft-in
  ><slot /><svg viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true" focusable="false"
    ><path pathLength="1" d="M2 9.5C38 6.5 84 10 128 7.6S186 6.4 198 8.2"></path><path
      pathLength="1"
      d="M16 12.2C62 10.4 118 12.8 176 10.6"></path></svg
  ></span
>

<script>
  import './craft-in'
</script>

<style>
  .craft-pencil {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  svg {
    position: absolute;
    left: -3%;
    width: 106%;
    bottom: -0.16em;
    height: 0.3em;
    overflow: visible;
    pointer-events: none;
  }
  path {
    fill: none;
    stroke: var(--pencil);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  path + path {
    stroke-width: 2.2;
    opacity: 0.75;
  }
  .craft-pencil--lime {
    --pencil: #a4d06a;
  }
  .craft-pencil--olive {
    --pencil: #6e7d52;
  }

  @media (prefers-reduced-motion: no-preference) {
    .craft-pencil.craft-armed:not(.craft-in) path {
      stroke-dashoffset: 1;
    }
    /* `--duration-base` (320 ms) end to end: the long stroke, and the short one going back over
       it starting a beat later and finishing with it. */
    .craft-pencil.craft-in path {
      transition: stroke-dashoffset var(--duration-base) var(--ease-draft);
    }
    .craft-pencil.craft-in path + path {
      transition-duration: var(--duration-quick);
      transition-delay: var(--duration-tick);
    }
  }
</style>
