---
/**
 * A print taped to the drawing: a picture on a white paper margin, one strip
 * of tape across the top, a little off square, an optional caption in mono.
 *
 * Two uses:
 *
 *   A riso plate from `public/art/`, by base name (see plates.ts):
 *     <TapedPrint name={PLATES.I} size="half" caption="Tafel I — Drei Stützen" />
 *
 *   Anything else, passed as the slot (a photo, a blog cover):
 *     <TapedPrint size="photo"><Image src={…} alt="…" /></TapedPrint>
 *
 * Plates are screened bitmaps, so they are a plain <img> at an integer
 * fraction of their pixel size, never astro:assets: resampling a halftone
 * screen by an odd factor produces moiré. `full` shows the 720 px file at 720
 * CSS px with the 1440 px file for 2x screens; `half` and `third` show the 720
 * px file at exactly 1/2 and 1/3. The only other scaling is `max-width: 100%`
 * on a phone narrower than the print.
 *
 * A plate whose file is missing renders nothing (with a build warning), so a
 * section can name its plate before the plate exists.
 */
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import Tape from './Tape.astro'

interface Props {
  /** A plate's base name in `public/art/`. Omit when passing a slot. */
  name?: string
  /** Empty (the default) when the print sits beside text that says it all. */
  alt?: string
  caption?: string
  /** CSS width of a plate: 720, 360 or 240 px. `photo` fits the slot. */
  size?: 'full' | 'half' | 'third' | 'photo'
  /** Degrees, clamped to ±2: anything more and a caption starts to lean. */
  rotate?: number
  align?: 'start' | 'center' | 'end'
  loading?: 'lazy' | 'eager'
  class?: string
}
const {
  name,
  alt = '',
  caption,
  size = 'half',
  rotate = -1,
  align = 'start',
  loading = 'lazy',
  class: className = '',
} = Astro.props

const WIDTH = { full: 720, half: 360, third: 240, photo: undefined }[size]
const TAPE = { full: '8rem', half: '6rem', third: '4.5rem', photo: '3.25rem' }[size]
const tilt = Math.max(-2, Math.min(2, rotate))
const ALIGN = { start: '', center: 'mx-auto', end: 'ml-auto' }

const hasSlot = Astro.slots.has('default')
let plate: { src: string; srcset?: string } | undefined
if (!hasSlot && name) {
  // Pages are prerendered, so this runs at build time with the site's root
  // as the working directory.
  const onDisk = (file: string) => existsSync(join(process.cwd(), 'public', 'art', file))
  if (onDisk(`${name}.png`)) {
    const src = `/art/${name}.png`
    const hi = size === 'full' && onDisk(`${name}@2x.png`) ? `/art/${name}@2x.png` : undefined
    plate = { src, srcset: hi ? `${src} 1x, ${hi} 2x` : undefined }
  } else {
    console.warn(`[TapedPrint] public/art/${name}.png not found; the print is left out.`)
  }
}
const show = hasSlot || plate !== undefined
---

{
  show && (
    <figure
      class:list={['craft-print', `craft-print--${size}`, 'm-0', ALIGN[align], className]}
      style={`--rot: ${tilt}deg`}
    >
      <Tape class="-top-2.5 left-1/2 -translate-x-1/2" length={TAPE} rotate={-tilt * 1.5} seed={name?.length ?? 1} />
      <div class="craft-print__sheet">
        {plate ? (
          <img
            src={plate.src}
            srcset={plate.srcset}
            width={WIDTH}
            height={WIDTH}
            alt={alt}
            loading={loading}
            decoding="async"
          />
        ) : (
          <slot />
        )}
        {caption && <figcaption>{caption}</figcaption>}
      </div>
    </figure>
  )
}

<style>
  /* In Tailwind's components layer, below utilities: a caller's `class`
     (a width, a margin) then wins over these defaults, as it would not over
     unlayered scoped CSS. */
  @layer components {
    .craft-print {
      position: relative;
      width: fit-content;
      max-width: 100%;
      rotate: var(--rot);
    }
    /* The paper: white, square-cornered, lying flat on the grid with a short
       contact shadow and a longer soft one. No texture; the print is the
       texture. */
    .craft-print__sheet {
      background: #fdfdfb;
      padding: 0.75rem;
      border-radius: 2px;
      box-shadow:
        0 0 0 1px rgb(30 34 22 / 0.05),
        0 1px 2px rgb(30 34 22 / 0.1),
        0 14px 28px -16px rgb(30 34 22 / 0.3);
    }
    .craft-print--third .craft-print__sheet,
    .craft-print--photo .craft-print__sheet {
      padding: 0.375rem;
    }
    img,
    .craft-print__sheet > :global(img) {
      display: block;
      max-width: 100%;
      height: auto;
    }
    figcaption {
      margin-top: 0.625rem;
      font-family: var(--font-mono, 'IBM Plex Mono', monospace);
      font-size: 0.6875rem;
      line-height: 1.3;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #625f57;
    }
  }
</style>
