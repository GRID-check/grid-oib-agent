---
/**
 * The blog listing, shared by /blog/, /blog/<category>/ and their /en twins.
 *
 * "All" sets the two strands side by side, each in its own dress: the Journal
 * as editorial cards, the build log as a diary sheet. A category page shows one
 * strand at full width. The filter row is plain links to prerendered pages, so
 * every view has a URL, a canonical and hreflang alternates without any script.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionTag from '../atoms/SectionTag.astro'
import BlogCard from '../molecules/BlogCard.astro'
import BuildLog from './BuildLog.astro'
import { ui, type Locale } from '../../i18n/ui'
import { CATEGORIES, CATEGORY_IDS, blogPath, type Category } from '../../lib/categories'
import { entryNumbers, getBlogPosts } from '../../lib/posts'

interface Props {
  locale: Locale
  category?: Category
}
const { locale, category } = Astro.props
const t = ui[locale].blog
const cats = CATEGORIES[locale]

const all = await getBlogPosts(locale)
const numbers = entryNumbers(all)
const byCategory = (c: Category) => all.filter((p) => p.data.category === c)
const journal = byCategory('journal')
const log = byCategory('bautagebuch')

const filters = [
  { href: blogPath(locale), label: t.filterAll, count: all.length, active: !category },
  ...CATEGORY_IDS.map((id) => ({
    href: blogPath(locale, id),
    label: cats[id].label,
    count: byCategory(id).length,
    active: category === id,
  })),
]

const { title, description } = ui[locale].seo.pages[category ?? 'blog']
---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="px-4 pb-20 pt-28 sm:px-6 md:px-10 md:pb-28 md:pt-36">
    <div class="mx-auto max-w-6xl">
      <SectionTag>
        {
          category ? (
            <>
              <a href={blogPath(locale)} class="hover:text-accent-500">{t.tag}</a>
              <span aria-hidden="true">/</span>
              <span>{cats[category].label}</span>
            </>
          ) : (
            t.tag
          )
        }
      </SectionTag>
      <h1 class="mt-6 max-w-3xl font-voice text-v3 text-ink">
        {category ? cats[category].label : t.heading}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
        {category ? cats[category].descriptor : t.intro}
      </p>

      <nav aria-label={t.filterLabel} class="mt-10 border-b border-ink/10 pb-6">
        <ul class="flex flex-wrap gap-2">
          {
            filters.map((f) => (
              <li>
                <a
                  href={f.href}
                  aria-current={f.active ? 'page' : undefined}
                  class:list={[
                    'inline-flex min-h-11 items-center gap-2 rounded-full px-4 text-sm font-medium transition-colors',
                    f.active
                      ? 'bg-panel text-on-dark-strong'
                      : 'bg-white/70 text-ink ring-1 ring-ink/12 hover:bg-white hover:ring-ink/25',
                  ]}
                >
                  {f.label}
                  <span
                    class:list={[
                      'font-mono text-2xs tabular-nums',
                      f.active ? 'text-on-dark-label' : 'text-ink-faint',
                    ]}
                  >
                    {f.count}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        all.length === 0 ? (
          <p class="mt-12 rounded-card bg-white p-10 text-center text-base text-ink-soft">{t.empty}</p>
        ) : category === 'journal' ? (
          journal.length === 0 ? (
            <p class="mt-12 rounded-card bg-white p-10 text-center text-base text-ink-soft">{t.empty}</p>
          ) : (
            <div class="mt-10 grid gap-6 md:grid-cols-2">
              {journal.map((post) => (
                <BlogCard post={post} locale={locale} level={2} />
              ))}
            </div>
          )
        ) : category === 'bautagebuch' ? (
          <div class="mt-10 max-w-4xl">
            <BuildLog posts={log} numbers={numbers} locale={locale} titleAs="div" entryLevel={2} />
          </div>
        ) : (
          <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-10">
            <section class="lg:col-span-7" aria-labelledby="blog-journal">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h2 id="blog-journal" class="font-voice text-[2rem] leading-none text-ink">
                  {cats.journal.label}
                </h2>
                <a
                  href={blogPath(locale, 'journal')}
                  class="inline-flex min-h-11 items-center font-mono text-2xs uppercase tracking-label text-accent-600 hover:text-accent-500"
                >
                  {cats.journal.viewAll}
                </a>
              </div>
              <p class="mt-1 max-w-xl text-base leading-snug text-ink-soft">{cats.journal.descriptor}</p>
              {journal.length === 0 ? (
                <p class="mt-6 rounded-card bg-white p-8 text-base text-ink-soft">{t.empty}</p>
              ) : (
                <div class="mt-6 grid gap-6">
                  {journal.map((post) => (
                    <BlogCard post={post} locale={locale} />
                  ))}
                </div>
              )}
            </section>
            <div class="lg:col-span-5">
              <BuildLog posts={log} numbers={numbers} locale={locale} viewAll />
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { initReveals } from '../../scripts/reveal'
  initReveals()
</script>
