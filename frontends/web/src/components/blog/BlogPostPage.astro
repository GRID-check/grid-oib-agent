---
/**
 * A blog post page, shared by /blog/<slug>/ and /en/blog/<slug>/. The category
 * chip next to the date links to the post's listing, and the foot of the page
 * offers the rest of that category in the same dress the listing uses.
 */
import { render } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionTag from '../atoms/SectionTag.astro'
import BlogCard from '../molecules/BlogCard.astro'
import BuildLog from './BuildLog.astro'
import CategoryChip from './CategoryChip.astro'
import TapedPrint from '../craft/TapedPrint.astro'
import { POST_PLATES } from '../craft/plates'
import { ui, type Locale } from '../../i18n/ui'
import { CATEGORIES, blogPath } from '../../lib/categories'
import { entryNumbers, formatDate, getBlogPosts, postSlug, type BlogPost } from '../../lib/posts'
import { absoluteUrl, defaultOgImage, founderNames, postLd } from '../../lib/seo'

interface Props {
  post: BlogPost
  locale: Locale
}
const { post, locale } = Astro.props
const { Content } = await render(post)
const { title, description, pubDate, cover, category, translationSlug } = post.data
const t = ui[locale].blog
const cat = CATEGORIES[locale][category]
const slug = postSlug(post.id)

const other: Locale = locale === 'de' ? 'en' : 'de'
const here = `${blogPath(locale)}${slug}/`
const there = translationSlug ? `${blogPath(other)}${translationSlug}/` : undefined
const alternates = there ? ({ [locale]: here, [other]: there } as { de: string; en: string }) : false
const switchTo = there ?? blogPath(other)

const inCategory = await getBlogPosts(locale, category)
const numbers = entryNumbers(inCategory)
const more = inCategory.filter((p) => p.id !== post.id).slice(0, 3)
const number = numbers.get(post.id)
// A post can wear a riso plate as its cover (see craft/plates.ts).
const plate = POST_PLATES[slug]

// Head: the cover as share image when there is one, the post as BlogPosting.
const shareCover = cover && (await getImage({ src: cover, width: 1200, height: 630, format: 'jpg' }))
const ogImage = shareCover
  ? { src: shareCover.src, alt: title, width: 1200, height: 630 }
  : defaultOgImage(locale)
const jsonLd = postLd({
  locale,
  url: absoluteUrl(here, Astro.site),
  title,
  description,
  published: pubDate,
  image: absoluteUrl(ogImage.src, Astro.site),
  section: cat.label,
  sectionUrl: absoluteUrl(blogPath(locale, category), Astro.site),
  blogUrl: absoluteUrl(blogPath(locale), Astro.site),
  site: Astro.site,
})
---

<BaseLayout
  locale={locale}
  title={`${title}${ui[locale].seo.postTitleSuffix}`}
  description={description}
  alternates={alternates}
  switchTo={switchTo}
  ogImage={ogImage}
  article={{ published: pubDate, section: cat.label }}
  jsonLd={jsonLd}
>
  <article class="overflow-x-clip px-4 pb-16 pt-28 sm:px-6 md:px-10 md:pb-20 md:pt-36">
    <div class="mx-auto max-w-3xl">
      <a
        href={blogPath(locale)}
        class="inline-flex min-h-11 items-center text-sm font-medium text-accent-600 hover:text-accent-700"
      >
        {t.allPosts}
      </a>
      <div class="mt-5">
        {
          /* A build-log post carries its entry number the way a section
             carries its sheet number. */
          category === 'bautagebuch' && number ? (
            <SectionTag no={String(number).padStart(2, '0')}>{t.entry}</SectionTag>
          ) : (
            <SectionTag>{t.tag}</SectionTag>
          )
        }
      </div>
      <h1 class="mt-5 break-words font-voice text-v2 text-ink">{title}</h1>
      <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
        <CategoryChip category={category} locale={locale} href={blogPath(locale, category)} />
        <time
          datetime={pubDate.toISOString()}
          class="font-mono text-2xs uppercase tracking-label text-ink-mute"
        >
          {formatDate(pubDate, locale)}
        </time>
        <span class="font-mono text-2xs uppercase tracking-label text-ink-mute">
          {ui[locale].seo.byline} {founderNames(locale)}
        </span>
      </p>
      {
        /* The cover is a print taped onto the page. */
        cover ? (
          <TapedPrint size="photo" rotate={-0.6} class="mt-10 w-full">
            <Image
              src={cover}
              alt=""
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 768px) 744px, 100vw"
              class="aspect-[16/9] w-full object-cover"
              loading="lazy"
            />
          </TapedPrint>
        ) : (
          plate && <TapedPrint name={plate} size="half" rotate={-1} loading="eager" class="mt-10" />
        )
      }
      <div class="prose-piloti mt-10 min-w-0">
        <Content />
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <aside
        class="border-t border-ink/10 px-4 pb-20 pt-14 sm:px-6 md:px-10 md:pb-28"
        aria-labelledby="blog-more"
      >
        <div class="mx-auto max-w-5xl">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 id="blog-more" class="font-voice text-[2rem] leading-tight text-ink">
              {cat.more}
            </h2>
            {category === 'journal' && (
              <a
                href={blogPath(locale, category)}
                class="inline-flex min-h-11 items-center font-mono text-2xs uppercase tracking-label text-accent-600 hover:text-accent-700"
              >
                {cat.viewAll}
              </a>
            )}
          </div>
          {category === 'journal' ? (
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              {more.map((p) => (
                <BlogCard post={p} locale={locale} />
              ))}
            </div>
          ) : (
            <div class="mt-6 max-w-4xl">
              <BuildLog
                posts={more}
                numbers={numbers}
                locale={locale}
                titleAs="div"
                total={inCategory.length}
                viewAll
              />
            </div>
          )}
        </div>
      </aside>
    )
  }
</BaseLayout>
