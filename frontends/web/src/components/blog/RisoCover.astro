---
/**
 * A post's riso cover (the `cover` format, 720 × 405 CSS px) at a native size:
 *
 *   header  the post page. From md up the 720 print is taped onto the page,
 *           as TapedPrint tapes a plate; on a phone it is the 360 print, bare,
 *           centred and allowed a pixel of the gutter on each side.
 *   card    a Journal card: the 360 print on a strip of its own paper colour,
 *           so the sheet edge disappears into the strip.
 *   thumb   a build-log entry: the 240 print (a third), bare.
 *
 * Never any other width: a halftone screen resampled by an odd factor turns
 * into moiré (src/lib/art.ts). Where a slot is narrower than the print (a
 * card on a 360 px phone), the strip clips the print's paper margin instead
 * of scaling it.
 */
import Tape from '../craft/Tape.astro'
import { art, artFile, artSrcset } from '../../lib/art'
import type { CoverPlate } from '../craft/plates'
import { COVER_PLATES } from '../craft/plates'
import type { Locale } from '../../i18n/ui'

interface Props {
  plate: CoverPlate
  variant: 'header' | 'card' | 'thumb'
  /** Gives the print its declared alt text; without it the print is decorative. */
  locale?: Locale
  loading?: 'lazy' | 'eager'
  class?: string
}
const { plate, variant, locale, loading = 'lazy', class: className = '' } = Astro.props
const a = art(COVER_PLATES[plate].cover)
const alt = locale ? a.alt[locale] : ''
const SIZES = {
  header: `(min-width: 768px) ${a.width}px, ${a.width / 2}px`,
  card: `${a.width / 2}px`,
  thumb: `${a.width / 3}px`,
}
---

<figure class:list={['riso-cover', `riso-cover--${variant}`, className]}>
  {
    variant === 'header' && (
      <span class="riso-cover__tape">
        <Tape class="-top-2.5 left-1/2 -translate-x-1/2" length="8rem" rotate={0.9} seed={plate.length} />
      </span>
    )
  }
  <div class="riso-cover__sheet">
    <img
      src={artFile(a).src}
      srcset={artSrcset(a)}
      sizes={SIZES[variant]}
      width={a.width}
      height={a.height}
      alt={alt}
      loading={loading}
      decoding="async"
    />
  </div>
</figure>

<style>
  /* No margin here: preflight zeroes a figure's, and a scoped rule would beat the caller's mt-*. */
  .riso-cover {
    position: relative;
  }
  .riso-cover img {
    display: block;
    max-width: none;
    height: auto;
  }

  /* header: 360 bare on a phone, 720 taped from md up */
  .riso-cover--header {
    display: flex;
    justify-content: center;
    /* the 360 print may be up to 2 px wider than a 358 px column: let it use the gutter */
    margin-inline: -1rem;
  }
  .riso-cover--header img {
    width: 360px;
  }
  .riso-cover--header .riso-cover__tape {
    display: none;
  }
  @media (min-width: 768px) {
    .riso-cover--header {
      display: block;
      width: fit-content;
      margin-inline: 0;
      rotate: -0.6deg;
    }
    .riso-cover--header img {
      width: 720px;
    }
    .riso-cover--header .riso-cover__tape {
      display: contents;
    }
    .riso-cover--header .riso-cover__sheet {
      background: #fdfdfb;
      padding: 0.75rem;
      border-radius: 2px;
      box-shadow:
        0 0 0 1px rgb(30 34 22 / 0.05),
        0 1px 2px rgb(30 34 22 / 0.1),
        0 14px 28px -16px rgb(30 34 22 / 0.3);
    }
  }

  /* card: the print mounted on a strip, with a hairline and a short contact
     shadow, so its paper edge reads as a sheet and not as a seam. Where the
     strip is too narrow for the print and a margin (a card on a phone), the
     print fills it edge to edge and the strip clips its paper margin. */
  .riso-cover--card {
    container-type: inline-size;
  }
  .riso-cover--card .riso-cover__sheet {
    display: flex;
    justify-content: center;
    overflow: hidden;
    padding-block: 1.5rem;
    background: var(--color-surface-dim);
  }
  .riso-cover--card img {
    width: 360px;
    flex: none;
    box-shadow:
      0 0 0 1px rgb(30 34 22 / 0.06),
      0 1px 2px rgb(30 34 22 / 0.08),
      0 10px 20px -14px rgb(30 34 22 / 0.35);
  }
  @container (max-width: 25rem) {
    .riso-cover--card .riso-cover__sheet {
      padding-block: 0;
      background: #f4f2e8;
    }
    .riso-cover--card img {
      box-shadow: none;
    }
  }

  .riso-cover--thumb img {
    width: 240px;
  }
</style>
