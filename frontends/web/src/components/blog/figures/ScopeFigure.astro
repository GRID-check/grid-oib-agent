---
/**
 * The knowledge hierarchy as nested frames: platform, office, project,
 * conversation. Each level nests inside the one above, a question searches
 * outward from where it is asked, and a level is invisible outside its owner.
 */
import FigureFrame from './FigureFrame.astro'

interface Level {
  label: string
  /** What lives at this level, e.g. "OIB LAW + LESSONS". */
  holds: string
  /** Who can see it, e.g. "EVERYONE". */
  visible: string
}
interface Props {
  /** Outermost first. Four levels fit; more will crowd. */
  levels: Level[]
  /** Label on the outward search arrow, e.g. "A QUESTION SEARCHES OUTWARD". */
  search: string
  kicker?: string
  title?: string
  caption?: string
  alt: string
}
const { levels, search, kicker, title, caption, alt } = Astro.props

const W = 960
const H = 560
const INSET_X = 96
const INSET_Y = 56
const MARGIN = { x: 60, top: 46, bottom: 60 }

const frames = levels.map((level, i) => ({
  ...level,
  x: MARGIN.x + i * INSET_X,
  y: MARGIN.top + i * INSET_Y,
  w: W - 2 * MARGIN.x - 2 * i * INSET_X,
  h: H - MARGIN.top - MARGIN.bottom - 2 * i * INSET_Y,
}))
const inner = frames[frames.length - 1]
const arrowY = inner.y + inner.h / 2
---

<FigureFrame kicker={kicker} title={title} caption={caption} alt={alt}>
  <svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker
        id="scope-arrow"
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L8 4 L0 8 z" fill="var(--color-accent-600)"></path>
      </marker>
    </defs>

    {
      frames.map((f, i) => (
        <g>
          <rect
            class={`fp-stroke ${i === frames.length - 1 ? 'fp-fill--tint' : i === 0 ? 'fp-fill' : 'fp-fill--soft'}`}
            x={f.x}
            y={f.y}
            width={f.w}
            height={f.h}
            rx="6"
          />
          <text class="fp-label" x={f.x + 18} y={f.y + 24}>
            {f.label}
          </text>
          <text class="fp-label--muted" x={f.x + 18} y={f.y + 42}>
            {f.holds}
          </text>
          <text class="fp-label--accent" x={f.x + f.w - 18} y={f.y + 24} text-anchor="end">
            {f.visible}
          </text>
        </g>
      ))
    }

    {/* The question searches outward: dot in the innermost frame, arrow crossing every boundary. */}
    <circle class="fp-stroke fp-fill" cx={inner.x + 42} cy={arrowY} r="7"></circle>
    <line
      class="fp-stroke fp-dash"
      marker-end="url(#scope-arrow)"
      x1={inner.x + 52}
      y1={arrowY}
      x2={frames[0].x + frames[0].w - 28}
      y2={arrowY}
      style="stroke: var(--color-accent-600)"></line>
    <text
      class="fp-label--accent"
      x={inner.x + 58}
      y={arrowY + 22}>{search}</text>
  </svg>
</FigureFrame>
