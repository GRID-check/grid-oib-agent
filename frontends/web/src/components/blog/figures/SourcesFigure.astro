---
/**
 * Four kinds of sources feeding one index, and the answer that shows where
 * each source came from. Labels arrive from the post, so both locales share
 * one drawing.
 */
import FigureFrame from './FigureFrame.astro'

interface Props {
  labels: {
    sources: { label: string; sub?: string }[]
    sourcesFooter: string
    index: string
    indexRows: string[]
    consumersTag: string
    consumer: string
    consumerSub: string
  }
  kicker?: string
  title?: string
  caption?: string
  alt: string
}
const { labels, kicker, title, caption, alt } = Astro.props

const SRC_X = 70
const SRC_W = 210
const SRC_H = 56
const SRC_GAP = 80
const SRC_TOP = 66
const srcYs = labels.sources.map((_, i) => SRC_TOP + i * SRC_GAP)
const bracketX = SRC_X + SRC_W + 26
const midY = SRC_TOP + ((labels.sources.length - 1) * SRC_GAP + SRC_H) / 2
const IDX_X = 390
const IDX_W = 250
const IDX_TOP = midY - 20 - (labels.indexRows.length * 30 + 40) / 2
const IDX_H = labels.indexRows.length * 30 + 44
const ANS_X = 720
const ANS_W = 190
---

<FigureFrame kicker={kicker} title={title} caption={caption} alt={alt}>
  <svg viewBox="0 0 960 460" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker
        id="src-arrow"
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L8 4 L0 8 z" fill="var(--color-accent-700)"></path>
      </marker>
    </defs>

    {
      labels.sources.map((s, i) => (
        <g>
          <rect class="fp-stroke fp-fill" x={SRC_X} y={srcYs[i]} width={SRC_W} height={SRC_H} />
          <text class="fp-label" x={SRC_X + 16} y={srcYs[i] + (s.sub ? 24 : 33)}>
            {s.label}
          </text>
          {s.sub && (
            <text class="fp-label--muted" x={SRC_X + 16} y={srcYs[i] + 42}>
              {s.sub}
            </text>
          )}
          <line
            class="fp-stroke--muted"
            x1={SRC_X + SRC_W}
            y1={srcYs[i] + SRC_H / 2}
            x2={bracketX}
            y2={srcYs[i] + SRC_H / 2}
          />
        </g>
      ))
    }
    <line
      class="fp-stroke--muted"
      x1={bracketX}
      y1={srcYs[0] + SRC_H / 2}
      x2={bracketX}
      y2={srcYs[srcYs.length - 1] + SRC_H / 2}></line>
    <text class="fp-label--muted" x={SRC_X} y={srcYs[srcYs.length - 1] + SRC_H + 34}>
      {labels.sourcesFooter}
    </text>

    <line
      class="fp-stroke"
      marker-end="url(#src-arrow)"
      x1={bracketX}
      y1={midY}
      x2={IDX_X - 12}
      y2={midY}></line>

    <rect class="fp-stroke fp-fill" x={IDX_X} y={IDX_TOP} width={IDX_W} height={IDX_H}></rect>
    <rect class="fp-stroke fp-fill--tint" x={IDX_X} y={IDX_TOP} width={IDX_W} height="34"></rect>
    <text class="fp-label" x={IDX_X + 16} y={IDX_TOP + 22}>{labels.index}</text>
    {
      labels.indexRows.map((row, i) => (
        <text class="fp-label--muted" x={IDX_X + 16} y={IDX_TOP + 58 + i * 30}>
          {row}
        </text>
      ))
    }

    <line
      class="fp-stroke"
      marker-end="url(#src-arrow)"
      x1={IDX_X + IDX_W}
      y1={midY}
      x2={ANS_X - 12}
      y2={midY}></line>

    <text class="fp-label--muted" x={ANS_X} y={midY - 52}>{labels.consumersTag}</text>
    <rect class="fp-stroke fp-fill--soft" x={ANS_X} y={midY - 34} width={ANS_W} height="68"></rect>
    <text class="fp-label" x={ANS_X + 16} y={midY - 6}>{labels.consumer}</text>
    <text class="fp-label--muted" x={ANS_X + 16} y={midY + 14}>{labels.consumerSub}</text>
  </svg>
</FigureFrame>
