---
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
const a = t.app

/**
 * The product, at rest, answering a real question.
 *
 * This replaces a diagram that panned around an abstract "decision chain". The
 * diagram explained the idea; it did not show the thing, and a visitor deciding
 * whether to book a demo is trying to see the thing. So the anatomy here is the
 * app's own: a lede that answers in its first sentence, prose whose [n] markers
 * anchor to one chip per document, a provenance class on every chip, and the
 * confidence the answer carries — rendered with the product's own signal
 * colours (see the tokens in global.css).
 *
 * It is also driven rather than watched. A loop plays at the visitor; three
 * questions they can pick between let them ask, which is the actual product
 * experience and the only honest way to demonstrate it in a panel.
 */

// Provenance classes, exactly as the product tints them.
const src: Record<string, { chip: string; dot: string }> = {
  law: { chip: 'bg-chip-law text-chip-law-ink', dot: 'bg-src-law' },
  project: { chip: 'bg-chip-project text-chip-project-ink', dot: 'bg-src-project' },
  office: { chip: 'bg-chip-office text-chip-office-ink', dot: 'bg-src-office' },
}

/** Split an answer body on its citation markers so each becomes a control. */
const segments = (body: string) => body.split(/(\[\d+\])/g).filter(Boolean)
const markOf = (part: string) => part.match(/^\[(\d+)\]$/)?.[1]
---

<div
  data-app-mock
  data-reveal
  class="overflow-hidden rounded-[1.75rem] bg-app-bg shadow-mock ring-1 ring-ink/10"
>
  <div class="grid grid-cols-[3.25rem_1fr] max-sm:grid-cols-1">
    <!-- The rail, reduced to what it contributes at this size: the project it is
         standing in. Enough for the panel to read as an application. -->
    <div
      class="flex flex-col items-center gap-4 border-r border-app-border bg-app-sunken py-4 max-sm:hidden"
      aria-hidden="true"
    >
      <span
        class="flex size-7 items-center justify-center rounded-lg bg-panel font-display text-2xs font-semibold text-surface"
        >P</span
      >
      <span class="h-px w-5 bg-ink/10"></span>
      {
        [
          'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
          'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z',
          'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z',
          'M12 2 3 7v10l9 5 9-5V7zM3 7l9 5 9-5M12 12v10',
        ].map((d, i) => (
          <svg
            viewBox="0 0 24 24"
            class:list={['size-4', i === 0 ? 'text-ink/55' : 'text-ink/20']}
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={d} />
          </svg>
        ))
      }
    </div>

    <div class="flex min-w-0 flex-col">
      <div
        class="flex items-center justify-between gap-4 border-b border-app-border bg-app-bg px-5 py-3"
      >
        <div class="min-w-0">
          <p class="m-0 truncate text-sm font-semibold tracking-tight text-ink">{a.project}</p>
          <p class="m-0 truncate text-2xs text-ink-faint">{a.projectMeta}</p>
        </div>
        <span class="shrink-0 font-mono text-2xs uppercase tracking-widest text-ink-ghost">
          {a.fictional}
        </span>
      </div>

      <div class="relative min-h-[19.5rem] px-5 py-5 sm:min-h-[21.5rem]">
        {
          a.turns.map((turn, ti) => (
            <div
              data-turn-panel={ti}
              hidden={ti !== 0}
              class="flex flex-col gap-4 [&[hidden]]:hidden"
            >
              <div class="flex flex-col items-end">
                <span class="mr-3.5 inline-flex items-center gap-1.5 rounded-t-md bg-app-accent px-2.5 py-1 font-mono text-2xs uppercase tracking-widest text-ink-mute">
                  {a.you}
                </span>
                <p class="m-0 max-w-[26rem] rounded-lg rounded-tr-[4px] border border-app-border bg-white px-3.5 py-2.5 text-sm leading-[1.55] text-ink shadow-card">
                  {turn.q}
                </p>
              </div>

              <div class="flex flex-col gap-3">
                <p class="m-0 text-base font-medium leading-snug text-ink" style="text-wrap: pretty">
                  {turn.lede}
                </p>
                <p class="m-0 text-sm leading-relaxed text-ink-soft" style="text-wrap: pretty">
                  {segments(turn.body).map((part) => {
                    const n = markOf(part)
                    return n ? (
                      <button
                        type="button"
                        data-mark={`${ti}-${n}`}
                        class="mx-[1px] inline-flex h-4 min-w-4 -translate-y-px cursor-pointer items-center justify-center rounded-[4px] border border-app-border bg-app-muted px-[3px] font-mono text-[10px] leading-none tabular-nums text-ink-mute transition-[color,background-color,border-color] duration-200 hover:border-ink/25 hover:bg-app-accent hover:text-ink data-[lit]:border-ink/25 data-[lit]:bg-app-accent data-[lit]:text-ink"
                      >
                        {n}
                      </button>
                    ) : (
                      part
                    )
                  })}
                </p>

                <div class="mt-1">
                  <p class="m-0 mb-2 font-mono text-2xs uppercase tracking-widest text-ink-faint">
                    {a.sourcesLabel}
                  </p>
                  <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
                    {turn.sources.map((s) => (
                      <li>
                        <span
                          data-source={`${ti}-${s.marks}`}
                          class:list={[
                            'inline-flex h-7 max-w-full items-center gap-1.5 rounded-md border border-transparent px-2.5 text-xs font-medium transition-[box-shadow,transform,border-color] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]',
                            'data-[lit]:-translate-y-px data-[lit]:border-current/30 data-[lit]:shadow-card',
                            src[s.kind].chip,
                          ]}
                        >
                          <span class="font-mono text-2xs tabular-nums opacity-60">
                            {s.marks}
                          </span>
                          <span class="truncate">{s.title}</span>
                          {'tier' in s && s.tier && (
                            <span
                              class="shrink-0 rounded-[3px] px-1 text-[9px] font-bold uppercase leading-[1.5] tracking-wide"
                              style="background-color: color-mix(in oklch, currentColor 16%, transparent)"
                            >
                              {s.tier}
                            </span>
                          )}
                          <span class="truncate text-2xs font-normal opacity-70 max-sm:hidden">
                            {s.meta}
                          </span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>

                <p class="m-0 flex items-center gap-1.5 text-2xs text-ink-faint">
                  <span class="size-1.5 rounded-full bg-src-project" aria-hidden="true" />
                  {a.confidence}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- The composer, with the three questions sitting where a follow-up
           suggestion sits in the product. Picking one is asking it. -->
      <div class="border-t border-app-border bg-app-bg px-5 pb-4 pt-3.5">
        <p class="m-0 mb-2 font-mono text-2xs uppercase tracking-widest text-ink-ghost">
          {a.askLabel}
        </p>
        <div class="flex flex-wrap gap-1.5">
          {
            a.turns.map((turn, ti) => (
              <button
                type="button"
                data-turn-pick={ti}
                data-active={ti === 0 ? '' : undefined}
                class="cursor-pointer rounded-full border border-app-border bg-white px-3 py-1.5 text-2xs text-ink-soft transition-[color,background-color,border-color] duration-200 hover:border-ink/25 hover:text-ink data-[active]:border-transparent data-[active]:bg-panel data-[active]:text-surface"
              >
                {turn.short}
              </button>
            ))
          }
        </div>
        <div
          class="mt-3 flex items-center gap-2 rounded-xl border border-app-border bg-app-input px-3.5 py-2.5"
          aria-hidden="true"
        >
          <span class="flex-1 truncate text-sm text-ink-ghost">{a.placeholder}</span>
          <span class="flex size-6 items-center justify-center rounded-lg bg-panel text-surface">
            <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 19V5M5 12l7-7 7 7" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
