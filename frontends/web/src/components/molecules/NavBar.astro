---
import Logo from '../atoms/Logo.astro'
import Pill from '../atoms/Pill.astro'
import { SIGN_IN_URL } from '../../consts'
import { ui, type Locale } from '../../i18n/ui'
import { useTranslatedPath } from '../../i18n/utils'

interface Props {
  locale?: Locale
  switchTo?: string
}
const { locale = 'de', switchTo } = Astro.props
const t = ui[locale]
const translatePath = useTranslatedPath(locale)
const home = translatePath('/')

// The page's own order. Prefixed with `home` so the anchors also work from the
// blog and the legal pages, where these sections do not exist.
//
// `wide` marks the two that only appear once the bar's left track can hold six
// labels (see the list below); the German set needs 487 px and the English 513,
// against a track of 403 px at `lg` and 531 px at `xl`.
const sections = [
  { id: 'ablauf', label: t.nav.links.ablauf },
  { id: 'nutzung', label: t.nav.links.nutzung },
  { id: 'rollen', label: t.nav.links.rollen },
  { id: 'daten', label: t.nav.links.daten },
  { id: 'abdeckung', label: t.nav.links.abdeckung, wide: true },
  { id: 'fragen', label: t.nav.links.fragen, wide: true },
]
---

<header data-nav class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4">
  <nav
    data-nav-bar
    class="mx-auto flex max-w-[84rem] items-center justify-between gap-3 rounded-card px-3 py-2 transition-colors duration-500 sm:px-4 md:grid md:grid-cols-[1fr_auto_1fr]"
    aria-label={t.nav.ariaLabel}
  >
    <!-- Section anchors sit in the bar's left margin, which is otherwise an
         empty grid track. Below `lg` the track is too narrow even for four
         labels and the list is dropped; the footer still links the same
         sections. The active one is marked by the drafting-set device used
         everywhere else on the page: a hairline tick under the label. -->
    <ul
      class="m-0 hidden list-none items-center gap-4 p-0 text-sm font-medium lg:flex xl:gap-5"
    >
      {
        sections.map((s) => (
          <li class={s.wide ? 'hidden xl:list-item' : ''}>
            <a
              href={`${home}#${s.id}`}
              data-nav-link={s.id}
              data-i18n={`nav.links.${s.id}`}
              class="relative whitespace-nowrap py-1 text-ink transition-colors hover:text-accent-600 aria-[current]:text-accent-600 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-accent-600/60 after:transition-transform after:duration-300 aria-[current]:after:scale-x-100"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <Logo href={`${home}#top`} label={t.nav.logoLabel} class="shrink-0" />
    <div
      class="flex shrink-0 items-center justify-end gap-2.5 text-sm font-medium sm:gap-3.5"
    >
      <a
        href={SIGN_IN_URL}
        data-sign-in
        data-sign-in-pending={t.nav.signInPending}
        class="inline-flex items-center gap-1.5 whitespace-nowrap text-ink hover:text-accent-600"
      >
        <svg
          data-sign-in-spinner
          class="hidden size-3.5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          style="animation: chain-spin 0.9s linear infinite"
          aria-hidden="true"
        >
          <path d="M12 3a9 9 0 1 0 9 9" />
        </svg>
        {/* Below sm the label has no room (the row already runs to the edge at
        320px), so the icon carries it there and the label stays for screen
        readers. Without one of the two, phones have no sign-in affordance. */}
        <svg
          data-sign-in-icon
          class="size-4 shrink-0 sm:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
          <path d="m10 17 5-5-5-5" />
          <path d="M15 12H3" />
        </svg>
        <span data-sign-in-label class="sr-only sm:not-sr-only" aria-live="polite"
          >{t.nav.signIn}</span
        >
      </a>
      <Pill href={`${home}#kontakt`} variant="outline" size="sm" data-i18n="nav.cta">
        {t.nav.cta}
      </Pill>
      {
        switchTo && (
          <span
            data-lang-switch
            class="flex items-center whitespace-nowrap font-mono text-2xs uppercase tracking-widest text-ink-ghost"
            aria-label={t.nav.langLabel}
          >
            {locale === 'de' ? (
              <span class="inline-flex size-6 items-center justify-center text-ink" aria-current="true">DE</span>
            ) : (
              <a
                href={switchTo}
                class="inline-flex size-6 items-center justify-center hover:text-accent-600"
                hreflang="de">DE</a>
            )}
            <span aria-hidden="true">/</span>
            {locale === 'en' ? (
              <span class="inline-flex size-6 items-center justify-center text-ink" aria-current="true">EN</span>
            ) : (
              <a
                href={switchTo}
                class="inline-flex size-6 items-center justify-center hover:text-accent-600"
                hreflang="en">EN</a>
            )}
          </span>
        )
      }
    </div>
  </nav>
</header>