---
import Logo from '../atoms/Logo.astro'
import Pill from '../atoms/Pill.astro'
import { APP_URL, CONTACT_EMAIL } from '../../consts'
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 px-[18px] pt-4 transition-transform duration-500"
>
  <nav
    data-nav-bar
    class="mx-auto grid max-w-[1340px] grid-cols-[1fr_auto_1fr] items-center rounded-[18px] px-4 py-2 transition-colors duration-500"
    aria-label="Hauptnavigation"
  >
    <div></div>
    <Logo href="/#top" />
    <div class="flex items-center justify-end gap-[14px] text-[13px] font-medium">
      <a href={APP_URL} class="text-ink hover:text-accent-600">Anmelden</a>
      <Pill href={`mailto:${CONTACT_EMAIL}?subject=Demo-Anfrage`} variant="outline" size="sm">
        Demo anfragen
      </Pill>
    </div>
  </nav>
</header>
