---
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
const options = [
  { key: 'A', title: t.chat.optATitle, sub: t.chat.optASub, chosen: false },
  { key: 'B', title: t.chat.optBTitle, sub: t.chat.optBSub, chosen: true },
  { key: 'C', title: t.chat.optCTitle, sub: t.chat.optCSub, chosen: false },
]
const sources = [
  { chip: 'OIB-RL 2', law: true, title: t.chat.oibTitle, sub: t.chat.oibSub },
  { chip: 'BO Wien', law: true, title: t.chat.boTitle, sub: t.chat.boSub },
  { chip: t.chat.projTag, law: false, title: 'Einreichplan_EG.pdf', sub: t.chat.projSub },
]
---

<!-- ── Phone and tablet: the chain as a column ───────────────────────────────
     The desktop diagram is a camera flying over a 1160px-wide board; on a
     phone it could only ever show one card at a time, shrunk. Here the same
     chain is read top to bottom at full size: question, sources, decision,
     steps, strung on one spine. It is the finished state in the markup;
     scripts/chain.ts (initChainList) only adds the arrival.
     It is also the desktop view without motion: the board's still frame is
     the whole 1160px diagram fitted into the card, which is text at 6px. -->
<div
  data-chain-list
  class="overflow-hidden rounded-[1.5rem] bg-white shadow-mock ring-1 ring-ink/10 lg:hidden lg:motion-reduce:block"
>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-ink/8 bg-paper-dim px-5 py-3">
    <div class="flex items-center gap-2.5">
      <span class="size-1.5 rounded-full bg-ok" aria-hidden="true"></span>
      <span class="font-mono text-2xs font-medium uppercase tracking-label text-ink-mute">{t.chat.header}</span>
    </div>
    <span class="font-mono text-2xs uppercase tracking-widest text-ink-ghost">{t.chat.fictional}</span>
  </div>

  <ol class="relative m-0 flex list-none flex-col gap-7 px-4 pb-6 pt-6 sm:px-6">
    <span
      data-chain-spine
      class="absolute bottom-10 left-[calc(1rem+11px)] top-9 w-px origin-top bg-ink/15 sm:left-[calc(1.5rem+11px)]"
      aria-hidden="true"></span>

    <li data-chain-step class="relative pl-9">
      <span class="absolute left-0 top-0 grid size-[23px] place-items-center rounded-full bg-white font-mono text-2xs text-ink-mute ring-1 ring-ink/15" aria-hidden="true">1</span>
      <p class="m-0 font-mono text-2xs uppercase leading-[23px] tracking-label text-ink-faint">{t.chat.questionLabel}</p>
      <p class="m-0 mt-2 rounded-2xl rounded-tl-md bg-bubble px-4 py-3 text-[0.9375rem] leading-snug text-ink">
        {t.chat.question}
      </p>
    </li>

    <li data-chain-step class="relative pl-9">
      <span class="absolute left-0 top-0 grid size-[23px] place-items-center rounded-full bg-white font-mono text-2xs text-ink-mute ring-1 ring-ink/15" aria-hidden="true">2</span>
      <p class="m-0 font-mono text-2xs uppercase leading-[23px] tracking-label text-ink-faint">{t.chat.sourcesLabel}</p>
      <ul class="m-0 mt-2 list-none divide-y divide-hairline overflow-hidden rounded-xl border border-hairline p-0">
        {
          sources.map((s) => (
            <li class="flex items-start gap-3 bg-white px-3.5 py-3">
              <span
                class={`mt-px inline-flex h-6 shrink-0 items-center rounded-md px-2 text-2xs font-semibold ${s.law ? 'bg-chip-law text-chip-law-ink' : 'bg-chip-project text-chip-project-ink'}`}
              >
                {s.chip}
              </span>
              <span class="min-w-0">
                <span class="block break-words text-sm font-semibold leading-snug text-ink">{s.title}</span>
                <span class="mt-0.5 block text-xs leading-snug text-ink-mute">{s.sub}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </li>

    <li data-chain-step class="relative pl-9">
      <span class="absolute left-0 top-0 grid size-[23px] place-items-center rounded-full bg-ink font-mono text-2xs text-on-dark-strong" aria-hidden="true">3</span>
      <p class="m-0 font-mono text-2xs uppercase leading-[23px] tracking-label text-ink">{t.chat.decision}</p>
      <div class="mt-2 rounded-xl border border-hairline bg-white p-3 shadow-card">
        <p class="m-0 px-1 pb-2.5 text-sm leading-snug text-ink-soft">{t.chat.decisionIntro}</p>
        <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
          {
            options.map((o) => (
              <li
                class={`flex items-start gap-3 rounded-lg border-l-2 px-3 py-2.5 ${o.chosen ? 'border-ok bg-[#eef6ee]' : 'border-hairline opacity-55'}`}
              >
                <span class="text-xs font-bold leading-5 text-ok">{o.key}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold leading-5 text-ink">{o.title}</span>
                  <span class="mt-0.5 block text-xs leading-snug text-ink-mute">{o.sub}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </li>

    <li data-chain-step class="relative pl-9">
      <span class="absolute left-0 top-0 grid size-[23px] place-items-center rounded-full bg-accent-900 font-mono text-2xs text-surface" aria-hidden="true">4</span>
      <div class="flex items-center justify-between gap-3">
        <p class="m-0 font-mono text-2xs uppercase leading-[23px] tracking-label text-accent-900">{t.chat.impl}</p>
        <span class="rounded-md bg-tint px-2 py-0.5 text-2xs font-semibold text-accent-900">{t.chat.stepsBadge}</span>
      </div>
      <ol class="m-0 mt-2 flex list-none flex-col gap-2.5 rounded-xl border border-hairline bg-white p-3.5">
        {
          t.chat.steps.map((step, i) => (
            <li class="flex items-baseline gap-3">
              <span class="font-mono text-2xs text-accent-600">{`0${i + 1}`}</span>
              <span class="text-sm leading-snug text-ink">{step}</span>
            </li>
          ))
        }
      </ol>
    </li>
  </ol>

  <div class="flex items-center gap-2.5 border-t border-ink/8 bg-paper px-5 py-3">
    <span class="size-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
    <span class="font-display text-2xs uppercase tracking-widest text-ink-faint">{t.chain.beats[10]}</span>
  </div>
</div>

<!-- ── Desktop: the animated board ──────────────────────────────────────── -->
<div
  data-chat-anchor
  class="overflow-hidden rounded-[1.75rem] bg-white shadow-mock ring-1 ring-ink/10 max-lg:hidden motion-reduce:hidden"
  data-reveal
>
  <div
    class="flex items-center justify-between border-b border-ink/8 bg-paper-dim px-6 py-3.5"
  >
    <div class="flex items-center gap-2.5">
      <span class="size-1.5 rounded-full bg-ok" aria-hidden="true"></span>
      <span
        class="font-mono text-2xs font-medium uppercase tracking-label text-ink-mute"
        >{t.chat.header}</span
      >
    </div>
    <span class="font-mono text-2xs uppercase tracking-widest text-ink-ghost">{t.chat.fictional}</span>
  </div>
  <div data-stage class="relative h-[360px] overflow-hidden bg-paper sm:h-[460px]">
    <!-- The mask belongs to the frame, not to the camera inside it (which is
         transformed) and not to the status line below it (which must stay
         legible), so it lives on a layer of its own. -->
    <div class="stage-mask absolute inset-0">
    <!-- Everything inside [data-cam] lives in a fixed 1160x620 coordinate space
         that the camera keyframes in scripts/landing.ts pan and zoom across, so
         the left/top/width values below are diagram geometry, not spacing. -->
    <div data-cam class="absolute inset-0 origin-top-left will-change-transform" aria-hidden="true">
      <div
        data-node="q"
        class="absolute left-0 top-0 w-[360px] rounded-2xl bg-bubble px-4 py-3 shadow-card"
      >
        <div class="text-sm leading-normal text-ink">
          <span data-q-text>{t.chat.question}</span><span
            data-q-caret
            class="ml-0.5 hidden h-3.5 w-0.5 bg-accent-500 align-[-2px]"
            style="animation: chain-pulse 0.9s steps(1, end) infinite"></span>
        </div>
      </div>

      <div
        data-scan
        class="absolute left-1 top-[106px] flex items-center gap-2"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#6e7d52"
          stroke-width="2.4"
          stroke-linecap="round"
          style="animation: chain-spin 0.9s linear infinite"
          aria-hidden="true"
        >
          <path d="M12 3a9 9 0 1 0 9 9"></path>
        </svg>
        <span class="text-xs text-ink-faint">{t.chat.scanning}</span>
      </div>

      <!-- Empty by design: every wire in this diagram is generated from the
           measured boxes of the nodes it connects (see scripts/chain.ts), so a
           card that moves takes its wires with it. -->
      <svg data-wires class="pointer-events-none absolute inset-0 overflow-visible" aria-hidden="true"
      ></svg>

      <div data-node="s1" data-part="chip" class="absolute left-[34px] top-[166px] flex h-7 w-[90px] items-center justify-center rounded-lg bg-chip-law text-2xs font-semibold text-chip-law-ink">OIB-RL 2</div>
      <div data-node="s1" data-part="card" class="absolute left-[150px] top-[154px] w-[280px] rounded-xl border border-hairline bg-white px-3.5 py-2.5 shadow-card">
        <div class="text-xs font-semibold text-ink">{t.chat.oibTitle}</div>
        <div class="mt-0.5 text-2xs leading-snug text-ink-faint">{t.chat.oibSub}</div>
      </div>

      <div data-node="s2" data-part="chip" class="absolute left-[34px] top-[258px] flex h-7 w-[90px] items-center justify-center rounded-lg bg-chip-law text-2xs font-semibold text-chip-law-ink">BO Wien</div>
      <div data-node="s2" data-part="card" class="absolute left-[150px] top-[246px] w-[280px] rounded-xl border border-hairline bg-white px-3.5 py-2.5 shadow-card">
        <div class="text-xs font-semibold text-ink">{t.chat.boTitle}</div>
        <div class="mt-0.5 text-2xs leading-snug text-ink-faint">{t.chat.boSub}</div>
      </div>

      <div data-node="s3" data-part="chip" class="absolute left-[34px] top-[354px] flex h-7 w-[90px] items-center justify-center rounded-lg bg-chip-project text-2xs font-semibold text-chip-project-ink">{t.chat.projTag}</div>
      <div data-node="s3" data-part="card" class="absolute left-[150px] top-[342px] w-[280px] rounded-xl border border-hairline bg-white px-3.5 py-2.5 shadow-card">
        <div class="text-xs font-semibold text-ink">Einreichplan_EG.pdf</div>
        <div class="mt-0.5 text-2xs leading-snug text-ink-faint">{t.chat.projSub}</div>
      </div>

      <div
        data-node="dec"
        class="absolute left-[780px] top-[172px] w-[300px] overflow-hidden rounded-2xl border border-hairline bg-white shadow-lift"
      >
        <div class="bg-ink px-4 py-3">
          <span class="font-display text-2xs font-bold uppercase tracking-wider text-on-dark-strong">{t.chat.decision}</span>
        </div>
        <div data-port="in" class="px-4 pb-0.5 pt-3 text-xs leading-normal text-ink-soft">{t.chat.decisionIntro}</div>
        <div class="flex flex-col gap-2 px-3.5 pb-3.5 pt-3">
          <div data-opt="a" class="opt flex items-start gap-3 rounded-lg border-l-2 border-hairline bg-white px-3.5 py-2.5">
            <span class="text-xs font-bold text-ok">A</span>
            <div>
              <div class="text-sm font-semibold text-ink">{t.chat.optATitle}</div>
              <div class="mt-0.5 text-2xs leading-snug text-ink-faint">{t.chat.optASub}</div>
            </div>
          </div>
          <div data-opt="b" data-port="out" class="opt flex items-start gap-3 rounded-lg border-l-2 border-hairline bg-white px-3.5 py-2.5">
            <span class="text-xs font-bold text-ok">B</span>
            <div>
              <div class="text-sm font-semibold text-ink">{t.chat.optBTitle}</div>
              <div class="mt-0.5 text-2xs leading-snug text-ink-faint">{t.chat.optBSub}</div>
            </div>
          </div>
          <div data-opt="c" class="opt flex items-start gap-3 rounded-lg border-l-2 border-hairline bg-white px-3.5 py-2.5">
            <span class="text-xs font-bold text-ok">C</span>
            <div>
              <div class="text-sm font-semibold text-ink">{t.chat.optCTitle}</div>
              <div class="mt-0.5 text-2xs leading-snug text-ink-faint">{t.chat.optCSub}</div>
            </div>
          </div>
        </div>
      </div>

      <div
        data-node="impl"
        class="absolute left-[840px] top-[520px] w-[320px] overflow-hidden rounded-2xl border border-hairline bg-white shadow-lift"
      >
        <div class="flex items-center justify-between bg-accent-900 px-4 py-3">
          <span class="font-display text-2xs font-bold uppercase tracking-wider text-surface">{t.chat.impl}</span>
          <span class="rounded-lg bg-tint px-2.5 py-0.5 text-2xs font-semibold text-accent-900">{t.chat.stepsBadge}</span>
        </div>
        <div class="flex flex-col gap-2 px-4 pb-4 pt-3">
          <div class="flex items-baseline gap-2.5"><span class="font-display text-2xs text-accent-600">01</span><span class="text-xs leading-snug text-ink">{t.chat.steps[0]}</span></div>
          <div class="flex items-baseline gap-2.5"><span class="font-display text-2xs text-accent-600">02</span><span class="text-xs leading-snug text-ink">{t.chat.steps[1]}</span></div>
          <div class="flex items-baseline gap-2.5"><span class="font-display text-2xs text-accent-600">03</span><span class="text-xs leading-snug text-ink">{t.chat.steps[2]}</span></div>
        </div>
      </div>
      </div>
    </div>

    <div
      class="absolute inset-x-0 bottom-0 flex items-center gap-2.5 px-5 py-3"
      style="background: linear-gradient(180deg, rgb(251 251 249 / 0) 0%, rgb(251 251 249 / 0.9) 40%, #fbfbf9 100%)"
    >
      <span
        class="h-1.5 w-1.5 rounded-full bg-accent-500"
        data-chain-live
        style="animation: chain-pulse 1.4s ease-in-out infinite"
        aria-hidden="true"></span>
      <span
        data-status
        class="font-display text-2xs uppercase tracking-widest text-ink-faint transition-opacity duration-400"
        aria-live="polite">{t.chain.typing}</span
      >
      <!-- The chain plays once and stops on the finished diagram; while it
           runs it can be held (WCAG 2.2.2), and replayed at any time. -->
      <button
        data-chain-pause
        data-label-pause={t.chat.pause}
        data-label-resume={t.chat.resume}
        aria-pressed="false"
        type="button"
        class="ml-auto inline-flex min-h-6 cursor-pointer items-center border-none bg-none px-1 font-display text-2xs uppercase tracking-widest text-ink-mute hover:text-accent-700"
        >{t.chat.pause}</button
      >
      <button
        data-replay
        type="button"
        class="inline-flex min-h-6 cursor-pointer items-center border-none bg-none px-1 font-display text-2xs uppercase tracking-widest text-ink-mute hover:text-accent-700"
        >{t.chat.replay}</button
      >
    </div>
  </div>
</div>

<style>
  /* The frame dissolves at its edges rather than cutting: anything the camera
     is moving past leaves the shot instead of being sliced through the middle.
     The bottom fade is deeper because the status line sits over it. */
  .stage-mask {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 30px, #000 calc(100% - 30px), transparent 100%),
      linear-gradient(to right, transparent 0, #000 30px, #000 calc(100% - 30px), transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent 0, #000 30px, #000 calc(100% - 30px), transparent 100%),
      linear-gradient(to right, transparent 0, #000 30px, #000 calc(100% - 30px), transparent 100%);
    mask-composite: intersect;
  }

  /* The options not chosen recede to the muted ink (chain.ts adds the class),
     which keeps their text at 4.5:1; fading the whole option did not. */
  .opt :is(div, span) {
    transition: color var(--duration-base) var(--ease-settle);
  }
  .opt:global(.opt--receded) :is(div, span) {
    color: var(--color-ink-mute);
  }
</style>
