<div
  data-chat-anchor
  class="overflow-hidden rounded-2xl border-[0.5px] border-ink/15 bg-white shadow-[0_32px_70px_-36px_rgb(42_48_31/0.35)]"
  data-reveal
>
  <div
    class="flex items-center justify-between border-b-[0.5px] border-ink/10 bg-[#fafaf8] px-6 py-[13px]"
  >
    <div class="flex items-center gap-2.5">
      <span class="h-[7px] w-[7px] rounded-full bg-[#17914d]" aria-hidden="true"></span>
      <span
        class="font-display text-xs font-semibold uppercase tracking-[0.05em] text-[#6f706c]"
        >Piloti · Decision Chain</span
      >
    </div>
    <span class="text-[11.5px] text-ink-ghost">Fiktives Beispiel</span>
  </div>
  <div data-stage class="relative h-[430px] overflow-hidden bg-[#fbfbf9]">
    <div data-cam class="absolute inset-0 origin-top-left will-change-transform">
      <div
        class="absolute left-0 top-0 w-[360px] rounded-2xl bg-[#ececea] p-[13px_17px] shadow-[0_1px_3px_rgb(30_40_30/0.1)]"
      >
        <div class="text-[13.5px] leading-[1.5] text-[#26272a]">
          <span data-q-text
            >Ich will das Stiegenhaus ins Freie führen und über eine gedämmte Loggia-Fassade
            erschließen. Was heißt das brandschutztechnisch?</span
          ><span
            data-q-caret
            class="ml-0.5 hidden h-[14px] w-[1.5px] bg-accent-500 align-[-2px]"
            style="animation: chainPulse 0.9s steps(1, end) infinite"></span>
        </div>
      </div>

      <div
        data-step-eq="1"
        class="absolute left-1 top-[106px] flex items-center gap-[9px]"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#6e7d52"
          stroke-width="2.4"
          stroke-linecap="round"
          style="animation: chainSpin 0.9s linear infinite"
          aria-hidden="true"
        >
          <path d="M12 3a9 9 0 1 0 9 9"></path>
        </svg>
        <span class="text-xs text-ink-faint">Quellen werden gesichtet …</span>
      </div>

      <svg
        width="1160"
        height="620"
        class="pointer-events-none absolute left-0 top-[92px] overflow-visible"
        aria-hidden="true"
      >
        <g data-step-gte="2">
          <line x1="14" y1="0" x2="14" y2="272" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.9s"></line>
          <circle cx="14" cy="40" r="3" fill="#26272a"></circle>
          <line x1="14" y1="40" x2="34" y2="40" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.45s"></line>
          <circle cx="124" cy="40" r="3" fill="#26272a"></circle>
          <line x1="124" y1="40" x2="150" y2="40" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.45s"></line>
        </g>
        <g data-step-gte="3">
          <circle cx="14" cy="132" r="3" fill="#26272a"></circle>
          <line x1="14" y1="132" x2="34" y2="132" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.45s"></line>
          <circle cx="124" cy="132" r="3" fill="#26272a"></circle>
          <line x1="124" y1="132" x2="150" y2="132" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.45s"></line>
        </g>
        <g data-step-gte="4">
          <circle cx="14" cy="228" r="3" fill="#26272a"></circle>
          <line x1="14" y1="228" x2="34" y2="228" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.45s"></line>
          <circle cx="124" cy="228" r="3" fill="#26272a"></circle>
          <line x1="124" y1="228" x2="150" y2="228" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.45s"></line>
        </g>
        <g data-step-gte="6">
          <path d="M450,40 C620,40 620,168 780,168" fill="none" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.8s"></path>
          <path d="M450,132 C620,132 620,168 780,168" fill="none" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.8s; --delay: 0.18s"></path>
          <path d="M450,228 C620,228 620,168 780,168" fill="none" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.8s; --delay: 0.36s"></path>
        </g>
        <g data-step-gte="9">
          <path d="M930,330 C930,394 990,398 990,428" fill="none" stroke="#26272a" stroke-width="1.6" stroke-dasharray="460" class="draw" style="--dur: 0.7s"></path>
        </g>
      </svg>

      <div data-step-gte="2" class="pop absolute left-[34px] top-[118px] flex h-7 w-[90px] items-center justify-center rounded-[10px] bg-[#e3eafb] text-[11.5px] font-semibold text-[#1c47ab]">OIB-RL 2</div>
      <div data-step-gte="2" class="pop absolute left-[150px] top-[106px] w-[280px] rounded-[14px] border border-[#dcdfd8] bg-white p-[9px_14px] shadow-[0_2px_8px_rgb(30_40_30/0.08)]">
        <div class="text-[12.5px] font-semibold text-ink">Pkt. 3.5 — Fassaden</div>
        <div class="mt-0.5 text-[11px] leading-[1.35] text-ink-faint">Brandausbreitung über die Außenwand, GK 4</div>
      </div>

      <div data-step-gte="3" class="pop absolute left-[34px] top-[210px] flex h-7 w-[90px] items-center justify-center rounded-[10px] bg-[#e3eafb] text-[11.5px] font-semibold text-[#1c47ab]">BO Wien</div>
      <div data-step-gte="3" class="pop absolute left-[150px] top-[198px] w-[280px] rounded-[14px] border border-[#dcdfd8] bg-white p-[9px_14px] shadow-[0_2px_8px_rgb(30_40_30/0.08)]">
        <div class="text-[12.5px] font-semibold text-ink">§ 106 — Fluchtwege</div>
        <div class="mt-0.5 text-[11px] leading-[1.35] text-ink-faint">Stiegenhaus ins Freie, zweiter Rettungsweg</div>
      </div>

      <div data-step-gte="4" class="pop absolute left-[34px] top-[306px] flex h-7 w-[90px] items-center justify-center rounded-[10px] bg-[#e7f0e0] text-[11.5px] font-semibold text-[#3f6b50]">Projekt</div>
      <div data-step-gte="4" class="pop absolute left-[150px] top-[294px] w-[280px] rounded-[14px] border border-[#dcdfd8] bg-white p-[9px_14px] shadow-[0_2px_8px_rgb(30_40_30/0.08)]">
        <div class="text-[12.5px] font-semibold text-ink">Einreichplan_EG.pdf</div>
        <div class="mt-0.5 text-[11px] leading-[1.35] text-ink-faint">WDVS 14 cm EPS, Loggia über 2 Geschoße</div>
      </div>

      <div
        data-step-gte="7"
        class="pop absolute left-[780px] top-[172px] w-[300px] overflow-hidden rounded-2xl border border-[#dcdfd8] bg-white shadow-[0_8px_24px_rgb(30_40_30/0.16)]"
      >
        <div class="bg-ink px-[18px] py-[11px]">
          <span class="font-display text-[11px] font-bold uppercase tracking-[0.08em] text-[#f2f2f0]">Entscheidung</span>
        </div>
        <div class="px-4 pb-0.5 pt-[13px] text-xs leading-[1.5] text-ink-soft">Für Ihr WDVS (GK 4) haben Sie drei Wege:</div>
        <div class="flex flex-col gap-[9px] p-[12px_14px_14px]">
          <div data-opt="a" class="opt flex items-start gap-[11px] rounded-[10px] border-l-[3px] border-[#dcdfd8] bg-white p-[10px_14px]">
            <span class="text-[12.5px] font-bold text-[#17914d]">A</span>
            <div>
              <div class="text-[13px] font-semibold text-ink">Loggia in A2</div>
              <div class="mt-0.5 text-[11.5px] leading-[1.4] text-ink-faint">übrige Fassade EPS ≤ 10 cm</div>
            </div>
          </div>
          <div data-opt="b" class="opt flex items-start gap-[11px] rounded-[10px] border-l-[3px] border-[#dcdfd8] bg-white p-[10px_14px]">
            <span class="text-[12.5px] font-bold text-[#17914d]">B</span>
            <div>
              <div class="text-[13px] font-semibold text-ink">EPS &gt; 10 cm mit Schott</div>
              <div class="mt-0.5 text-[11.5px] leading-[1.4] text-ink-faint">Brandschutzschott je Geschoß</div>
            </div>
          </div>
          <div data-opt="c" class="opt flex items-start gap-[11px] rounded-[10px] border-l-[3px] border-[#dcdfd8] bg-white p-[10px_14px]">
            <span class="text-[12.5px] font-bold text-[#17914d]">C</span>
            <div>
              <div class="text-[13px] font-semibold text-ink">Mit der Behörde klären</div>
              <div class="mt-0.5 text-[11.5px] leading-[1.4] text-ink-faint">Loggia als „offener Durchgang"</div>
            </div>
          </div>
        </div>
      </div>

      <div
        data-step-gte="9"
        class="pop absolute left-[840px] top-[520px] w-[320px] overflow-hidden rounded-2xl border border-[#dcdfd8] bg-white shadow-[0_8px_24px_rgb(30_40_30/0.16)]"
      >
        <div class="flex items-center justify-between bg-accent-900 px-[18px] py-[11px]">
          <span class="font-display text-[11px] font-bold uppercase tracking-[0.08em] text-surface">Umsetzung — B</span>
          <span class="rounded-[10px] bg-[#cfe0a8] px-2.5 py-0.5 text-[11px] font-semibold text-accent-900">3 Schritte</span>
        </div>
        <div class="flex flex-col gap-[9px] p-[12px_16px_16px]">
          <div class="flex items-baseline gap-2.5"><span class="font-display text-[11px] text-accent-500">01</span><span class="text-[12.5px] leading-[1.45] text-ink">Schott je Geschoß im Fassadenschnitt eintragen</span></div>
          <div class="flex items-baseline gap-2.5"><span class="font-display text-[11px] text-accent-500">02</span><span class="text-[12.5px] leading-[1.45] text-ink">Nachweis OIB-RL 2, Pkt. 3.5 der Einreichung beilegen</span></div>
          <div class="flex items-baseline gap-2.5"><span class="font-display text-[11px] text-accent-500">03</span><span class="text-[12.5px] leading-[1.45] text-ink">Mehrkosten 4.200 € in die Kostenschätzung übernehmen</span></div>
        </div>
      </div>
    </div>

    <div
      class="absolute inset-x-0 bottom-0 flex items-center gap-2.5 px-5 py-[11px]"
      style="background: linear-gradient(180deg, rgb(251 251 249 / 0) 0%, rgb(251 251 249 / 0.9) 40%, #fbfbf9 100%)"
    >
      <span
        class="h-1.5 w-1.5 rounded-full bg-accent-500"
        style="animation: chainPulse 1.4s ease-in-out infinite"
        aria-hidden="true"></span>
      <span
        data-status
        class="font-display text-[11px] uppercase tracking-[0.1em] text-ink-faint transition-opacity duration-[400ms]"
        aria-live="polite">Frage wird eingegeben</span
      >
      <button
        data-replay
        type="button"
        class="ml-auto cursor-pointer border-none bg-none font-display text-[11px] uppercase tracking-[0.1em] text-[#9a9a96] hover:text-accent-500"
        >↻ Erneut abspielen</button
      >
    </div>
  </div>
</div>

<style>
  html.js [data-step-gte],
  html.js [data-step-eq] {
    opacity: 0;
  }
  html.js [data-step-gte][data-active],
  html.js [data-step-eq][data-active] {
    opacity: 1;
  }
  html.js .pop[data-step-gte][data-active],
  html.js [data-step-eq][data-active] {
    animation: chainFadeIn 0.55s ease-out both;
  }
  html.js [data-step-eq='1'][data-active] {
    animation-duration: 0.3s;
  }
  html.js g[data-step-gte] line,
  html.js g[data-step-gte] path {
    stroke-dashoffset: 460;
  }
  html.js g[data-step-gte][data-active] line,
  html.js g[data-step-gte][data-active] path {
    animation: chainDraw var(--dur, 0.9s) var(--delay, 0s) ease-out both;
  }
  html.js g[data-step-gte] circle {
    opacity: 0;
  }
  html.js g[data-step-gte][data-active] circle {
    opacity: 1;
  }
  .opt {
    transition:
      opacity 700ms ease,
      background 700ms ease,
      border-color 700ms ease;
  }
  [data-opt][data-dimmed] {
    opacity: 0.32;
  }
  [data-opt='b'][data-picked] {
    background: #eef6ee;
    border-left-color: #17914d;
  }
</style>
