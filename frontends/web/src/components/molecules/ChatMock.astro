---
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
const options = [
  { key: 'A', title: t.chat.optATitle, sub: t.chat.optASub, chosen: false },
  { key: 'B', title: t.chat.optBTitle, sub: t.chat.optBSub, chosen: true },
  { key: 'C', title: t.chat.optCTitle, sub: t.chat.optCSub, chosen: false },
]
const sources = [
  { chip: 'OIB-RL 2', law: true, title: t.chat.oibTitle, sub: t.chat.oibSub },
  { chip: 'BO Wien', law: true, title: t.chat.boTitle, sub: t.chat.boSub },
  { chip: t.chat.projTag, law: false, title: 'Einreichplan_EG.pdf', sub: t.chat.projSub },
]
/**
 * The board's check table: each way (row) against each source (column, in the
 * order of `sources`). `open` is neither met nor broken: it waits on the
 * authority. The reasons in `t.chat.reasons` say the same in words, so the two
 * change together.
 */
const MARKS = ['ok', 'no', 'open'] as const
type Mark = (typeof MARKS)[number]
/** A tick, a cross (two strokes, drawn one after the other); `open` is a ring. */
const MARK_PATH: Record<Exclude<Mark, 'open'>, string> = {
  ok: 'M3.5 8.4l3 3 6-6.9',
  no: 'M4.75 4.75l6.5 6.5M11.25 4.75l-6.5 6.5',
}
const checks: Mark[][] = [
  ['ok', 'ok', 'no'],
  ['ok', 'ok', 'ok'],
  ['open', 'open', 'ok'],
]
---

<!-- ── The chain as a column ─────────────────────────────────────────────────
     The same chain read top to bottom at full size: question, sources,
     decision, steps, strung on one spine. It is the finished state in the
     markup; scripts/chain.ts (initChainList) only adds the arrival.
     Nutzung renders ChatMock from lg up only (below it the chain is told as
     ChainStories), and the board below now fits its card and is its own
     still frame under reduced motion, so this list is not shown at present. -->
<div
  data-chain-list
  class="overflow-hidden rounded-[1.5rem] bg-white shadow-mock ring-1 ring-ink/10 lg:hidden"
>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-ink/8 bg-paper-dim px-5 py-3">
    <div class="flex items-center gap-2.5">
      <span class="size-1.5 rounded-full bg-ok" aria-hidden="true"></span>
      <span class="font-mono text-2xs font-medium uppercase tracking-label text-ink-mute">{t.chat.header}</span>
    </div>
    <span class="font-mono text-2xs uppercase tracking-widest text-ink-ghost">{t.chat.fictional}</span>
  </div>

  <ol class="relative m-0 flex list-none flex-col gap-7 px-4 pb-6 pt-6 sm:px-6">
    <span
      data-chain-spine
      class="absolute bottom-10 left-[calc(1rem+11px)] top-9 w-px origin-top bg-ink/15 sm:left-[calc(1.5rem+11px)]"
      aria-hidden="true"></span>

    <li data-chain-step class="relative pl-9">
      <span class="absolute left-0 top-0 grid size-[23px] place-items-center rounded-full bg-white font-mono text-2xs text-ink-mute ring-1 ring-ink/15" aria-hidden="true">1</span>
      <p class="m-0 font-mono text-2xs uppercase leading-[23px] tracking-label text-ink-faint">{t.chat.questionLabel}</p>
      <p class="m-0 mt-2 rounded-2xl rounded-tl-md bg-bubble px-4 py-3 text-[0.9375rem] leading-snug text-ink">
        {t.chat.question}
      </p>
    </li>

    <li data-chain-step class="relative pl-9">
      <span class="absolute left-0 top-0 grid size-[23px] place-items-center rounded-full bg-white font-mono text-2xs text-ink-mute ring-1 ring-ink/15" aria-hidden="true">2</span>
      <p class="m-0 font-mono text-2xs uppercase leading-[23px] tracking-label text-ink-faint">{t.chat.sourcesLabel}</p>
      <ul class="m-0 mt-2 list-none divide-y divide-hairline overflow-hidden rounded-xl border border-hairline p-0">
        {
          sources.map((s) => (
            <li class="flex items-start gap-3 bg-white px-3.5 py-3">
              <span
                class={`mt-px inline-flex h-6 shrink-0 items-center rounded-md px-2 text-2xs font-semibold ${s.law ? 'bg-chip-law text-chip-law-ink' : 'bg-chip-project text-chip-project-ink'}`}
              >
                {s.chip}
              </span>
              <span class="min-w-0">
                <span class="block break-words text-sm font-semibold leading-snug text-ink">{s.title}</span>
                <span class="mt-0.5 block text-xs leading-snug text-ink-mute">{s.sub}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </li>

    <li data-chain-step class="relative pl-9">
      <span class="absolute left-0 top-0 grid size-[23px] place-items-center rounded-full bg-ink font-mono text-2xs text-on-dark-strong" aria-hidden="true">3</span>
      <p class="m-0 font-mono text-2xs uppercase leading-[23px] tracking-label text-ink">{t.chat.decision}</p>
      <div class="mt-2 rounded-xl border border-hairline bg-white p-3 shadow-card">
        <p class="m-0 px-1 pb-2.5 text-sm leading-snug text-ink-soft">{t.chat.decisionIntro}</p>
        <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
          {
            options.map((o) => (
              <li
                class={`flex items-start gap-3 rounded-lg border-l-2 px-3 py-2.5 ${o.chosen ? 'border-ok bg-[#eef6ee]' : 'border-hairline'}`}
              >
                {/* The options not chosen recede to the muted ink, as they do on
                    the board (.opt--receded below): faded with opacity they fell
                    to 2.4–3.9:1. */}
                <span class={`text-xs font-bold leading-5 ${o.chosen ? 'text-ok' : 'text-ink-mute'}`}>{o.key}</span>
                <span class="min-w-0">
                  <span class={`block text-sm font-semibold leading-5 ${o.chosen ? 'text-ink' : 'text-ink-mute'}`}>{o.title}</span>
                  <span class="mt-0.5 block text-xs leading-snug text-ink-mute">{o.sub}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </li>

    <li data-chain-step class="relative pl-9">
      <span class="absolute left-0 top-0 grid size-[23px] place-items-center rounded-full bg-accent-900 font-mono text-2xs text-surface" aria-hidden="true">4</span>
      <div class="flex items-center justify-between gap-3">
        <p class="m-0 font-mono text-2xs uppercase leading-[23px] tracking-label text-accent-900">{t.chat.impl}</p>
        <span class="rounded-md bg-tint px-2 py-0.5 text-2xs font-semibold text-accent-900">{t.chat.stepsBadge}</span>
      </div>
      <ol class="m-0 mt-2 flex list-none flex-col gap-2.5 rounded-xl border border-hairline bg-white p-3.5">
        {
          t.chat.steps.map((step, i) => (
            <li class="flex items-baseline gap-3">
              <span class="font-mono text-2xs text-accent-600">{`0${i + 1}`}</span>
              <span class="text-sm leading-snug text-ink">{step}</span>
            </li>
          ))
        }
      </ol>
    </li>
  </ol>

  <div class="flex items-center gap-2.5 border-t border-ink/8 bg-paper px-5 py-3">
    <span class="size-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
    <span class="font-mono text-2xs uppercase tracking-widest text-ink-faint">{t.chain.beats.at(-1)}</span>
  </div>
</div>


<!-- ── Desktop: the board ────────────────────────────────────────────────────
     The chain as linked nodes: the question fans out to the three sources,
     each source is wired into its own column of the decision's check table,
     and the chosen way is wired on to the steps. Every wire is generated from
     the measured nodes (scripts/chain.ts), so the chain fits its card at any
     width from lg up and nothing pans or crops.

     The selection logic is in the table: each way against each source, one
     mark per pair, a reason under each way. The markup is the finished
     chain, which is what reduced motion (and a page without script, minus
     the wires) shows; with motion chain.ts plays it once as it comes into
     view, and during the check each source, its wire and its column light
     together. -->
<div
  data-chat-anchor
  class="overflow-hidden rounded-[1.5rem] bg-white shadow-mock ring-1 ring-ink/10 max-lg:hidden"
  data-reveal
>
  <div class="flex items-center justify-between gap-4 border-b border-ink/8 bg-paper-dim px-6 py-3">
    <div class="flex items-center gap-2.5">
      <span class="size-1.5 rounded-full bg-ok" aria-hidden="true"></span>
      <span class="font-mono text-2xs font-medium uppercase tracking-label text-ink-mute"
        >{t.chat.header} · {t.chat.chainTitle}</span
      >
    </div>
    <span class="font-mono text-2xs uppercase tracking-widest text-ink-ghost">{t.chat.fictional}</span>
  </div>

  <div data-net class="relative bg-paper px-6 pb-6 pt-5 xl:px-7">
    <!-- Empty by design: chain.ts draws the wires from the nodes' boxes. -->
    <svg data-wires class="pointer-events-none absolute inset-0 size-full overflow-visible" aria-hidden="true"
    ></svg>

    <ol class="relative m-0 list-none p-0">
      <!-- The question. -->
      <li class="mr-10">
        <p class="sr-only">{t.chat.questionLabel}</p>
        <p
          data-node="q"
          class="m-0 rounded-2xl rounded-tl-md bg-bubble px-4 py-3 text-sm leading-relaxed text-ink shadow-card"
        >
          {t.chat.question}
        </p>
      </li>

      <!-- The sources. The number in each ring is the column it feeds. -->
      <li class="mt-9">
        <p class="sr-only">{t.chat.sourcesLabel}</p>
        <ul class="m-0 grid list-none grid-cols-3 gap-3 p-0">
          {
            sources.map((s, i) => (
              <li
                data-node="src"
                class="layered overflow-hidden rounded-xl border border-hairline bg-white px-3 py-2.5 shadow-card"
              >
                <span data-lit class="lit" aria-hidden="true" />
                <span class="flex items-center gap-2">
                  <span class="ref" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span
                    class={`inline-flex h-5 items-center rounded-md px-1.5 text-2xs font-semibold ${s.law ? 'bg-chip-law text-chip-law-ink' : 'bg-chip-project text-chip-project-ink'}`}
                  >
                    {s.chip}
                  </span>
                </span>
                {/* A file name may break after its underscore, not mid-word. */}
                <span class="mt-2 block text-xs font-semibold leading-snug text-ink">
                  {s.title.split('_').map((part, k, parts) => (k < parts.length - 1 ? <>{`${part}_`}<wbr /></> : part))}
                </span>
                <span class="mt-0.5 block text-2xs leading-snug text-ink-mute max-xl:hidden">{s.sub}</span>
              </li>
            ))
          }
        </ul>
      </li>

      <!-- The decision: each way checked against each source. The column
           heads sit where the sources' wires land. -->
      <li data-node="dec" class="mt-10 overflow-hidden rounded-2xl border border-hairline bg-white shadow-lift">
        <div data-matrix class="relative">
          <!-- The column lit while its source is checked: one layer under the
               table, placed by chain.ts from the measured header cell; it only
               fades and slides. The chosen way's tint is a layer in each of
               its cells, so the finished table needs no script to show it. -->
          <span data-col-lit class="col-lit" aria-hidden="true"></span>
          <table class="matrix relative w-full text-left">
            <thead>
              <tr>
                <th scope="col" class="px-3.5 pb-2 pt-3 align-bottom font-normal">
                  <span class="sr-only">{t.chat.optionCol}</span>
                  <span class="block font-mono text-2xs font-medium uppercase tracking-label text-ink" aria-hidden="true"
                    >{t.chat.decision}</span
                  >
                  <!-- The key to the marks, in the cell the table leaves
                       empty. Each mark carries its word for a screen reader,
                       so this is for the eye only. -->
                  <span
                    class="mt-1.5 flex flex-wrap gap-x-3 gap-y-0.5 font-mono text-2xs text-ink-faint"
                    aria-hidden="true"
                  >
                    {
                      MARKS.map((m) => (
                        <span class="inline-flex items-center gap-1">
                          <svg class={`mark mark--${m} mark--sm`} viewBox="0 0 16 16">
                            {m === 'open' ? <circle cx="8" cy="8" r="4.25" /> : <path d={MARK_PATH[m]} />}
                          </svg>
                          {t.chat.marks[m]}
                        </span>
                      ))
                    }
                  </span>
                </th>
                {
                  t.chat.checkCols.map((c, i) => (
                    <th data-col scope="col" class="w-14 px-0 pb-2 pt-3 align-bottom font-normal xl:w-[4.5rem]">
                      <span class="flex flex-col items-center gap-1">
                        <span class="ref" aria-hidden="true">{i + 1}</span>
                        <span class="whitespace-nowrap font-mono text-2xs text-ink-mute" aria-hidden="true">{c}</span>
                        <span class="sr-only">{t.chat.checkColsFull[i]}</span>
                      </span>
                    </th>
                  ))
                }
              </tr>
            </thead>
            {
              options.map((o, r) => (
                <tbody data-opt class:list={['opt', o.chosen ? 'is-chosen' : 'is-receded']}>
                  <tr>
                    <th scope="row" class="py-2 pl-3.5 pr-2 text-left align-top font-normal">
                      {o.chosen && <span data-pick class="pick" aria-hidden="true" />}
                      <span class="flex items-baseline gap-2.5">
                        <span class="opt-key font-mono text-xs font-medium">{o.key}</span>
                        <span class="min-w-0">
                          <span class="opt-title block text-sm font-semibold leading-snug">{o.title}</span>
                          <span class="mt-0.5 block text-xs leading-snug text-ink-mute">{o.sub}</span>
                        </span>
                      </span>
                    </th>
                    {checks[r].map((m) => (
                      <td class="py-2 text-center align-top">
                        {o.chosen && <span data-pick class="pick" aria-hidden="true" />}
                        <svg data-mark class={`mark mark--${m}`} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                          {m === 'open' ? <circle cx="8" cy="8" r="4.25" /> : <path d={MARK_PATH[m]} />}
                        </svg>
                        <span class="sr-only">{t.chat.marks[m]}</span>
                      </td>
                    ))}
                  </tr>
                  <tr data-why>
                    <td colspan="4" class="pb-2.5 pl-[2.35rem] pr-3.5 pt-0 text-xs leading-snug text-ink-mute">
                      {o.chosen && <span data-pick class="pick" aria-hidden="true" />}
                      <span class="verdict">{o.chosen ? t.chat.chosen : t.chat.notChosen}</span>
                      {t.chat.reasons[r]}
                    </td>
                  </tr>
                </tbody>
              ))
            }
          </table>
        </div>
      </li>

      <!-- The steps, wired from the way chosen. -->
      <li data-node="impl" class="ml-8 mt-6 overflow-hidden rounded-2xl border border-hairline bg-white shadow-lift">
        <div class="flex items-center justify-between gap-3 bg-accent-900 px-4 py-2.5">
          <span class="font-mono text-2xs font-medium uppercase tracking-label text-surface">{t.chat.impl}</span>
          <span class="rounded-md bg-tint px-2 py-0.5 text-2xs font-semibold text-accent-900">{t.chat.stepsBadge}</span>
        </div>
        <ol class="m-0 flex list-none flex-col gap-1.5 px-4 pb-3.5 pt-3">
          {
            t.chat.steps.map((step, i) => (
              <li data-impl class="grid grid-cols-[1rem_minmax(0,1fr)] items-baseline gap-x-2.5">
                <span class="font-mono text-2xs text-accent-600">{i + 1}</span>
                <span class="text-sm leading-snug text-ink">{step}</span>
              </li>
            ))
          }
        </ol>
      </li>
    </ol>
  </div>

  <!-- The status line says what the chain is doing while it plays, and what
       it is when it has finished. The chain plays once; while it runs it can
       be held (WCAG 2.2.2), and when it is done it can be replayed. Both
       controls start hidden: without motion nothing plays. -->
  <div class="flex min-h-10 items-center gap-2.5 border-t border-ink/8 bg-white px-6 py-2">
    <span class="size-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
    <span data-status class="font-mono text-2xs uppercase tracking-widest text-ink-faint" aria-live="polite"
      >{t.chain.beats.at(-1)}</span
    >
    <button
      data-chain-pause
      data-label-pause={t.chat.pause}
      data-label-resume={t.chat.resume}
      aria-pressed="false"
      type="button"
      hidden
      class="board-ctl ml-auto">{t.chat.pause}</button
    >
    <button data-replay type="button" hidden class="board-ctl ml-auto">{t.chat.replay}</button>
  </div>
</div>

<style>
  /* The number a source and its column share. */
  .ref {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(27 28 25 / 0.24);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    color: var(--color-ink-mid);
  }

  /* Highlights are layers that fade (and the column one slides): nothing
     here animates a colour or a size. A layer sits under its cell's content,
     at z-index -1 inside the cell's own stacking context. */
  .layered,
  .matrix :is(th, td) {
    position: relative;
    isolation: isolate;
  }
  .lit,
  .pick {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .lit {
    opacity: 0;
    background: var(--color-surface);
  }
  .col-lit {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 0.5rem;
    background: var(--color-surface);
    opacity: 0;
    pointer-events: none;
  }

  /* The chosen way: one tint across its cells, a rule of ok ink down its
     left edge (where its wire leaves for the steps). */
  .pick {
    background: rgb(15 122 61 / 0.06);
  }
  .matrix {
    border-collapse: separate;
    border-spacing: 0;
  }
  .opt tr:first-child > * {
    border-top: 1px solid var(--color-hairline);
  }
  .opt tr:first-child > th .pick,
  .opt [data-why] .pick {
    box-shadow: inset 2px 0 0 var(--color-ok);
  }

  .mark {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mark--sm {
    width: 0.875rem;
    height: 0.875rem;
  }
  .mark--ok {
    stroke: var(--color-ok);
  }
  .mark--no {
    stroke: var(--color-ink);
  }
  .mark--open {
    stroke: var(--color-ink-mute);
    stroke-width: 1.5;
  }

  /* The verdict. The ways not chosen recede to the muted ink, which keeps
     them at 4.5:1 (fading them with opacity did not); their marks stay, since
     the cross is the reason. chain.ts takes the classes off and puts them
     back when the check has run. */
  .opt-key,
  .opt-title {
    color: var(--color-ink);
    transition: color var(--duration-base) var(--ease-settle);
  }
  .opt.is-receded .opt-key,
  .opt.is-receded .opt-title {
    color: var(--color-ink-mute);
  }
  .opt.is-chosen .opt-key {
    color: var(--color-ok);
  }
  .verdict {
    margin-right: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .opt.is-chosen .verdict {
    color: var(--color-ok);
    font-weight: 500;
  }
  .opt.is-chosen [data-why] td {
    color: var(--color-ink-soft);
  }

  .board-ctl {
    display: inline-flex;
    min-height: 1.5rem;
    align-items: center;
    padding: 0 0.25rem;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-mute);
    transition: color var(--duration-tick) var(--ease-settle);
  }
  .board-ctl:hover {
    color: var(--color-accent-700);
  }
  .board-ctl[hidden] {
    display: none;
  }
</style>
