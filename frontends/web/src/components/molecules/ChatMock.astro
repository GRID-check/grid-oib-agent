---
/**
 * The decision chain from `lg` up: a wired graph read left to right, dressed
 * as the phone's stories (ChainStories).
 *
 * The geometry is the original board's. The question sits top left and the
 * three sources hang below it off one stem, each a chip and a card on a
 * short stub. Curved wires run from the sources into the decision on the
 * right, and from the chosen way a wire runs on down to the steps. The
 * surfaces are the phone's: the question and the decision on the dark panel,
 * the sources as index cards on the drawing grid, the steps on sage, the
 * serif voice, the mono labels, B ringed in lime, each way's reason.
 *
 * No camera: the board is laid out at its true size by CSS grid, and
 * scripts/chain.ts draws the wires from the measured boxes (so they follow
 * the layout at every width) and adds the arrival. Everything else is in the
 * markup in its finished state, which is what reduced motion shows.
 */
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
const s = t.stories
const total = s.frames.length

const sources = [
  { chip: 'OIB-RL 2', law: true, title: t.chat.oibTitle, sub: t.chat.oibSub },
  { chip: 'BO Wien', law: true, title: t.chat.boTitle, sub: t.chat.boSub },
  { chip: t.chat.projTag, law: false, title: 'Einreichplan_EG.pdf', sub: t.chat.projSub },
]
const options = [
  { key: 'A', title: t.chat.optATitle, sub: t.chat.optASub, why: s.why[0], chosen: false },
  { key: 'B', title: t.chat.optBTitle, sub: t.chat.optBSub, why: s.why[1], chosen: true },
  { key: 'C', title: t.chat.optCTitle, sub: t.chat.optCSub, why: s.why[2], chosen: false },
]
const pad = (i: number) => String(i + 1).padStart(2, '0')
const count = (i: number) => `${i + 1}/${total}`
---

<div data-chain-board class="board" role="group" aria-label={s.region}>
  <div class="board-head">
    <p class="caption m-0"><span class="caption-dot" aria-hidden="true"></span>{t.chat.fictional}</p>
    <!-- Hidden until the script arms the sequence: without it (or without
         motion) there is nothing to hold or replay. -->
    <button
      type="button"
      data-chain-toggle
      class="pill"
      data-label-pause={s.pause}
      data-label-resume={t.chat.resume}
      data-label-replay={s.replay}
      hidden>{s.pause}</button
    >
  </div>

  <div class="stage" data-chain-stage>
    <!-- Empty by design: every wire is generated from the measured boxes of
         the cards it joins (scripts/chain.ts), so a card that moves takes its
         wires with it. -->
    <svg data-wires class="wires" aria-hidden="true"></svg>

    <!-- 1 · Frage -->
    <div class="node node--q sheet sheet--dark" data-node="q">
      <p class="meta"><span>{s.frames[0]}</span><span class="meta-count" aria-hidden="true"><span class="here" data-here></span>{count(0)}</span></p>
      <p class="q m-0">{t.chat.question}</p>
      <!-- The project facts as one line: the same facts the phone lists. -->
      <p class="facts m-0">
        {
          s.context.map(([k, v], i) => (
            <>
              {i > 0 && <span class="facts-sep" aria-hidden="true"> · </span>}
              <span class="sr-only">{k}: </span>
              {v}
            </>
          ))
        }
      </p>
    </div>

    <!-- 2 · Quellen: one stem, three sources at once. -->
    <div class="node node--srcs" data-node="srcs">
      <p class="meta meta--srcs"><span>{s.frames[1]}</span><span class="meta-count" aria-hidden="true"><span class="here" data-here></span>{count(1)}</span></p>
      <ul class="rows m-0 list-none p-0">
        {
          sources.map((src) => (
            <li class="row" data-row>
              <span
                data-chip
                class={`chip ${src.law ? 'bg-chip-law text-chip-law-ink' : 'bg-chip-project text-chip-project-ink'}`}
              >
                {src.chip}
              </span>
              <span class="card" data-card>
                <span class="card-title">{src.title}</span>
                <span class="card-sub">{src.sub}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 3 · Entscheidung: three ways, B ringed in lime, each with its reason. -->
    <div class="node node--dec sheet sheet--dark" data-node="dec">
      <p class="meta"><span>{s.frames[2]}</span><span class="meta-count" aria-hidden="true"><span class="here" data-here></span>{count(2)}</span></p>
      <p class="intro m-0">{t.chat.decisionIntro}</p>
      <ul class="opts m-0 list-none p-0" data-port="in">
        {
          options.map((o) => (
            <li class:list={['opt', { 'is-chosen': o.chosen }]} data-opt data-port={o.chosen ? 'out' : undefined}>
              {o.chosen && <span class="opt-field" data-opt-field aria-hidden="true" />}
              <span class="opt-key">
                {o.key}
                {o.chosen && (
                  <svg class="ink" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                    <path
                      data-opt-ink
                      pathLength="1"
                      d="M31 6.5C20 3 7.5 9 5.8 21.5 4.3 33 13 42.5 25 41.8 36.5 41 43.6 32 42.2 21 41 12 33 6.2 23.5 7.2"
                    />
                  </svg>
                )}
              </span>
              <span class="opt-text">
                <span class="opt-title">{o.title}</span>
                {/* The description gives way to the reason once the choice is
                    made; both sit in one cell, so nothing reflows. */}
                <span class="opt-swap">
                  <span class="opt-sub" data-opt-sub aria-hidden="true">{o.sub}</span>
                  <span class="opt-why" data-opt-why>{o.why}</span>
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 4 · Umsetzung – B -->
    <div class="node node--impl sheet sheet--sage" data-node="impl">
      <p class="meta"><span>{t.chat.impl}</span><span class="meta-count" aria-hidden="true"><span class="here" data-here></span>{count(3)}</span></p>
      <ol class="steps m-0 list-none p-0">
        {
          t.chat.steps.map((step, k) => (
            <li class="step" data-step>
              <svg class="box" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="2.5" y="2.5" width="19" height="19" rx="4" />
                <path data-step-check pathLength="1" d="M7 12.4l3.4 3.4L17.4 8.2" />
              </svg>
              <span class="step-text">
                <span class="step-no" aria-hidden="true">{pad(k)}</span> {step}
              </span>
            </li>
          ))
        }
      </ol>
      <div class="done" data-done>
        <p class="done-line m-0">{s.complete} <span aria-hidden="true">✓</span></p>
        <p class="cost m-0">{s.cost}</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── The board ─────────────────────────────────────────────────────────────
     The phone's stage, widened: the drawing grid on paper, the same radius
     and shadow, and the four stages laid on it as one wired graph. */
  .board {
    container-type: inline-size;
  }
  .board-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.25rem;
    margin-bottom: 0.625rem;
    padding: 0 0.25rem;
  }
  .caption,
  .pill {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .caption {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-ink-mute);
  }
  .caption-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-ok);
  }
  .pill {
    min-height: 2.25rem;
    border: 0;
    border-radius: 999px;
    padding: 0 1rem;
    background: transparent;
    box-shadow: inset 0 0 0 1px rgb(42 48 31 / 0.16);
    color: var(--color-ink-soft);
    cursor: pointer;
  }
  .pill:hover {
    color: var(--color-accent-700);
  }
  .pill:focus-visible {
    outline: 2px solid var(--color-accent-500);
    outline-offset: 2px;
  }
  .pill[hidden] {
    display: none;
  }

  /* Two columns and a wire gutter between them: the question over its
     sources on the left, the decision over its steps on the right. The
     decision starts a little down, level with the sources that feed it. */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) 3.25rem minmax(0, 1.08fr);
    grid-template-areas:
      'q    . dec'
      'srcs . dec'
      'srcs . impl';
    grid-template-rows: auto auto 1fr;
    gap: 0.875rem 0;
    border-radius: 1.25rem;
    padding: 1.125rem;
    background-color: var(--color-paper);
    background-image:
      linear-gradient(rgb(42 48 31 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(42 48 31 / 0.05) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: -1px -1px;
    box-shadow:
      0 0 0 1px var(--color-hairline),
      var(--shadow-mock);
    color: var(--color-ink);
  }
  .wires {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .node {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .node--q {
    grid-area: q;
  }
  .node--srcs {
    grid-area: srcs;
  }
  /* The gap on the right leaves room for B's wire to run out past the card
     and turn down onto the steps. */
  .node--dec {
    grid-area: dec;
    align-self: start;
    margin: 1rem 0.875rem 0 0;
  }
  .node--impl {
    grid-area: impl;
    align-self: start;
  }

  /* ── Sheets: the phone's frames ────────────────────────────────────────── */
  .sheet {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    border-radius: 0.875rem;
    padding: 0.8125rem 0.9375rem 0.9375rem;
    box-shadow: var(--shadow-card);
  }
  .sheet--dark {
    background: var(--color-panel);
    color: var(--color-on-dark-strong);
  }
  .sheet--sage {
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px rgb(42 48 31 / 0.1),
      var(--shadow-card);
  }
  .meta {
    display: flex;
    margin: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.25rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }
  .sheet--dark .meta {
    color: var(--color-on-dark-tag);
  }
  .sheet--sage .meta {
    color: var(--color-accent-600);
  }
  .meta-count {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* You are here: the phone's lime, with a halo, beside the stage the chain
     has reached. At rest it marks the last one. */
  .here {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-accent-400);
    box-shadow: 0 0 0 3px rgb(164 208 106 / 0.3);
    opacity: 0;
  }
  .node--impl .here {
    opacity: 1;
  }

  /* 1 · Frage */
  .q {
    font-family: var(--font-voice);
    font-size: clamp(1.0625rem, 0.5rem + 1.9cqi, 1.3125rem);
    line-height: 1.15;
    text-wrap: pretty;
  }
  .facts {
    border-top: 1px solid rgb(238 242 228 / 0.14);
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-on-dark-strong);
  }
  .facts-sep {
    color: var(--color-on-dark-tag);
  }

  /* 2 · Quellen: the stem runs down the left edge (drawn by the script);
     each row is a stub, a chip, a stub and an index card. */
  .meta--srcs {
    padding-left: 1.75rem;
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.375rem;
    padding-left: 1.75rem;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .chip {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 1.5rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .card {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.125rem;
    border-radius: 0.75rem;
    padding: 0.5rem 0.6875rem 0.5625rem;
    background: #fff;
    box-shadow:
      0 0 0 1px var(--color-hairline),
      var(--shadow-card);
  }
  .card-title {
    font-family: var(--font-voice);
    font-size: 1.0625rem;
    line-height: 1.15;
  }
  .card-sub {
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--color-ink-mute);
  }

  /* 3 · Entscheidung */
  .intro {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-on-dark);
  }
  .opts {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
  }
  .opt {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    border-radius: 0.75rem;
    padding: 0.4375rem 0.625rem 0.5rem;
    box-shadow: inset 0 0 0 1px rgb(238 242 228 / 0.1);
    color: var(--color-on-dark);
  }
  /* B wins by what it gains: a lime field and rule, arriving with the ink. */
  .opt.is-chosen {
    color: var(--color-on-dark-strong);
  }
  .opt-field {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(164 208 106 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(164 208 106 / 0.55);
    pointer-events: none;
  }
  .opt-key {
    position: relative;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    font-family: var(--font-voice);
    font-size: 1.125rem;
    line-height: 1;
    color: var(--color-on-dark-tag);
  }
  .is-chosen .opt-key {
    color: var(--color-accent-400);
  }
  .ink {
    position: absolute;
    inset: -0.25rem;
    width: calc(100% + 0.5rem);
    height: calc(100% + 0.5rem);
    overflow: visible;
    pointer-events: none;
  }
  .ink path {
    fill: none;
    stroke: var(--color-accent-400);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .opt-text {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.0625rem;
  }
  .opt-title {
    font-family: var(--font-voice);
    font-size: 1.0625rem;
    line-height: 1.2;
  }
  .opt-swap {
    display: grid;
  }
  .opt-sub,
  .opt-why {
    grid-area: 1 / 1;
    font-size: 0.75rem;
    line-height: 1.35;
  }
  .opt-sub {
    color: var(--color-on-dark-tag);
    opacity: 0;
  }
  .opt-why {
    color: var(--color-on-dark);
  }
  .is-chosen .opt-why {
    color: var(--color-on-dark-strong);
  }

  /* 4 · Umsetzung */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .step {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .box {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
  }
  .box rect {
    fill: #fff;
    stroke: var(--color-accent-500);
    stroke-width: 1.4;
  }
  .box path {
    fill: none;
    stroke: var(--color-accent-900);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .step-text {
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .step-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent-600);
  }
  .done {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    border-top: 1px solid rgb(42 48 31 / 0.14);
    padding-top: 0.625rem;
  }
  .done-line {
    font-family: var(--font-voice);
    font-size: 1.3125rem;
    line-height: 1.05;
    color: var(--color-accent-900);
  }
  .cost {
    border-radius: 0.5rem;
    padding: 0.25rem 0.5rem;
    background: var(--color-accent-400);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent-900);
  }

  /* Narrow (the 440px column at 1024): the question spans the top and the
     steps the foot, and the sources and the decision keep their two columns
     between them, still wired left to right. The chip sits over its card. */
  @container (max-width: 34rem) {
    .stage {
      grid-template-columns: minmax(0, 1fr) 2.25rem minmax(0, 1.05fr);
      grid-template-areas:
        'q    q q'
        'srcs . dec'
        'impl impl impl';
      grid-template-rows: auto auto auto;
      padding: 0.875rem;
    }
    .node--dec {
      margin-top: 1.75rem;
    }
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3125rem;
    }
    .card {
      align-self: stretch;
    }
  }
</style>
