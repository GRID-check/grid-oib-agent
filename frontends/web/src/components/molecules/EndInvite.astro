---
/**
 * The close of a subpage (a post, the changelog, the Rechenweg): one line
 * written for that page and one button that opens the pilot mail, prefilled.
 * A mail, not a link to /#kontakt: the reader has already made up their mind
 * by the end of the page, and a second page between them and the mail is a
 * step they can leave on. No panel and no print, so the page's own ending
 * stays the last thing it says.
 */
import Pill from '../atoms/Pill.astro'
import { mailtoHref } from '../../consts'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
  page: keyof (typeof ui)['de']['invite']
}
const { locale, page } = Astro.props
const cta = ui[locale].cta
---

<!-- In the page frame (global.css), so the rule starts at the edge every
     subpage heading starts at. -->
<aside aria-label={cta.title} class="frame pb-16 md:pb-20">
  <div class="flex flex-col gap-5 border-t border-ink/15 pt-6 sm:flex-row sm:items-center sm:gap-8">
    <p class="m-0 max-w-xl text-base leading-relaxed text-ink-soft" style="text-wrap: pretty">
      {ui[locale].invite[page]}
    </p>
    <Pill href={mailtoHref(cta.subjectPilot, cta.bodyPilot)} variant="solid" class="shrink-0 self-start sm:self-auto">
      {cta.primary}
    </Pill>
  </div>
</aside>
