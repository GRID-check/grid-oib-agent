---
interface Props {
  idx: string
  title: string
  tone?: 'light' | 'dark' | 'dim'
  class?: string
}
const { idx, title, tone = 'light', class: className = '' } = Astro.props

const tones = {
  light: {
    card: 'bg-white text-ink',
    idx: 'text-accent-500',
    title: 'text-ink',
    body: 'text-ink-soft',
  },
  dark: {
    card: 'border border-surface/15 bg-surface/5 text-surface transition-colors hover:border-surface/35',
    idx: 'text-on-dark-label',
    title: 'text-surface',
    body: 'text-on-dark',
  },
  dim: {
    card: 'bg-surface-dim text-ink',
    idx: 'text-accent-500',
    title: 'text-ink',
    body: 'text-ink-soft',
  },
} as const
const t = tones[tone]
---

<div data-reveal class={`rounded-card p-6 sm:p-7 ${t.card} ${className}`}>
  <p class={`m-0 font-display text-2xs uppercase tracking-widest ${t.idx}`}>{idx}</p>
  <h3 class={`m-0 mt-3 font-display text-lg font-semibold tracking-tight ${t.title}`}>
    {title}
  </h3>
  <p class={`m-0 mt-3 text-sm leading-relaxed ${t.body}`} style="text-wrap: pretty">
    <slot />
  </p>
</div>
