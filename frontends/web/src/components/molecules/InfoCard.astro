---
/**
 * A resolved source in the story's hub diagram: a clause, a guideline, a past
 * project. The primary node, light on the panel; FragCard is the raw fragment
 * beside it, with the same height, padding, radius and edge.
 *
 * `stage` and `tile` as in FragCard: the desktop piece is positioned and
 * flown by scripts/landing.ts (`data-frag`, `data-slot`); the tile sits in the
 * phone diagram's grid, with the value moved under the title so a half-width
 * cell holds it.
 */
interface Props {
  glyph: string
  tile: string
  title: string
  sub: string
  value: string
  variant?: 'stage' | 'tile'
  dx?: number
  dy?: number
  slot?: string
  pos?: Partial<Record<'left' | 'right' | 'top' | 'bottom', number>>
}
const { glyph, tile, title, sub, value, variant = 'stage', dx = 0, dy = 0, slot = '', pos = {} } = Astro.props

const posStyle = Object.entries(pos)
  .map(([k, v]) => `${k}:${(v * 100).toFixed(1)}%`)
  .join(';')
---

{
  variant === 'stage' ? (
    <div
      class="absolute box-border flex h-14 w-64 items-center gap-3 rounded-xl border border-surface bg-surface px-4"
      style={posStyle}
      data-frag={`${dx},${dy}`}
      data-slot={slot}
    >
      <span
        class="inline-flex size-7 shrink-0 items-center justify-center rounded-lg text-xs text-panel"
        style={`background: ${tile}`}
        aria-hidden="true"
      >
        {glyph}
      </span>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-[0.8125rem] font-semibold leading-none tracking-tight text-panel">{title}</span>
        <span class="mt-1.5 block truncate text-2xs leading-none text-ink-mute">{sub}</span>
      </span>
      <span class="shrink-0 font-mono text-xs font-medium text-accent-600">{value}</span>
    </div>
  ) : (
    <div data-hub-node class="relative flex min-w-0 items-start gap-2.5 rounded-xl border border-surface bg-surface p-2.5">
      <span
        class="inline-flex size-7 shrink-0 items-center justify-center rounded-lg text-xs text-panel"
        style={`background: ${tile}`}
        aria-hidden="true"
      >
        {glyph}
      </span>
      <span class="min-w-0">
        <span class="block break-words text-[0.8125rem] font-semibold leading-tight tracking-tight text-panel">
          {title}
        </span>
        <span class="mt-0.5 block text-2xs leading-snug text-ink-mute">{sub}</span>
        <span class="mt-1 block font-mono text-xs font-medium text-accent-600">{value}</span>
      </span>
    </div>
  )
}
