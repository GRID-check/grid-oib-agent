---
interface Props {
  glyph: string
  tile: string
  title: string
  sub: string
  value: string
  dx: number
  dy: number
  fx: number
  fy: number
  pos: Partial<Record<'left' | 'right' | 'top' | 'bottom', number>>
}
const { glyph, tile, title, sub, value, dx, dy, fx, fy, pos } = Astro.props

const posStyle = Object.entries(pos)
  .map(([k, v]) => `${k}:${(v * 100).toFixed(1)}%`)
  .join(';')
---

<div
  class="frag absolute flex items-center gap-3 rounded-xl bg-surface py-[11px] pl-3 pr-4"
  style={posStyle}
  data-frag={`${dx},${dy}`}
  data-target={`${fx},${fy}`}
>
  <span
    class="inline-flex h-[30px] w-[30px] items-center justify-center rounded-[7px] text-[14px]"
    style={`background: ${tile}`}
    aria-hidden="true">{glyph}</span
  >
  <span>
    <span class="block text-[13px] font-semibold tracking-[-0.01em] text-panel">{title}</span>
    <span class="block text-[11.5px] text-[#6f7061]">{sub}</span>
  </span>
  <span class="ml-2 text-[13px] font-semibold text-panel">{value}</span>
</div>

<style>
  .frag {
    box-shadow: 0 18px 40px -22px rgb(0 0 0 / 0.6);
  }
</style>
