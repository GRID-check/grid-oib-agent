---
/**
 * A Journal post as an entry in an editorial index: its riso plate printed on
 * the page (or its uploaded cover), the date, the title in the serif voice,
 * one line, under a hairline. No card, no shadow and no category chip: a card
 * only ever appears inside its own category's listing, where the chip would
 * repeat the heading above it. Build-log posts use LogEntry instead; the two
 * strands are meant to look different.
 */
import { Image } from 'astro:assets'
import type { Locale } from '../../i18n/ui'
import { formatDate, postSlug, type BlogPost } from '../../lib/posts'
import { blogPath } from '../../lib/categories'
import RisoCover from '../blog/RisoCover.astro'

interface Props {
  post: BlogPost
  locale: Locale
  /** Heading level of the title: 2 under a page h1, 3 under a section h2. */
  level?: 2 | 3
}
const { post, locale, level = 3 } = Astro.props
const { title, description, pubDate, cover, plate } = post.data
const Heading = level === 2 ? 'h2' : 'h3'
---

<a
  href={`${blogPath(locale)}${postSlug(post.id)}/`}
  class="group flex flex-col border-t border-ink/15 pt-6 hover:text-inherit"
  data-reveal
>
  {
    plate ? (
      <RisoCover plate={plate} variant="card" />
    ) : cover && (
      <Image
        src={cover}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 560px, (min-width: 768px) 45vw, 100vw"
        class="aspect-[16/9] w-full rounded-sm object-cover"
        loading="lazy"
      />
    )
  }
  <time
    datetime={pubDate.toISOString()}
    class="mt-6 font-mono text-2xs uppercase tracking-label text-ink-mute"
  >
    {formatDate(pubDate, locale)}
  </time>
  <Heading
    class="mt-3 font-voice text-[2rem] leading-[1.08] text-ink transition-colors group-hover:text-accent-600 sm:text-[2.375rem]"
  >
    {title}
  </Heading>
  <p class="mt-3 max-w-measure text-base leading-relaxed text-ink-soft">{description}</p>
</a>
