---
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  title: string
  description: string
  pubDate: Date
  href: string
  locale?: Locale
}
const { title, description, pubDate, href, locale = 'de' } = Astro.props
const date = pubDate.toLocaleDateString(locale === 'en' ? 'en-GB' : 'de-AT', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<a
  href={href}
  class="group block rounded-card bg-white p-7 transition-shadow hover:shadow-lift"
  data-reveal
>
    <p class="font-mono text-2xs uppercase tracking-widest text-accent-600">
    <time datetime={pubDate.toISOString()}>{date}</time>
  </p>
  <h2 class="mt-3 font-display text-xl font-semibold text-ink group-hover:text-accent-600">
    {title}
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-ink-soft">{description}</p>
  <p class="mt-5 text-sm font-medium text-accent-600">{ui[locale].blog.readMore}</p>
</a>
