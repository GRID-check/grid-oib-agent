---
/**
 * A Journal post as an editorial card: cover if the post has one, the category
 * chip and date as a kicker, the title set in the serif voice. Build-log posts
 * use LogEntry instead; the two strands are meant to look different.
 */
import { Image } from 'astro:assets'
import { ui, type Locale } from '../../i18n/ui'
import { formatDate, postSlug, type BlogPost } from '../../lib/posts'
import { blogPath } from '../../lib/categories'
import CategoryChip from '../blog/CategoryChip.astro'

interface Props {
  post: BlogPost
  locale: Locale
  /** Heading level of the title: 2 under a page h1, 3 under a section h2. */
  level?: 2 | 3
}
const { post, locale, level = 3 } = Astro.props
const { title, description, pubDate, cover, category } = post.data
const Heading = level === 2 ? 'h2' : 'h3'
---

<a
  href={`${blogPath(locale)}${postSlug(post.id)}/`}
  class="group flex flex-col overflow-hidden rounded-card bg-white shadow-card ring-1 ring-ink/8 transition-[box-shadow,transform] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-0.5 hover:shadow-lift"
  data-reveal
>
  {
    cover && (
      <Image
        src={cover}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 560px, (min-width: 768px) 45vw, 100vw"
        class="aspect-[16/9] w-full object-cover"
        loading="lazy"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <CategoryChip category={category} locale={locale} />
      <time
        datetime={pubDate.toISOString()}
        class="font-mono text-2xs uppercase tracking-label text-ink-mute"
      >
        {formatDate(pubDate, locale)}
      </time>
    </p>
    <Heading
      class="mt-5 font-voice text-[2rem] leading-[1.08] text-ink transition-colors group-hover:text-accent-600 sm:text-[2.375rem]"
    >
      {title}
    </Heading>
    <p class="mt-3 text-base leading-relaxed text-ink-soft">{description}</p>
    <p class="mt-auto pt-6 text-sm font-medium text-accent-600">{ui[locale].blog.readMore}</p>
  </div>
</a>
