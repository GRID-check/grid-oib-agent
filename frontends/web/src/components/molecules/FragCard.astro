---
/**
 * A raw knowledge fragment in the story's hub diagram: a mono tag over one
 * value, on a dark tile. The secondary node of the diagram; InfoCard is the
 * primary one, and the two share a height, padding, radius and edge so they
 * read as one family.
 *
 * `stage` is the desktop piece: absolutely placed, flown in and pulled into
 * its slot by scripts/landing.ts, which reads `data-frag` (drift-in offset)
 * and `data-slot` (`L0`–`L4`, `R0`–`R4`, `B0`: column and row beside the hub).
 * `tile` is the same fragment as a cell of the phone diagram's grid, in flow.
 *
 * The optional `figure` slot sits at the right edge, where an InfoCard shows
 * its value: the floor plan's thumbnail.
 */
interface Props {
  tag: string
  variant?: 'stage' | 'tile'
  dx?: number
  dy?: number
  slot?: string
  pos?: Partial<Record<'left' | 'right' | 'top' | 'bottom', number>>
}
const { tag, variant = 'stage', dx = 0, dy = 0, slot = '', pos = {} } = Astro.props

const posStyle = Object.entries(pos)
  .map(([k, v]) => `${k}:${(v * 100).toFixed(1)}%`)
  .join(';')
---

{
  variant === 'stage' ? (
    <div
      class="absolute box-border flex h-14 w-52 items-center gap-3 rounded-xl border border-surface/15 bg-ink px-4"
      style={posStyle}
      data-frag={`${dx},${dy}`}
      data-slot={slot}
    >
      <span class="min-w-0 flex-1">
        <span class="block font-mono text-2xs uppercase leading-none tracking-label text-on-dark-label">{tag}</span>
        <span class="mt-2 block truncate font-mono text-xs leading-none text-on-dark-strong">
          <slot />
        </span>
      </span>
      <slot name="figure" />
    </div>
  ) : (
    <div data-hub-node class="relative flex min-w-0 items-center gap-2.5 rounded-xl border border-surface/15 bg-ink px-3 py-2.5">
      <span class="min-w-0 flex-1">
        <span class="block font-mono text-2xs uppercase tracking-wider text-on-dark-label">{tag}</span>
        <span class="mt-1 block break-words font-mono text-xs leading-snug text-on-dark-strong">
          <slot />
        </span>
      </span>
      <slot name="figure" />
    </div>
  )
}
