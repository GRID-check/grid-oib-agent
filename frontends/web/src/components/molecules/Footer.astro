---
import Logo from '../atoms/Logo.astro'
import Pill from '../atoms/Pill.astro'
import { CONTACT_EMAILS, mailtoHref } from '../../consts'
import { ui, type Locale } from '../../i18n/ui'
import { useTranslatedPath } from '../../i18n/utils'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
const translatePath = useTranslatedPath(locale)
const home = translatePath('/')

const year = new Date().getFullYear()
const block = t.footer.block.map((cell) =>
  cell.value === '' ? { ...cell, value: String(year) } : cell
)

const columns = [
  {
    heading: t.footer.productHeading,
    links: [
      { label: t.footer.usage, href: `${home}#nutzung` },
      { label: t.footer.data, href: `${home}#daten` },
      { label: t.footer.value, href: `${home}#wert` },
      { label: t.footer.working, href: translatePath('/rechenweg/') },
    ],
  },
  {
    heading: t.footer.companyHeading,
    links: [
      { label: t.footer.team, href: `${home}#team` },
      { label: t.ki.tag, href: `${home}#datenschutz` },
      { label: t.footer.blog, href: translatePath('/blog/') },
      { label: t.footer.changelog, href: translatePath('/changelog/') },
    ],
  },
  {
    heading: t.footer.legalHeading,
    links: [
      { label: t.footer.privacy, href: translatePath('/datenschutz/') },
      { label: t.footer.imprint, href: translatePath('/impressum/') },
    ],
  },
]
---

<!-- The footer is where a visitor lands who did not convert: it has to say who
     we are, where everything is, and how to reach a person. On a phone it is
     the same sheet folded tighter — link groups side by side, 44px rows — not
     a column of everything stacked. -->
<footer class="px-2 pb-2 pt-4 sm:px-4 sm:pb-8">
  <div
    class="mx-auto box-border max-w-[85rem] rounded-panel bg-surface-dim px-5 py-10 sheet-light sm:px-16 sm:py-16 lg:py-20"
  >
    <div
      class="grid grid-cols-2 gap-x-6 gap-y-8 sm:gap-x-10 sm:gap-y-12 lg:grid-cols-[1.6fr_1fr_1fr_1fr]"
    >
      <div class="col-span-2 max-w-sm lg:col-span-1 lg:max-w-xs">
        <Logo href={`${home}#top`} label={t.nav.logoLabel} size="sm" />
        <p class="m-0 mt-4 text-base leading-relaxed text-ink-soft sm:mt-5 sm:text-sm" style="text-wrap: pretty">
          {t.footer.tagline}
        </p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.heading}>
            <p class="m-0 font-mono text-2xs uppercase tracking-widest text-ink-faint">
              {col.heading}
            </p>
            <ul class="m-0 mt-2 list-none p-0 sm:mt-5 sm:space-y-3">
              {col.links.map((l) => (
                <li>
                  <a
                    class="flex min-h-11 items-center text-base text-ink-soft transition-colors hover:text-accent-600 sm:inline sm:min-h-0 sm:text-sm"
                    href={l.href}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-8 grid grid-cols-1 items-end gap-x-10 gap-y-5 border-t border-ink/12 pt-8 sm:mt-14 sm:pt-10 lg:grid-cols-[1.6fr_3fr]"
    >
      <div>
        <p class="m-0 font-mono text-2xs uppercase tracking-widest text-ink-faint">
          {t.footer.contactHeading}
        </p>
        <p class="m-0 mt-2 max-w-sm text-base leading-relaxed text-ink-mute sm:text-sm">
          {t.footer.contactBody}
        </p>
        <ul class="m-0 mt-2 list-none p-0">
          {
            CONTACT_EMAILS.map((email) => (
              <li>
                <a
                  class="inline-flex min-h-11 items-center font-display text-lg font-semibold tracking-tight text-panel hover:text-accent-600 sm:min-h-0 sm:py-0.5"
                  href={mailtoHref()}
                >
                  {email}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex justify-end max-lg:justify-start">
        <Pill
          href={mailtoHref(t.cta.subjectPilot)}
          variant="solid"
          size="md"
          class="max-sm:w-full max-sm:py-3"
        >
          {t.footer.cta}
        </Pill>
      </div>
    </div>

    <!-- The foot of the sheet states what the sheet is, the way a drawing does
         in the corner where its title block sits. -->
    <div class="mt-8 border-t border-ink/12 pt-6 sm:mt-12">
      <dl class="m-0 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3 lg:grid-cols-5">
        {
          block.map((cell) => (
            <div class="flex min-w-0 items-baseline gap-2.5 last:col-span-2 sm:last:col-span-1">
              <dt class="m-0 shrink-0 font-mono text-2xs uppercase tracking-widest text-ink-ghost">
                {cell.label}
              </dt>
              <dd class="m-0 truncate font-mono text-2xs uppercase tracking-widest text-ink-mute">
                {cell.value}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="m-0 mt-5 text-xs text-ink-faint sm:mt-6 sm:text-2xs">© {year} Piloti</p>
    </div>
  </div>
</footer>
