---
import SectionTag from '../atoms/SectionTag.astro'
import { ui, type Locale } from '../../i18n/ui'
import { legalIdentity } from '../../data/legal'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale].legal
const id = legalIdentity
---

<section class="px-6 pb-28 pt-36 md:px-10">
  <div class="mx-auto max-w-3xl">
    <SectionTag>{t.tag}</SectionTag>
    <h1
      class="mt-6 font-serif text-h2 text-ink"
    >
      {t.impressum.heading}
    </h1>
    <div class="prose-piloti mt-10">
      <h2>{t.impressum.ownerHeading}</h2>
      <p>
        {id.operator}<br />
        {id.legalForm}<br />
        {id.addressLines[0]}<br />
        {id.addressLines[1]}
      </p>
      <p>
        {t.emailLabel}: <a href={`mailto:${id.email}`}>{id.email}</a>
      </p>
      <h2>{t.impressum.purposeHeading}</h2>
      <p>{t.impressum.purpose}</p>
      <h2>{t.impressum.registerHeading}</h2>
      <p>
        {t.impressum.registerNumberLabel}: {id.registerNumber}<br />
        {t.impressum.registerCourtLabel}: {id.registerCourt}<br />
        {t.impressum.uidLabel}: {id.uid}<br />
        {t.impressum.registerNote}
      </p>
      <h2>{t.impressum.liabilityHeading}</h2>
      <p>{t.impressum.liability}</p>
    </div>
  </div>
</section>
