---
import { Image } from 'astro:assets'
import TapedPrint from '../craft/TapedPrint.astro'
import { TRAGWERK } from '../craft/plates'
import { founders } from '../../data/founders'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]

// Each founder is a small print taped to the sheet, in the site's duotone
// (see scripts/build-team-photos.mjs). A founder without a photo is drawn the
// way a drawing set marks a detail instead — a circle split by a rule, the
// initials above it and the number below.
const people = founders.map((f, i) => {
  const words = f.name.split(' ')
  return {
    name: f.name,
    role: f.role[locale],
    photo: f.photo,
    initials: `${words[0][0]}${words[words.length - 1][0]}`,
    no: String(i + 1).padStart(2, '0'),
    // Taped up by hand, so never quite square to each other.
    tilt: [-1.5, 1.2, -0.8][i % 3],
  }
})
---

<section
  id="team"
  data-screen-label={t.sheets.team}
  class="mx-auto box-border max-w-[85rem] overflow-x-clip px-4 py-16 sm:px-10 sm:py-24 lg:px-26"
>
  <!-- Phone: plate, intro, founders. From lg the plate hangs beside the intro
       (three columns, three founders) and the founders run as one row of
       sheets beneath both, their names on one line. -->
  <div class="grid grid-cols-1 items-start gap-y-10 lg:grid-cols-[7fr_5fr] lg:gap-x-16 lg:gap-y-14">
    <TapedPrint
      name={TRAGWERK.II}
      locale={locale}
      size="half"
      phone="third"
      caption={t.plates.drei}
      class="lg:col-start-2 lg:row-start-1 lg:justify-self-end"
    />

    <div data-reveal class="lg:col-start-1 lg:row-start-1">
      <h2 class="m-0 mb-5 font-voice text-v2 text-panel sm:mb-6" style="text-wrap: balance">
        {t.team.title}
      </h2>
      <p class="m-0 max-w-[34rem] text-base leading-relaxed text-ink-soft sm:text-lg" style="text-wrap: pretty">
        {t.team.body}
      </p>
    </div>

    <!-- A list on a phone, three sheets side by side from `sm` up. -->
    <ul
      aria-label={t.team.listLabel}
      class="m-0 grid list-none grid-cols-1 p-0 sm:grid-cols-3 sm:gap-4 lg:col-span-2 lg:gap-5"
    >
      {
        people.map((p) => (
          <li
            data-reveal
            class="flex items-center gap-4 border-t border-ink/12 py-4 last:border-b sm:flex-col sm:items-start sm:gap-6 sm:rounded-card sm:border-0 sm:bg-paper sm:p-6 sm:shadow-card sm:ring-1 sm:ring-ink/8 sm:last:border-b-0 xl:flex-row xl:items-end"
          >
            {p.photo ? (
              <TapedPrint size="photo" rotate={p.tilt} class="mt-2 shrink-0 sm:mt-1">
                <Image
                  src={p.photo}
                  alt={p.name}
                  widths={[96, 104, 192, 208]}
                  sizes="(min-width: 640px) 104px, 96px"
                  class="size-24 object-cover sm:size-26"
                />
              </TapedPrint>
            ) : (
              <span
                class="relative grid size-14 shrink-0 grid-rows-2 place-items-center rounded-full border border-panel/40 bg-paper sm:size-20"
                aria-hidden="true"
              >
                <span class="absolute inset-x-0 top-1/2 h-px bg-panel/40" />
                <span class="self-end pb-0.5 font-voice text-xl leading-none text-panel sm:pb-1 sm:text-3xl">
                  {p.initials}
                </span>
                <span class="self-start pt-1 font-mono text-2xs leading-none text-ink-faint sm:pt-1.5">
                  {p.no}
                </span>
              </span>
            )}
            <div class="min-w-0 sm:mt-auto xl:pb-1">
              <p class="m-0 font-display text-lg font-semibold leading-snug tracking-tight text-panel">
                {p.name}
              </p>
              <p class="m-0 mt-1 text-base leading-snug text-ink-soft sm:text-sm">{p.role}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
