---
import PageHead from '../molecules/PageHead.astro'
import { ui, type Locale } from '../../i18n/ui'
import { legalIdentity as id } from '../../data/legal'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale].legal
---

<section class="frame pb-20 pt-28 sm:pb-28 md:pt-36">
  <PageHead title={t.datenschutz.heading} locale={locale} />
  <div>
    <div class="prose-piloti mt-10">
      <h2>{t.datenschutz.controllerHeading}</h2>
      <p>
        {id.members.join(', ')} ({t.impressum.legalForm}), {id.seat[locale]}<br />
        {t.emailLabel}:{' '}
        {id.emails.map((e, i) => (
          <>
            {i > 0 && ', '}
            <a href={`mailto:${e}`}>{e}</a>
          </>
        ))}
      </p>
      {
        t.datenschutz.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            <p set:html={s.html} />
          </>
        ))
      }
      <p class="text-sm opacity-70">{t.updated}</p>
    </div>
  </div>
</section>
