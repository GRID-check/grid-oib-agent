---
import SectionTag from '../atoms/SectionTag.astro'
import { ui, type Locale } from '../../i18n/ui'
import { legalIdentity as id } from '../../data/legal'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale].legal
---

<section class="px-4 pb-20 pt-28 sm:px-6 sm:pb-28 sm:pt-36 md:px-10">
  <div class="mx-auto max-w-3xl">
    <SectionTag>{t.tag}</SectionTag>
    <h1 class="mt-6 font-voice text-v2 text-ink">{t.datenschutz.heading}</h1>
    <div class="prose-piloti mt-10">
      <h2>{t.datenschutz.controllerHeading}</h2>
      <p>
        {id.members.join(', ')} ({t.impressum.legalForm}), {id.seat[locale]}<br />
        {t.emailLabel}:{' '}
        {id.emails.map((e, i) => (
          <>
            {i > 0 && ', '}
            <a href={`mailto:${e}`}>{e}</a>
          </>
        ))}
      </p>
      {
        t.datenschutz.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            <p set:html={s.html} />
          </>
        ))
      }
      <p class="text-sm opacity-70">{t.updated}</p>
    </div>
  </div>
</section>
