---
import SectionTag from '../atoms/SectionTag.astro'
import { ui, type Locale } from '../../i18n/ui'
import { legalIdentity } from '../../data/legal'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale].legal
const id = legalIdentity
---

<section class="section-shell pb-28 pt-36">
  <div class="mx-auto max-w-3xl">
    <SectionTag>{t.tag}</SectionTag>
    <h1
      class="mt-6 font-display text-h2 text-ink"
    >
      {t.datenschutz.heading}
    </h1>
    <div class="prose-piloti mt-10">
      <h2>{t.datenschutz.controllerHeading}</h2>
      <p>
        {id.operator}, {id.legalForm}, {id.addressLines.join(', ')}. {t.emailLabel}:
        <a href={`mailto:${id.email}`}>{id.email}</a>
      </p>
      <h2>{t.datenschutz.siteHeading}</h2>
      <p set:html={t.datenschutz.siteHtml} />
      <h2>{t.datenschutz.logsHeading}</h2>
      <p set:html={t.datenschutz.logsHtml} />
      <h2>{t.datenschutz.contactHeading}</h2>
      <p set:html={t.datenschutz.contactHtml} />
      <h2>{t.datenschutz.rightsHeading}</h2>
      <p set:html={t.datenschutz.rightsHtml} />
    </div>
  </div>
</section>
