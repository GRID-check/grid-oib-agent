---
import SectionTag from '../atoms/SectionTag.astro'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
---

<!--
  The receipt for the claim the data-foundation panel just made. That panel says
  "Landesbauordnungen und OIB-Richtlinien"; this one names them, because a
  Ziviltechniker stops believing exactly at the unnamed plural.

  Drawn as a legend rather than as cards: a mono label in the margin, the entry
  beside it, one hairline per row — the same figure the drawing set uses for a
  Positionsliste, and the reason it sits on the open sheet between two panels.
-->
<section
  id="abdeckung"
  data-screen-label={t.sheets.abdeckung}
  class="section-shell py-24 sm:py-28"
>
  <div data-reveal class="section-head">
    <SectionTag class="mb-5">{t.abdeckung.tag}</SectionTag>
    <h2 class="m-0 mb-6 font-display text-h2" style="text-wrap: balance">
      {t.abdeckung.title}
    </h2>
    <p class="m-0 text-lg leading-relaxed text-ink-soft" style="text-wrap: pretty">
      {t.abdeckung.lead}
    </p>
  </div>

  <dl class="m-0 border-t border-ink/15 p-0">
    {
      t.abdeckung.groups.map((g) => (
        <div
          data-reveal
          class="grid grid-cols-[9rem_1fr] gap-x-8 border-b border-ink/15 py-8 max-md:grid-cols-1 max-md:gap-y-3 lg:grid-cols-[12rem_1fr] lg:py-9"
        >
          <dt class="font-mono text-2xs uppercase tracking-widest text-ink-faint md:pt-1.5">
            {g.label}
          </dt>
          <dd class="m-0">
            <h3 class="m-0 font-display text-xl font-semibold tracking-tight text-ink">
              {g.title}
            </h3>
            <p
              class="m-0 mt-3 max-w-3xl text-base leading-relaxed text-ink-soft"
              style="text-wrap: pretty"
              set:html={g.body}
            />
          </dd>
        </div>
      ))
    }
  </dl>

  <!-- The list of what is *not* in there earns the list of what is. -->
  <p
    data-reveal
    class="m-0 mt-8 max-w-3xl border-l-2 border-accent-600/40 pl-5 text-sm leading-relaxed text-ink-mute"
    style="text-wrap: pretty"
  >
    {t.abdeckung.note}
  </p>
</section>
