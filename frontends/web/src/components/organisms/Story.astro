---
import FragCard from '../molecules/FragCard.astro'
import InfoCard from '../molecules/InfoCard.astro'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]

// One list of nodes, drawn twice: in two columns wired to the hub card on a
// desktop panel, and as a grid around the hub on a phone. `slot` is where a
// node rests beside the hub (column L/R and row 0–4, or B0 under it), `pos`
// its authored scatter position, `dx/dy` the direction it drifts in from — all
// read by scripts/landing.ts, none by the phone grid.
//
// The left column is building law, the right the project and the office; the
// floor plan hangs under the hub. Light cards are resolved sources, the dark
// tags raw fragments, alternating so each column reads as one rhythm.
//
// Every node is something Piloti can actually hold: a clause, a guideline, a
// document, a web source. The U-value is OIB-RL 6, which is building code.
const frags = [
  { tag: t.story.tags.norm, lines: ['OIB-RL 2', 'Pkt. 3.5'], dx: -30, dy: -24, slot: 'L0', pos: { left: 0.015, top: 0.07 } },
  { tag: t.story.tags.site, lines: ['WIEN 1030'], dx: 44, dy: 12, slot: 'R2', pos: { right: 0.22, bottom: 0.29 } },
  { tag: t.story.tags.document, lines: ['Bauantrag.pdf'], dx: 30, dy: -34, slot: 'R0', pos: { right: 0.015, top: 0.06 } },
  { tag: t.story.tags.detail, lines: ['Sockelanschluss'], dx: 40, dy: 30, slot: 'R4', pos: { right: 0.29, bottom: 0.05 } },
  { tag: t.story.tags.category, lines: ['GK 4'], dx: -40, dy: 10, slot: 'L2', pos: { left: 0.23, bottom: 0.27 } },
  { tag: t.story.tags.web, lines: ['Flächenwidmung ↗'], dx: -46, dy: 26, slot: 'L4', pos: { left: 0.3, bottom: 0.06 } },
]
const plan = { tag: t.story.tags.plan, line: 'EG · 1:100', dx: 8, dy: 40, slot: 'B0', pos: { left: 0.44, bottom: 0.19 } }
const infos = [
  { glyph: '§', tile: '#cfe0a8', title: '§ 106 BO Wien', sub: t.story.infoSubs.fire, value: 'GK 4', dx: -34, dy: -12, slot: 'L1', pos: { left: 0.03, bottom: 0.33 } },
  { glyph: '◷', tile: '#f3e6b8', title: 'OIB-RL 6', sub: t.story.infoSubs.energy, value: 'U 0,20', dx: -28, dy: 30, slot: 'L3', pos: { left: 0.04, bottom: 0.13 } },
  { glyph: '▦', tile: '#e9c4a8', title: 'Volksschule Aspern', sub: t.story.infoSubs.connection, value: '2019', dx: 34, dy: -16, slot: 'R1', pos: { right: 0.025, bottom: 0.34 } },
  { glyph: '▤', tile: '#cdd6e6', title: 'Statik_Nachweis', sub: t.story.infoSubs.construction, value: 'PDF', dx: 28, dy: 34, slot: 'R3', pos: { right: 0.05, bottom: 0.14 } },
]

// The floor plan as a thumbnail in the same line as the wires: walls in the
// panel's light green, one door swing and its hinge in the accent.
const planSvg = `<svg width="40" height="28" viewBox="0 0 40 28" fill="none" class="block shrink-0" aria-hidden="true">
  <rect x="0.5" y="0.5" width="39" height="27" rx="1" stroke="#8fa06a" stroke-width="1"></rect>
  <path d="M23.5 0.5V27.5M23.5 14H39.5M0.5 18.5H13" stroke="#8fa06a" stroke-width="1"></path>
  <path d="M13 18.5A8 8 0 0 1 21 26.5" stroke="#a4d06a" stroke-width="1"></path>
  <rect x="12" y="17.5" width="2" height="2" fill="#a4d06a"></rect>
</svg>`
---

<div data-pin="story" id="problem" data-screen-label={t.sheets.story}>
  <div data-pin-sticky class="mx-auto box-border flex max-w-[85rem] items-center px-2 py-4 sm:px-4 lg:min-h-screen lg:px-10">
    <div
      data-story-panel
      class="relative box-border flex w-full flex-col items-center justify-center overflow-hidden rounded-panel bg-panel px-5 py-14 sheet-dark sm:px-10 sm:py-20 lg:min-h-[calc(100vh-2rem)] lg:px-12 lg:py-24 lg:[background-image:none]"
    >
      <!-- ── Desktop: the pinned, scrubbed story ─────────────────────────────
           The nodes' resting slots are solved at runtime from the measured
           panel (see solveStoryLayout in scripts/landing.ts): two columns
           beside the hub card and one node under it, wired to the card's
           edges. The left/top values here are the scattered beat. -->
      <div data-story-stage class="absolute inset-0 max-lg:hidden" aria-hidden="true">
        <svg
          data-links
          class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"
          aria-hidden="true"></svg>

        {
          frags.map((f) => (
            <FragCard tag={f.tag} dx={f.dx} dy={f.dy} slot={f.slot} pos={f.pos}>
              {f.lines.join(' · ')}
            </FragCard>
          ))
        }
        {infos.map((c) => <InfoCard {...c} />)}
        <FragCard tag={plan.tag} dx={plan.dx} dy={plan.dy} slot={plan.slot} pos={plan.pos}>
          {plan.line}
          <Fragment slot="figure" set:html={planSvg} />
        </FragCard>
      </div>

      <div data-h-problem class="relative z-20 max-w-4xl text-center max-lg:hidden">
        <h2 class="m-0 font-voice text-v3 text-on-dark-strong" style="text-wrap: balance">
          {t.story.problemA}&nbsp;<span class="text-white">{t.story.problemB}</span>
        </h2>
      </div>

      <!-- Placed by the solver above the diagram, never over it: no wire runs
           under the words, so none has to be cut short around them. -->
      <div
        data-h-solution
        class="absolute left-1/2 top-[12%] z-20 w-[min(51rem,100%-6rem)] text-center opacity-0 max-lg:hidden"
      >
        <h2 class="m-0 mx-auto font-voice text-v4 text-on-dark-strong" style="text-wrap: balance">
          {t.story.solution}
        </h2>
      </div>

      <div
        data-solution-card
        class="absolute left-1/2 top-[60%] z-30 box-border w-68 rounded-card bg-surface px-8 py-6 text-center text-panel opacity-0 max-lg:hidden"
      >
        <p class="m-0 font-logo text-base font-medium uppercase leading-none tracking-logo" style="padding-left: 0.2em">Piloti</p>
        <span class="mx-auto my-4 block h-px w-8 bg-accent-600/35" aria-hidden="true"></span>
        <p class="m-0 text-sm leading-relaxed text-accent-600" style="text-wrap: balance">
          {t.story.cardTagline}
        </p>
      </div>

      <!-- ── Phone and tablet: the same statement, read top to bottom ───────
           No pin and no scrub: the problem, the answer, and the hub drawn as
           a grid of the same nodes wired into one card. The wires are laid
           from the measured cells by scripts/landing.ts (initHubGrid). -->
      <div class="w-full lg:hidden">
        <h2 class="m-0 font-voice text-v3 text-on-dark-strong" style="text-wrap: balance">
          {t.story.problemA} <span class="text-white">{t.story.problemB}</span>
        </h2>
        <p class="m-0 mt-5 max-w-xl text-lg leading-relaxed text-on-dark" style="text-wrap: pretty">
          {t.story.solution}
        </p>

        <div data-hub class="relative mx-auto mt-10 max-w-2xl" aria-hidden="true">
          <svg data-hub-links class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"></svg>

          <div class="relative grid grid-cols-2 gap-2 sm:grid-cols-3">
            {
              frags.map((f) => (
                <FragCard variant="tile" tag={f.tag}>
                  {f.lines.join(' · ')}
                </FragCard>
              ))
            }
          </div>

          <div
            data-hub-core
            class="relative mx-auto my-9 max-w-[17rem] rounded-card bg-surface px-6 py-5 text-center text-panel"
          >
            <p class="m-0 font-logo text-base font-medium uppercase leading-none tracking-logo" style="padding-left: 0.2em">Piloti</p>
            <span class="mx-auto my-3.5 block h-px w-8 bg-accent-600/35" aria-hidden="true"></span>
            <p class="m-0 text-sm leading-normal text-accent-600" style="text-wrap: balance">{t.story.cardTagline}</p>
          </div>

          <div class="relative grid grid-cols-2 gap-2 sm:grid-cols-4">
            {infos.map((c) => <InfoCard variant="tile" {...c} />)}
          </div>
          <div class="relative mt-2 flex justify-center">
            <FragCard variant="tile" tag={plan.tag}>
              {plan.line}
              <Fragment slot="figure" set:html={planSvg} />
            </FragCard>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
