---
import SectionTag from '../atoms/SectionTag.astro'
import { getReleases, releaseTitle, sectionTitle } from '../../lib/changelog'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = ui[locale].changelog
const releases = getReleases()
---

<section class="px-6 pb-28 pt-36 md:px-10">
  <div class="mx-auto max-w-4xl">
    <SectionTag>{t.tag}</SectionTag>
    <h1 class="mt-6 max-w-2xl font-display text-h3 text-ink">{t.heading}</h1>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft">{t.intro}</p>

    {
      releases.length === 0 ? (
        <p class="mt-16 rounded-card bg-white p-10 text-center text-base text-ink-soft">
          {t.empty}
        </p>
      ) : (
        <div data-reveal class="mt-14 space-y-12">
          {releases.map((release) => (
            <article class="grid gap-6 border-t border-ink/15 pt-8 md:grid-cols-[11rem_1fr]">
              <header>
                <h2 class="font-mono text-2xs uppercase tracking-widest text-accent-600">
                  {release.date ? (
                    <time datetime={release.date}>
                      {releaseTitle(release, locale, t.unreleased)}
                    </time>
                  ) : (
                    releaseTitle(release, locale, t.unreleased)
                  )}
                </h2>
                {release.kind === 'version' && (
                  <p class="mt-1 text-2xs uppercase tracking-widest text-ink-faint">
                    {t.versionLabel}
                  </p>
                )}
              </header>

              <div>
                {release.summary && (
                  <p class="mb-7 text-base leading-relaxed text-ink">
                    {release.summary[locale]}
                  </p>
                )}
                <div class="space-y-7">
                  {release.sections.map((section) => (
                    <div>
                      <h3 class="font-display text-lg font-semibold text-ink">
                        {sectionTitle(section.key, locale)}
                      </h3>
                      <ul class="mt-3 space-y-3">
                        {section.notes.map((note) => (
                          <li class="flex gap-3 text-sm leading-relaxed text-ink-soft">
                            <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent-600" />
                            <span>{note[locale]}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
