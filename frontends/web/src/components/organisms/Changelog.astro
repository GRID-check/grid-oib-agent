---
import SectionTag from '../atoms/SectionTag.astro'
import ChangelogRelease from '../molecules/ChangelogRelease.astro'
import { getReleases, olderByMonth, OPEN_RELEASES } from '../../lib/changelog'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = ui[locale].changelog
const releases = getReleases()
const open = releases.slice(0, OPEN_RELEASES)
const months = olderByMonth(locale)
const count = (n: number) => (n === 1 ? t.monthCountOne : t.monthCount.replace('{count}', String(n)))
---

<section class="px-6 pb-28 pt-36 md:px-10">
  <div class="mx-auto max-w-4xl">
    <SectionTag>{t.tag}</SectionTag>
    <h1 class="mt-6 max-w-2xl font-voice text-v3 text-ink">{t.heading}</h1>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft">{t.intro}</p>

    {
      releases.length === 0 ? (
        <p class="mt-16 rounded-card bg-white p-10 text-center text-base text-ink-soft">{t.empty}</p>
      ) : (
        <>
          <div data-reveal class="mt-14 space-y-12">
            {open.map((release) => (
              <ChangelogRelease release={release} locale={locale} />
            ))}
          </div>

          {months.length > 0 && (
            <div class="mt-20">
              <h2 class="font-voice text-v4 text-ink">{t.olderHeading}</h2>
              <div class="mt-6 border-b border-ink/15">
                {months.map((month) => (
                  <details id={`m-${month.key}`} class="changelog-month scroll-mt-28 border-t border-ink/15">
                    <summary class="flex min-h-14 cursor-pointer list-none items-baseline justify-between gap-4 py-4">
                      <span class="font-display text-lg font-semibold text-ink">{month.label}</span>
                      <span class="flex items-baseline gap-3 font-mono text-2xs uppercase tracking-widest text-ink-faint">
                        {count(month.releases.length)}
                        <span class="changelog-chevron text-ink-soft" aria-hidden="true">+</span>
                      </span>
                    </summary>
                    <div class="space-y-12 pb-12 pt-2">
                      {month.releases.map((release) => (
                        <ChangelogRelease release={release} locale={locale} headingAs="h3" />
                      ))}
                    </div>
                  </details>
                ))}
              </div>
            </div>
          )}
        </>
      )
    }
  </div>
</section>

<style>
  .changelog-month summary::-webkit-details-marker {
    display: none;
  }
  .changelog-month[open] .changelog-chevron {
    transform: rotate(45deg);
  }
  .changelog-chevron {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .changelog-month summary:focus-visible {
    outline: 2px solid var(--color-accent-500);
    outline-offset: 2px;
  }
</style>

<script>
  // A link to a release in a folded month (#r-2026-08-27) opens that month
  // first, or the browser scrolls to a heading it cannot show.
  const reveal = () => {
    const id = decodeURIComponent(window.location.hash.slice(1))
    const target = id ? document.getElementById(id) : null
    const month = target?.closest('details')
    if (!target || !month || month.open) return
    month.open = true
    target.scrollIntoView()
  }
  reveal()
  window.addEventListener('hashchange', reveal)
</script>
