---
import Pill from '../atoms/Pill.astro'
import PagePrint from '../craft/PagePrint.astro'
import { PLATES } from '../craft/plates'
import { mailtoHref } from '../../consts'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
---

<section
  id="kontakt"
  data-screen-label={t.sheets.kontakt}
  class="relative isolate mx-auto box-border max-w-[85rem] overflow-x-clip px-4 pb-16 pt-12 sm:px-10 sm:pb-20 sm:pt-20 lg:px-26 lg:grid lg:min-h-[72vh] lg:grid-cols-[1fr_auto] lg:items-center lg:gap-x-16"
>
  <!-- The page ends on open ground rather than another panel, so the close gets
       one soft light and a closing mark instead of a frame. -->
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[34rem] w-[58rem] max-w-full -translate-x-1/2 -translate-y-[58%] rounded-full opacity-70 blur-3xl"
    style="background: radial-gradient(ellipse at center, rgb(164 208 106 / 0.20), rgb(164 208 106 / 0.06) 45%, transparent 72%)"
    aria-hidden="true"
  >
  </div>
  <span
    class="mx-auto mb-7 block h-10 w-px bg-gradient-to-b from-transparent to-ink/25 max-sm:hidden lg:hidden"
    aria-hidden="true"></span>

  <!-- Plate VIII, the open door, is the close's one object: on a phone a small
       print above the invitation, from lg the picture beside it. Its ink pass
       is the section's moment, so nothing else here moves. -->
  <PagePrint
    name={PLATES.VIII}
    locale={locale}
    size="half"
    phone="third"
    align="center"
    class="mb-9 sm:mb-11 lg:col-start-2 lg:row-start-1 lg:mb-0"
  />

  <div class="min-w-0 lg:col-start-1 lg:row-start-1">
    <div data-reveal class="text-center lg:text-left">
      <h2 class="m-0 mb-5 font-voice text-v1 text-ink" style="text-wrap: balance">
        {t.cta.title}
      </h2>
      <p
        class="m-0 mx-auto max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg lg:mx-0"
        style="text-wrap: pretty"
      >
        {t.cta.body}
      </p>
    </div>

    <!-- What happens after the click, said where the click is: the question
         that otherwise waits in the FAQ above. -->
    <ol
      aria-label={t.cta.stepsLabel}
      class="m-0 mx-auto mt-9 grid max-w-xl list-none gap-5 p-0 text-left sm:mt-10 sm:grid-cols-3 sm:gap-6 lg:mx-0"
    >
      {
        t.cta.steps.map((s, i) => (
          <li class="border-t border-ink/15 pt-3">
            <span class="font-mono text-2xs text-accent-600">{`0${i + 1}`}</span>
            <p class="m-0 mt-1.5 text-sm font-semibold text-ink">{s.title}</p>
            <p class="m-0 mt-1 text-sm leading-relaxed text-ink-mute" style="text-wrap: pretty">
              {s.body}
            </p>
          </li>
        ))
      }
    </ol>

    <div
      data-reveal
      class="mx-auto mt-9 flex w-full max-w-3xl flex-col gap-3 sm:mt-11 sm:flex-row sm:justify-center sm:gap-3.5 lg:mx-0 lg:justify-start"
    >
      <Pill href={mailtoHref(t.cta.subjectPilot, t.cta.bodyPilot)} variant="solid" size="lg" class="max-sm:w-full">
        {t.cta.primary}
      </Pill>
      <Pill href={mailtoHref(t.cta.subjectCall, t.cta.bodyCall)} variant="outline-dark" size="lg" class="max-sm:w-full">
        {t.cta.secondary}
      </Pill>
    </div>
  </div>
</section>
