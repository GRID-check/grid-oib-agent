---
import Pill from '../atoms/Pill.astro'
import { CONTACT_EMAIL } from '../../consts'

const chips = ['Effizienz steigern', 'Planungsfehler vermeiden', 'Mehr Zeit für Kreatives']
---

<section
  id="kontakt"
  data-screen-label="08 CTA"
  class="mx-auto box-border flex min-h-[85vh] max-w-[1280px] flex-col justify-center px-12 py-[120px] text-center"
>
  <h2
    data-reveal
    class="mx-auto mb-[30px] max-w-[900px] font-display text-[clamp(40px,5.5vw,72px)] font-bold leading-[1.03] tracking-[-0.025em]"
    style="text-wrap: balance"
  >
    Bringen Sie Intelligenz in jede Planungs&shy;entscheidung.
  </h2>
  <div data-reveal class="mb-11 flex flex-wrap justify-center gap-2.5">
    {
      chips.map((c) => (
        <span class="rounded-full border border-accent-600/40 px-4 py-2 font-display text-xs uppercase tracking-[0.1em] text-accent-600">
          {c}
        </span>
      ))
    }
  </div>
  <div data-reveal class="flex justify-center gap-3.5 max-sm:flex-col max-sm:items-center">
    <Pill href={`mailto:${CONTACT_EMAIL}?subject=Demo-Anfrage`} variant="solid" size="lg">
      Demo anfragen
    </Pill>
    <Pill href={`mailto:${CONTACT_EMAIL}?subject=Warteliste`} variant="outline-dark" size="lg">
      Auf die Warteliste
    </Pill>
  </div>
</section>
