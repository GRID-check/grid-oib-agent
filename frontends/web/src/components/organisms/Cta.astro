---
import ContactForm from '../molecules/ContactForm.astro'
import PagePrint from '../craft/PagePrint.astro'
import { PLATES } from '../craft/plates'
import { ui, type Locale } from '../../i18n/ui'
import { useTranslatedPath } from '../../i18n/utils'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
const home = useTranslatedPath(locale)('/')
---

<section
  id="kontakt"
  data-screen-label={t.sheets.kontakt}
  class="frame section-y lg:grid lg:grid-cols-[1fr_auto] lg:items-center lg:gap-x-16"
>
  <div class="min-w-0 lg:col-start-1 lg:row-start-1">
    <div data-reveal>
      <h2 class="m-0 mb-5 font-voice text-v1 text-ink" style="text-wrap: balance">
        {t.cta.title}
      </h2>
      <p
        class="m-0 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg"
        style="text-wrap: pretty"
      >
        {t.cta.body}
      </p>
    </div>

    <!-- What happens after the click, said where the click is: the question
         that otherwise waits in the FAQ above. -->
    <ol
      aria-label={t.cta.stepsLabel}
      class="m-0 mt-9 grid max-w-xl list-none gap-5 p-0 sm:mt-10 sm:grid-cols-3 sm:gap-6"
    >
      {
        t.cta.steps.map((s, i) => (
          <li class="border-t border-ink/15 pt-3">
            <span class="font-mono text-2xs text-accent-600">{`0${i + 1}`}</span>
            <p class="m-0 mt-1.5 text-sm font-semibold text-ink">{s.title}</p>
            <p class="m-0 mt-1 text-sm leading-relaxed text-ink-mute" style="text-wrap: pretty">
              {s.body}
            </p>
          </li>
        ))
      }
    </ol>

    <!-- The first step, taken here: the form sends the question, and the
         address under it takes one with documents attached. -->
    <div class="mt-10 sm:mt-12">
      <ContactForm locale={locale} page={`${home}#kontakt`} />
    </div>
  </div>

  <!-- Plate VIII, the open door, is the close's one object: after the
       invitation on a phone, the picture beside it from lg. The print bleeds
       off its right edge by design, so that edge meets the edge of the screen
       (the content edge plus the gutter, and half of what the frame leaves),
       rather than stopping at an invisible line mid-page. Its ink pass is the
       section's moment, so nothing else here moves. -->
  <PagePrint
    name={PLATES.VIII}
    locale={locale}
    size="half"
    phone="third"
    align="end"
    class="-mr-4 mt-12 sm:-mr-10 sm:mt-14 lg:relative lg:col-start-2 lg:row-start-1 lg:mr-0 lg:mt-0 lg:left-[calc((100vw-min(100vw,85rem))/2+6.5rem)]"
  />
</section>
