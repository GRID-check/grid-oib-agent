---
import ChatMock from '../molecules/ChatMock.astro'
import ChainStories from '../molecules/ChainStories.astro'
import PagePrint from '../craft/PagePrint.astro'
import { PLATES } from '../craft/plates'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
---

<section
  id="nutzung"
  aria-labelledby="nutzung-title"
  data-screen-label={t.sheets.nutzung}
  class="frame section-y lg:frame-panel"
>
  <!-- The sheet from lg only. Below it the stories are the section's picture,
       and a panel around them left a thin beige frame about the phone. -->
  <div class="lg:rounded-panel lg:bg-surface-dim lg:sheet-light lg:panel-pad">
    <div class="grid grid-cols-1 items-center gap-x-14 gap-y-10 lg:grid-cols-[minmax(20rem,5fr)_7fr]">
      <div data-reveal>
        <h2 id="nutzung-title" class="m-0 mb-5 font-voice text-v4 sm:mb-6" style="text-wrap: balance">
          {t.nutzung.title}
        </h2>
        <p class="m-0 mb-8 text-base leading-relaxed text-ink-soft" style="text-wrap: pretty">
          {`${t.nutzung.body} ${t.nutzung.howLead} `}<a
            href={t.nutzung.howHref} class="text-accent-600 underline underline-offset-2 hover:text-accent-700"
            >{t.nutzung.howLabel}&nbsp;→</a
          >
        </p>
        <!-- The one hard claim on the page, given the weight of one — and
             measured: the median answer takes about thirty seconds. -->
        <div class="flex items-baseline gap-5 border-t border-ink/15 pt-6 sm:block sm:pt-7">
          <p class="m-0 shrink-0 font-voice text-v2 whitespace-nowrap text-accent-900">{t.nutzung.big}</p>
          <p class="m-0 max-w-sm text-sm leading-relaxed text-ink-mute sm:mt-2">
            {t.nutzung.sub}
          </p>
        </div>
        <!-- Plate VI, the drafting table the answers arrive on, closing the
             column beside the chain rather than sitting on its heading as a
             badge. From lg only: on a phone the stories are the picture, and a
             print would push them a screen down. Still, because the chain is
             the moment. -->
        <PagePrint name={PLATES.VI} locale={locale} size="half" still class="mt-12 max-lg:hidden" />
      </div>
      <!-- Below lg the chain is told as stories; from lg the same frames are
           laid down one spine (ChatMock). -->
      <div class="max-lg:hidden"><ChatMock locale={locale} /></div>
      <ChainStories locale={locale} />
    </div>
  </div>
</section>
