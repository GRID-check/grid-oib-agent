---
import SectionTag from '../atoms/SectionTag.astro'
import ChatMock from '../molecules/ChatMock.astro'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
---

<section
  id="nutzung"
  data-screen-label={t.sheets.nutzung}
  class="mx-auto box-border flex min-h-screen max-w-[85rem] flex-col justify-center px-4 py-24 sm:px-10"
>
  <div class="box-border rounded-panel bg-surface-dim px-6 py-16 sheet-light sm:px-16 sm:py-18">
    <div class="grid grid-cols-[minmax(20rem,5fr)_7fr] items-center gap-x-14 gap-y-12 max-lg:grid-cols-1">
      <div data-reveal>
        <SectionTag class="mb-5">{t.nutzung.tag}</SectionTag>
        <h2 class="m-0 mb-6 font-display text-h4" style="text-wrap: balance">
          {t.nutzung.title}
        </h2>
        <p class="m-0 mb-8 text-base leading-relaxed text-ink-soft" style="text-wrap: pretty">
          {t.nutzung.body}
        </p>
        <!-- The one hard claim on the page — given the weight of one. -->
        <div class="border-t border-ink/15 pt-7">
          <p class="m-0 font-display text-h4 text-accent-900">{t.nutzung.big}</p>
          <p class="m-0 mt-2 max-w-sm text-sm leading-relaxed text-ink-mute">
            {t.nutzung.sub}
          </p>
        </div>
      </div>
      <ChatMock locale={locale} />
    </div>
  </div>
</section>
