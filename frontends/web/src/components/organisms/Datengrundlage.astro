---
import SectionTag from '../atoms/SectionTag.astro'
import FeatureCard from '../molecules/FeatureCard.astro'

const cards = [
  { idx: '01', title: 'Regelwerke', body: 'Landesbauordnungen, OIB-Richtlinien' },
  { idx: '02', title: 'Ihr Büro', body: 'Pläne und Erfahrung aus vergangenen Projekten' },
  { idx: '03', title: 'Ihr Projekt', body: 'Standortresearch, Grundstück, Auflagen' },
  { idx: '04', title: 'Fachdaten', body: 'Materialkennwerte, CO₂-Bilanzen' },
]
---

<section
  id="daten"
  data-screen-label="05 Datengrundlage"
  class="mx-auto box-border flex min-h-screen max-w-[1360px] flex-col justify-center px-10 py-24"
>
  <div class="box-border rounded-[28px] bg-accent-900 px-16 py-20 text-surface">
    <div data-reveal class="mb-16 max-w-[760px]">
      <SectionTag tone="dark" class="mb-[22px]">Datengrundlage</SectionTag>
      <h2
        class="m-0 mb-6 font-display text-[clamp(32px,4vw,50px)] font-bold leading-[1.08] tracking-[-0.02em] text-surface"
        style="text-wrap: balance"
      >
        Intelligente Planung auf solider Datenbasis.
      </h2>
      <p class="m-0 text-lg leading-[1.6] text-on-dark" style="text-wrap: pretty">
        Piloti stützt sich auf gepflegte, aktuelle Wissensquellen — von Landesbauordnungen und
        OIB-Richtlinien bis zu Materialdaten und CO₂-Werten. Jede Aussage lässt sich bis zu ihrem
        Ursprung zurückverfolgen.
      </p>
    </div>
    <div class="grid grid-cols-4 gap-3.5 max-lg:grid-cols-2 max-md:grid-cols-1">
      {
        cards.map((c) => (
          <FeatureCard idx={c.idx} title={c.title} tone="dark" class="p-[28px_26px]">
            {c.body}
          </FeatureCard>
        ))
      }
    </div>
  </div>
</section>
