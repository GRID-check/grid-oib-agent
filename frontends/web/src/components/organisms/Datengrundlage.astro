---
import SectionTag from '../atoms/SectionTag.astro'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
---

<section
  id="daten"
  data-screen-label={t.sheets.daten}
  class="mx-auto box-border flex min-h-screen max-w-[85rem] flex-col justify-center px-4 py-24 sm:px-10"
>
  <div class="box-border rounded-panel bg-accent-900 px-6 py-16 text-surface sheet-dark sm:px-16 sm:py-20">
    <div data-reveal class="mb-12 max-w-3xl sm:mb-16">
      <SectionTag no="04" tone="dark" class="mb-5">{t.daten.tag}</SectionTag>
      <h2 class="m-0 mb-6 font-voice text-v2 text-surface" style="text-wrap: balance">
        {t.daten.title}
      </h2>
      <p class="m-0 text-lg leading-relaxed text-on-dark" style="text-wrap: pretty">
        {t.daten.body}
      </p>
    </div>

    <!-- A drawing legend, not a card row: one spine, a tick per source, columns
         divided by hairlines. Deliberately the same figure as the story's net —
         these four sources are the fragments it wires together. -->
    <div data-reveal class="border-t border-surface/25 pt-0">
      <ol class="m-0 grid list-none grid-cols-4 gap-px bg-surface/15 p-0 max-lg:grid-cols-2 max-sm:grid-cols-1">
        {
          t.daten.cards.map((c, i) => (
            <li class="group relative bg-accent-900 pb-2 pt-7 transition-colors hover:bg-accent-800 sm:px-6">
              <span
                class="absolute left-0 top-0 h-4 w-px bg-surface/40 transition-[height] duration-500 group-hover:h-7 sm:left-6"
                aria-hidden="true"
              />
              <p class="m-0 font-mono text-2xs uppercase tracking-widest text-on-dark-label">
                {`0${i + 1}`}
              </p>
              <h3 class="m-0 mt-3 font-display text-lg font-semibold tracking-tight text-surface">
                {c.title}
              </h3>
              <p class="m-0 mt-2 pb-6 text-sm leading-relaxed text-on-dark" style="text-wrap: pretty">
                {c.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
