---
import SectionTag from '../atoms/SectionTag.astro'
import FeatureCard from '../molecules/FeatureCard.astro'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
---

<section
  id="daten"
  data-screen-label="05 Datengrundlage"
  class="mx-auto box-border flex min-h-screen max-w-[85rem] flex-col justify-center px-4 py-24 sm:px-10"
>
  <div class="box-border rounded-panel bg-accent-900 px-6 py-14 text-surface sm:px-16 sm:py-20">
    <div data-reveal class="mb-12 max-w-3xl sm:mb-16">
      <SectionTag tone="dark" class="mb-5">{t.daten.tag}</SectionTag>
      <h2 class="m-0 mb-6 font-display text-h2 text-surface" style="text-wrap: balance">
        {t.daten.title}
      </h2>
      <p class="m-0 text-lg leading-relaxed text-on-dark" style="text-wrap: pretty">
        {t.daten.body}
      </p>
    </div>
    <div class="grid grid-cols-4 gap-3.5 max-lg:grid-cols-2 max-md:grid-cols-1">
      {
        t.daten.cards.map((c, i) => (
          <FeatureCard idx={`0${i + 1}`} title={c.title} tone="dark">
            {c.body}
          </FeatureCard>
        ))
      }
    </div>
  </div>
</section>
