---
import { Image } from 'astro:assets'
import Pill from '../atoms/Pill.astro'
import hero from '../../assets/hero.png'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
---

<div data-hero-wrap class="relative h-svh lg:h-screen">
  <header
    id="top"
    data-screen-label={t.sheets.hero}
    data-hero
    class="sticky top-0 box-border flex h-svh flex-col items-center justify-end overflow-hidden bg-hero-bg px-4 pb-14 pt-24 sm:px-12 sm:pb-24 lg:h-screen lg:pb-28"
  >
    <Image
      src={hero}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      class="hero-photo pointer-events-none absolute inset-0 h-full w-full object-cover object-center"
    />
    <canvas
      data-aura
      class="pointer-events-none absolute inset-0 h-full w-full"
      aria-hidden="true"></canvas>
    <!-- The photograph does not stop, it settles: one blur, masked to come in
         gradually towards the foot of the hero, so the focus ramps out rather
         than ending on a hard edge; the tint over it carries the same fall so
         the headline keeps its contrast. It was four stacked blurs (2, 5, 11
         and 20px), which looked a shade smoother and re-blurred the animated
         aura four times on every frame. Idle hero at 1440x900, headless
         Chromium, median frame: four blurs 83ms, one blur 33ms, no blur
         16.7ms. Clipping the aura out of the band does not help (Chromium
         re-blurs on every frame the canvas draws); a pre-blurred crop of the
         photograph would take the rest. -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-[42%] backdrop-blur-[12px]"
      style="-webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgb(0 0 0 / 0.25) 30%, rgb(0 0 0 / 0.7) 62%, #000 88%); mask-image: linear-gradient(to bottom, transparent 0%, rgb(0 0 0 / 0.25) 30%, rgb(0 0 0 / 0.7) 62%, #000 88%)"
      aria-hidden="true"
    >
    </div>

    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(180deg, rgb(232 229 221 / 0) 0%, rgb(232 229 221 / 0) 62%, rgb(234 231 223 / 0.38) 78%, rgb(237 235 227 / 0.82) 90%, rgb(240 238 231 / 0.96) 100%)"
      aria-hidden="true"
    >
    </div>

    <!-- One lockup, in flow.
         The headline used to sit in the flex column on a `min(52vh, 100vh-330px)`
         top margin while the sentence and buttons were absolutely positioned off
         the bottom edge — two independent systems whose spacing only happened to
         clear on a tall window. Under about 900px of height they overlapped, and
         the headline printed straight through the sentence. Stacking them makes
         the gap a property of the layout instead of an arithmetic coincidence. -->
    <div class="relative flex w-full flex-col items-center gap-5 sm:gap-7">
      <h1
        data-hero-title
        class="m-0 max-w-5xl text-center font-voice text-v-display text-ink"
        style="text-wrap: balance"
      >
        {t.hero.title}
      </h1>

      <div data-hero-cta class="flex w-full flex-col items-center gap-6">
        <p
          class="m-0 max-w-md text-center text-base leading-relaxed text-ink-mid"
          style="text-wrap: pretty"
        >
          {t.hero.sub}
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <Pill href="#kontakt" variant="solid" size="md">{t.hero.ctaDemo}</Pill>
          <Pill href="#problem" variant="outline" size="md">{t.hero.ctaMore}</Pill>
        </div>
      </div>
    </div>
    <!-- No scroll hint. The pulsing hairline here said nothing a reader did
         not know, and it kept the page moving after they had stopped. -->
  </header>
</div>

<style>
  /*
   * The size has to be stated here, not in a utility class.
   *
   * astro:assets ships `:where([data-astro-image]) { height: auto }` in its own
   * cascade layer, and layer order outranks specificity: that rule beat
   * `h-full`, so the photograph was laid out at its own aspect ratio and simply
   * stopped partway down the hero — the hard line across the page. A scoped
   * rule here is unlayered, which is what it takes to win.
   *
   * The photograph then fades out before the frame does, so its own edge never
   * becomes a line again.
   */
  .hero-photo {
    height: 100%;
    width: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 62%, rgb(0 0 0 / 0.35) 88%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 62%, rgb(0 0 0 / 0.35) 88%, transparent 100%);
  }
</style>
