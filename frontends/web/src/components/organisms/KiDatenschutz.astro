---
import SectionTag from '../atoms/SectionTag.astro'
import FeatureCard from '../molecules/FeatureCard.astro'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
---

<section
  id="ki"
  data-screen-label="06 KI und Datenschutz"
  class="mx-auto box-border max-w-[85rem] px-4 py-24 sm:px-10"
>
  <div class="box-border rounded-panel bg-tint px-6 py-14 sm:px-16 sm:py-20">
    <div id="datenschutz" data-reveal class="mb-10 max-w-4xl sm:mb-14">
      <SectionTag class="mb-5 text-accent-900/80">{t.ki.tag}</SectionTag>
      <h2 class="m-0 font-display text-h3 text-panel" style="text-wrap: balance">
        {t.ki.title}
      </h2>
    </div>
    <div class="grid grid-cols-3 gap-3.5 max-lg:grid-cols-1">
      {
        t.ki.cards.map((c, i) => (
          <FeatureCard idx={`0${i + 1}`} title={c.title} tone="dim" class="sm:p-9">
            {c.body}
          </FeatureCard>
        ))
      }
    </div>
  </div>
</section>
