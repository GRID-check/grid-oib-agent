---
import SectionTag from '../atoms/SectionTag.astro'
import AppMock from '../molecules/AppMock.astro'
import { ui, type Locale } from '../../i18n/ui'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
---

<section
  id="ki"
  data-screen-label={t.sheets.ki}
  class="mx-auto box-border max-w-[85rem] px-4 py-24 sm:px-10"
>
  <div class="box-border rounded-panel bg-tint px-6 py-16 sheet-light sm:px-16 sm:py-20">
    <!-- The claim and its three supports on the left; the product answering on
         the right. This section's case is that everything here can be checked,
         and it was the one section on the page with nothing to check — a turn
         from the app, with its markers and its sources, argues it better than
         another paragraph would. -->
    <div class="grid grid-cols-[5fr_7fr] items-start gap-x-14 gap-y-12 max-lg:grid-cols-1">
      <div id="datenschutz" data-reveal>
        <SectionTag no="05" class="mb-5 text-accent-900/80">{t.ki.tag}</SectionTag>
        <h2 class="m-0 mb-9 font-voice text-v4 text-panel" style="text-wrap: balance">
          {t.ki.title}
        </h2>

        <ol class="m-0 list-none p-0">
          {
            t.ki.cards.map((c, i) => (
              <li class="grid grid-cols-[auto_1fr] gap-x-4 border-t border-panel/15 py-5 first:border-t-0 first:pt-0 last:pb-0 sm:gap-x-5">
                <span class="mt-0.5 font-mono text-2xs uppercase tracking-widest text-accent-600">
                  {`0${i + 1}`}
                </span>
                <div>
                  <h3 class="m-0 font-display text-base font-semibold tracking-tight text-panel">
                    {c.title}
                  </h3>
                  <p
                    class="m-0 mt-1.5 text-sm leading-relaxed text-accent-900/75"
                    style="text-wrap: pretty"
                  >
                    {c.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div data-reveal class="min-w-0">
        <AppMock locale={locale} />
      </div>
    </div>
  </div>
</section>
