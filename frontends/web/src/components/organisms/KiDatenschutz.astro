---
import SectionTag from '../atoms/SectionTag.astro'
import FeatureCard from '../molecules/FeatureCard.astro'

const cards = [
  {
    idx: '01',
    title: 'Spezialisiert auf Architektur',
    body: 'Piloti basiert auf einer branchenspezifisch entwickelten KI-Infrastruktur. Es kennt Landesbauordnungen und OIB-Richtlinien, versteht Bauteile, Konstruktionen und Typologien — und bezieht den konkreten Kontext Ihres Projekts mit ein.',
  },
  {
    idx: '02',
    title: 'Nachvollziehbar bis zur Quelle',
    body: 'Zu jeder Empfehlung sehen Sie Begründung, Annahmen und Regeln — und jeder Verweis führt zurück zum Ursprung: zum Paragrafen der Landesbauordnung, zum OIB-Punkt, zum Materialdatenblatt oder zu Ihrem eigenen Projekt.',
  },
  {
    idx: '03',
    title: 'Ihre Daten, Ihre Kontrolle',
    body: 'Pläne und Projekte gehören Ihrem Büro — wir trainieren keine KI-Modelle mit Ihren Daten. Cloud und KI laufen in der EU nach DSGVO, und Ihre Daten sind jederzeit exportierbar.',
  },
]
---

<section
  id="ki"
  data-screen-label="06 KI und Datenschutz"
  class="mx-auto box-border max-w-[1360px] px-10 py-24"
>
  <div class="box-border rounded-[28px] bg-tint px-16 py-20">
    <div id="datenschutz" data-reveal class="mb-14 max-w-[840px]">
      <SectionTag class="mb-[22px] text-accent-900/80">Daten &amp; Transparenz</SectionTag>
      <h2
        class="m-0 font-display text-[clamp(30px,3.6vw,46px)] font-bold leading-[1.1] tracking-[-0.018em] text-panel"
        style="text-wrap: balance"
      >
        Keine Blackbox. Piloti macht KI und Daten nachvollziehbar — die Verantwortung bleibt bei
        Ihnen.
      </h2>
    </div>
    <div class="grid grid-cols-3 gap-3.5 max-lg:grid-cols-1">
      {
        cards.map((c) => (
          <FeatureCard idx={c.idx} title={c.title} tone="dim" class="p-[38px_32px]">
            {c.body}
          </FeatureCard>
        ))
      }
    </div>
  </div>
</section>
