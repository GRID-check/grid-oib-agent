---
import SectionTag from '../atoms/SectionTag.astro'
import { ui, type Locale } from '../../i18n/ui'
import { useTranslatedPath } from '../../i18n/utils'

interface Props {
  locale?: Locale
}
const { locale = 'de' } = Astro.props
const t = ui[locale]
const p = t.ki.proof
const privacy = useTranslatedPath(locale)('/datenschutz/')
---

<section
  id="ki"
  data-screen-label={t.sheets.ki}
  class="mx-auto box-border max-w-[85rem] px-2 py-9 sm:px-4 sm:py-12 lg:px-10 lg:py-24"
>
  <div
    class="box-border rounded-[1.5rem] bg-tint px-3 pb-3 pt-12 sheet-light sm:rounded-panel sm:px-10 sm:pb-10 sm:pt-16 lg:px-16 lg:py-20"
  >
    <!-- The claim and its three supports on the left; on the right, the sheet
         you would check them against. A section arguing that nothing here is a
         black box should hand over something to hold it to, and a specification
         reads as a commitment in a way that a fourth paragraph does not.

         Source order is the phone's reading order — claim, sheet, supports —
         because on a phone the sheet is the scannable part. The grid puts the
         sheet back in the right-hand column from lg. -->
    <div class="grid grid-cols-1 items-start gap-x-14 gap-y-8 lg:grid-cols-[6fr_5fr] lg:gap-y-10">
      <div id="datenschutz" data-reveal class="px-2 sm:px-0 lg:col-start-1 lg:row-start-1">
        <SectionTag no="05" class="mb-5 text-accent-900/80">{t.ki.tag}</SectionTag>
        <h2 class="m-0 font-voice text-v4 text-panel" style="text-wrap: balance">
          {t.ki.title}
        </h2>
      </div>

      <div data-reveal class="min-w-0 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <div class="box-border rounded-[1.25rem] bg-paper px-5 py-6 shadow-card ring-1 ring-panel/10 sm:px-7 sm:py-7">
          <p class="m-0 mb-5 border-b border-ink/12 pb-4 font-mono text-2xs uppercase tracking-label text-accent-600">
            {p.tag}
          </p>

          <!-- Two textures on one sheet: what is always attached to an answer,
               ticked; and what is true of the office's data, stated. -->
          <p class="m-0 font-mono text-2xs uppercase tracking-widest text-ink-faint">
            {p.answerHeading}
          </p>
          <ul class="pruef-ticks m-0 mt-3 list-none p-0" data-craft-in>
            {
              p.answer.map((row, i) => (
                <li style={`--i: ${i}`} class="grid grid-cols-[auto_1fr] items-baseline gap-x-3 border-t border-ink/10 py-2.5 first:border-t-0 first:pt-0">
                  <svg
                    viewBox="0 0 24 24"
                    class="size-3 translate-y-px text-accent-600"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m4 12 6 6L20 6" pathLength="1" />
                  </svg>
                  <p class="m-0 text-[0.9375rem] leading-snug text-panel sm:text-sm">
                    {row.label}
                    <span class="text-ink-mute"> — {row.value}</span>
                  </p>
                </li>
              ))
            }
          </ul>

          <p class="m-0 mt-7 font-mono text-2xs uppercase tracking-widest text-ink-faint">
            {p.dataHeading}
          </p>
          <dl class="m-0 mt-3">
            {
              p.data.map((row) => (
                <div class="border-t border-ink/10 py-2.5 first:border-t-0 first:pt-0 sm:grid sm:grid-cols-[9.5rem_1fr] sm:gap-x-4">
                  <dt class="m-0 font-mono text-2xs uppercase leading-5 tracking-wider text-ink-faint sm:text-ink-soft">
                    {row.label}
                  </dt>
                  <dd class="m-0 mt-0.5 text-[0.9375rem] leading-snug text-panel sm:mt-0 sm:text-sm">{row.value}</dd>
                </div>
              ))
            }
          </dl>

          <!-- The rule belongs to the sheet, not to the link, or it stops where
               the words do and reads as an underline. -->
          <div class="mt-5 border-t border-ink/10 pt-2">
            <a
              href={privacy}
              class="inline-flex min-h-11 items-center gap-1.5 text-sm text-accent-600 transition-colors hover:text-accent-700"
            >
              {p.link}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      <ol data-reveal class="m-0 list-none px-2 pb-6 sm:px-0 sm:pb-0 lg:col-start-1 lg:row-start-2">
        {
          t.ki.cards.map((c, i) => (
            <li class="grid grid-cols-[auto_1fr] gap-x-4 border-t border-panel/15 py-4 first:border-t-0 first:pt-0 last:pb-0 sm:gap-x-5 sm:py-5">
              <span class="mt-1 font-mono text-2xs uppercase tracking-widest text-accent-600">{`0${i + 1}`}</span>
              <div>
                <h3 class="m-0 font-display text-base font-semibold tracking-tight text-panel sm:text-lg">
                  {c.title}
                </h3>
                <p class="m-0 mt-1 text-[0.9375rem] leading-snug text-accent-900/85 sm:hidden">{c.lead}</p>
                <p class="m-0 mt-2 hidden text-sm leading-relaxed text-accent-900/75 sm:block" style="text-wrap: pretty">
                  {c.body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import '../craft/craft-in'
</script>

<style>
  /* The sheet is checked, not decorated: once it is on screen the ticks are
     drawn one row after another, as someone going down the list with a pen.
     Without script or motion they are simply there. */
  @media (prefers-reduced-motion: no-preference) {
    .pruef-ticks path {
      stroke-dasharray: 1;
    }
    /* Hidden as well as undrawn: a round cap on a zero-length dash still
       prints a dot, which read as a tick waiting to happen. */
    .pruef-ticks:global(.craft-armed:not(.craft-in)) path {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    .pruef-ticks:global(.craft-in) path {
      --at: calc(var(--duration-quick) + var(--i) * var(--stagger-row));
      transition:
        stroke-dashoffset var(--duration-base) var(--ease-draft) var(--at),
        opacity 0s linear var(--at);
    }
  }
</style>
