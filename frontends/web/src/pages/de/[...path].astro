---
// `/de/...` is not a locale prefix this site serves — German lives at the root
// (`showDefaultLang` is false). Anything that guessed otherwise is redirected
// permanently rather than 404'd, so old links and hand-typed URLs still land.
export const prerender = false

return Astro.redirect(
  (Astro.url.pathname.replace(/^\/de(?=\/|$)/, '') || '/') + Astro.url.search,
  301
)
---
