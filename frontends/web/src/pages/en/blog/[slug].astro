---
import { getBlogPosts, postSlug } from '../../../lib/posts'
import BlogPostPage from '../../../components/blog/BlogPostPage.astro'
import EndInvite from '../../../components/molecules/EndInvite.astro'

export async function getStaticPaths() {
  const posts = await getBlogPosts('en')
  return posts.map((post) => ({ params: { slug: postSlug(post.id) }, props: { post } }))
}

const { post } = Astro.props
---

<BlogPostPage post={post} locale="en">
  <EndInvite locale="en" page="blog" />
</BlogPostPage>
