import { ui } from '../../i18n/ui'
import { SHARE_ART } from '../../lib/seo'

const t = ui.en.seo.pages.rechenweg
---

<BaseLayout locale="en" title={t.title} description={t.description} ogArt={SHARE_ART.rechenweg}>
  <Rechenweg locale="en" />
</BaseLayout>

<script>
  import { initReveals } from '../../scripts/reveal'
  import { initRoiWorking } from '../../scripts/roi'
  initReveals()
  initRoiWorking()
</script>
