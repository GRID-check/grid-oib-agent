---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import LandingPage from '../../../components/landing/LandingPage.astro'
import EndInvite from '../../../components/molecules/EndInvite.astro'
import { LANDING } from '../../../data/landing'
import { SECTIONS } from '../../../lib/landing'
import { landingLd } from '../../../lib/seo'

export function getStaticPaths() {
  return LANDING.glossar.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))
}
const { entry } = Astro.props
const c = entry.en
---

<BaseLayout
  locale="en"
  title={c.title}
  description={c.description}
  ogArt={SECTIONS.glossar.og}
  jsonLd={landingLd('en', 'glossar', entry, Astro.site)}
>
  <LandingPage locale="en" section="glossar" entry={entry} />
  <EndInvite locale="en" page="warum" />
</BaseLayout>
