---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Changelog from '../../components/organisms/Changelog.astro'
import EndInvite from '../../components/molecules/EndInvite.astro'
import { ui } from '../../i18n/ui'
import { SHARE_ART } from '../../lib/seo'

const t = ui.en.seo.pages.changelog
---

<BaseLayout locale="en" title={t.title} description={t.description} ogArt={SHARE_ART.changelog}>
  <Changelog locale="en" />
  <EndInvite locale="en" page="changelog" class="max-w-4xl" gutter="px-6 md:px-10" />
</BaseLayout>

<script>
  import { initReveals } from '../../scripts/reveal'
  initReveals()
</script>
