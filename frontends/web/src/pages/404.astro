---
import BaseLayout from '../layouts/BaseLayout.astro'
import Pill from '../components/atoms/Pill.astro'
---

<BaseLayout title="Seite nicht gefunden — Piloti" description="Diese Seite existiert nicht.">
  <section class="flex min-h-[70vh] flex-col items-center justify-center px-6 pb-24 pt-36 text-center">
    <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-accent-600">404</p>
    <h1
      class="mt-5 max-w-[560px] font-display text-[clamp(30px,4.6vw,48px)] font-semibold leading-[1.12] tracking-[-0.02em] text-ink"
    >
      Diese Seite liegt nicht im Plan.
    </h1>
    <p class="mt-5 max-w-[440px] text-[15.5px] leading-[1.65] text-ink-soft">
      Die gesuchte Seite existiert nicht oder wurde verschoben.
    </p>
    <div class="mt-9">
      <Pill href="/" variant="solid" size="lg">Zur Startseite</Pill>
    </div>
  </section>
</BaseLayout>
