---
import BaseLayout from '../layouts/BaseLayout.astro'
import Pill from '../components/atoms/Pill.astro'
import { ui } from '../i18n/ui'

const de = ui.de.notFound
const en = ui.en.notFound
---

<BaseLayout locale="de" title={de.metaTitle} description={de.metaDescription} alternates={false}>
  <section class="flex min-h-[70vh] flex-col items-center justify-center px-6 pb-24 pt-36 text-center">
    <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-accent-600">404</p>
    <div data-404-de>
      <h1
        class="mt-5 max-w-[560px] font-display text-[clamp(30px,4.6vw,48px)] font-semibold leading-[1.12] tracking-[-0.02em] text-ink"
      >
        {de.heading}
      </h1>
      <p class="mt-5 max-w-[440px] text-[15.5px] leading-[1.65] text-ink-soft">
        {de.body}
      </p>
      <div class="mt-9">
        <Pill href="/" variant="solid" size="lg">{de.home}</Pill>
      </div>
    </div>
    <div data-404-en hidden>
      <h1
        class="mt-5 max-w-[560px] font-display text-[clamp(30px,4.6vw,48px)] font-semibold leading-[1.12] tracking-[-0.02em] text-ink"
      >
        {en.heading}
      </h1>
      <p class="mt-5 max-w-[440px] text-[15.5px] leading-[1.65] text-ink-soft">
        {en.body}
      </p>
      <div class="mt-9">
        <Pill href="/en/" variant="solid" size="lg">{en.home}</Pill>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  if (window.location.pathname.startsWith('/en')) {
    document.documentElement.lang = 'en'
    document.title = 'Page not found — Piloti'
    const de = document.querySelector('[data-404-de]')
    const en = document.querySelector('[data-404-en]')
    if (de instanceof HTMLElement && en instanceof HTMLElement) {
      de.hidden = true
      en.hidden = false
    }
  }
</script>
