---
import BaseLayout from '../layouts/BaseLayout.astro'
import Pill from '../components/atoms/Pill.astro'
import { ui } from '../i18n/ui'

// One document serves both locales: a miss under /en/ has no route of its own to
// branch on, so the German copy is rendered and the inline script below swaps the
// text. It used to ship the two versions as two blocks, which meant two `h1`s in
// the document — one of them merely `hidden`, which is a heading-outline error a
// screen reader would still trip over on the visible one. Now the outline is
// fixed and only the words change.
const de = ui.de.notFound
const en = ui.en.notFound
---

<BaseLayout
  locale="de"
  title={de.metaTitle}
  description={de.metaDescription}
  alternates={false}
  noindex
>
  <section
    class="section-shell flex min-h-[70vh] flex-col items-center justify-center pb-24 pt-36 text-center"
  >
    <p class="font-mono text-2xs uppercase tracking-widest text-ink-faint">404</p>
    <h1 data-404-heading class="mt-5 max-w-xl font-display text-h2 text-ink" style="text-wrap: balance">
      {de.heading}
    </h1>
    <p data-404-body class="mt-5 max-w-md text-base leading-relaxed text-ink-soft">
      {de.body}
    </p>
    <div class="mt-9" data-404-home>
      <Pill href="/" variant="solid" size="lg">{de.home}</Pill>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ en }}>
  if (window.location.pathname.startsWith('/en')) {
    document.documentElement.lang = 'en'
    document.title = en.metaTitle
    document.querySelector('meta[name="description"]')?.setAttribute('content', en.metaDescription)
    const set = (sel, text) => {
      const el = document.querySelector(sel)
      if (el) el.textContent = text
    }
    set('[data-404-heading]', en.heading)
    set('[data-404-body]', en.body)
    const home = document.querySelector('[data-404-home] a')
    if (home) {
      home.textContent = en.home
      home.setAttribute('href', '/en/')
    }
  }
</script>
