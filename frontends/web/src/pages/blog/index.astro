---
import { getBlogPosts, postSlug } from '../../lib/posts'
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionTag from '../../components/atoms/SectionTag.astro'
import BlogCard from '../../components/molecules/BlogCard.astro'
import { ui } from '../../i18n/ui'

const t = ui.de.blog
const posts = await getBlogPosts('de')
---

<BaseLayout locale="de" title={t.metaTitle} description={t.metaDescription}>
  <section class="px-6 pb-28 pt-36 md:px-10">
    <div class="mx-auto max-w-5xl">
      <SectionTag>{t.tag}</SectionTag>
      <h1
        class="mt-6 max-w-2xl font-serif text-h3 text-ink"
      >
        {t.heading}
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft">
        {t.intro}
      </p>

      {
        posts.length === 0 ? (
          <p class="mt-16 rounded-card bg-white p-10 text-center text-base text-ink-soft">
            {t.empty}
          </p>
        ) : (
          <div data-reveal class="mt-14 grid gap-6 md:grid-cols-2">
            {posts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                href={`/blog/${postSlug(post.id)}/`}
                locale="de"
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { initReveals } from '../../scripts/reveal'
  initReveals()
</script>
