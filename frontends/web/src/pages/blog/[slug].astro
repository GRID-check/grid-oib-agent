---
import { getBlogPosts, postSlug } from '../../lib/posts'
import BlogPostPage from '../../components/blog/BlogPostPage.astro'

export async function getStaticPaths() {
  const posts = await getBlogPosts('de')
  return posts.map((post) => ({ params: { slug: postSlug(post.id) }, props: { post } }))
}

const { post } = Astro.props
---

<BlogPostPage post={post} locale="de" />
