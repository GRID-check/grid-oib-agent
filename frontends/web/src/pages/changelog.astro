---
import BaseLayout from '../layouts/BaseLayout.astro'
import Changelog from '../components/organisms/Changelog.astro'
import EndInvite from '../components/molecules/EndInvite.astro'
import { ui } from '../i18n/ui'
import { SHARE_ART } from '../lib/seo'

const t = ui.de.seo.pages.changelog
---

<BaseLayout locale="de" title={t.title} description={t.description} ogArt={SHARE_ART.changelog}>
  <Changelog locale="de" />
  <EndInvite locale="de" page="changelog" />
</BaseLayout>

<script>
  import { initReveals } from '../scripts/reveal'
  initReveals()
</script>
