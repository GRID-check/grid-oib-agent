---
/**
 * The project mail inbox help page, prerendered at the one path in
 * `MAIL_INBOX_SLUG` (src/consts.ts). A route of its own rather than a file
 * named after the slug, so the URL the app and the bounce text link to is
 * written once.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import MailInbox from '../components/organisms/MailInbox.astro'
import EndInvite from '../components/molecules/EndInvite.astro'
import { MAIL_INBOX_SLUG } from '../consts'
import { ui } from '../i18n/ui'
import { SHARE_ART, pageLd } from '../lib/seo'

export const getStaticPaths = () => [{ params: { mailInbox: MAIL_INBOX_SLUG } }]

const t = ui.de.seo.pages.mailInbox
---

<BaseLayout
  locale="de"
  title={t.title}
  description={t.description}
  ogArt={SHARE_ART.mailInbox}
  jsonLd={pageLd('de', t.title, Astro.url.pathname, Astro.site)}
>
  <MailInbox locale="de" />
  <EndInvite locale="de" page="mailInbox" />
</BaseLayout>
