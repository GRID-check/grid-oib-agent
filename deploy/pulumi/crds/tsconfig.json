{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "gateway/index.ts",
        "gateway/v1/gateway.ts",
        "gateway/v1/gatewayClass.ts",
        "gateway/v1/gatewayClassList.ts",
        "gateway/v1/gatewayClassPatch.ts",
        "gateway/v1/gatewayList.ts",
        "gateway/v1/gatewayPatch.ts",
        "gateway/v1/httproute.ts",
        "gateway/v1/httprouteList.ts",
        "gateway/v1/httproutePatch.ts",
        "gateway/v1/index.ts",
        "gateway/v1alpha1/backendTrafficPolicy.ts",
        "gateway/v1alpha1/backendTrafficPolicyList.ts",
        "gateway/v1alpha1/backendTrafficPolicyPatch.ts",
        "gateway/v1alpha1/clientTrafficPolicy.ts",
        "gateway/v1alpha1/clientTrafficPolicyList.ts",
        "gateway/v1alpha1/clientTrafficPolicyPatch.ts",
        "gateway/v1alpha1/envoyProxy.ts",
        "gateway/v1alpha1/envoyProxyList.ts",
        "gateway/v1alpha1/envoyProxyPatch.ts",
        "gateway/v1alpha1/index.ts",
        "gateway/v1beta1/gateway.ts",
        "gateway/v1beta1/gatewayClass.ts",
        "gateway/v1beta1/gatewayClassList.ts",
        "gateway/v1beta1/gatewayClassPatch.ts",
        "gateway/v1beta1/gatewayList.ts",
        "gateway/v1beta1/gatewayPatch.ts",
        "gateway/v1beta1/httproute.ts",
        "gateway/v1beta1/httprouteList.ts",
        "gateway/v1beta1/httproutePatch.ts",
        "gateway/v1beta1/index.ts",
        "index.ts",
        "provider.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
