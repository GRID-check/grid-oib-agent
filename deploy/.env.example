# AI-Q Blueprint - Environment Configuration
#
# Copy to .env and set your values:
#   cp deploy/.env.example deploy/.env

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
PYTHONWARNINGS=ignore
AIQ_DEV_ENV=cli

# -----------------------------------------------------------------------------
# API Keys (required for core functionality)
# -----------------------------------------------------------------------------
# Kimi (Moonshot AI) OpenAI-compatible API key
KIMI_API_KEY=

# OpenRouter API key (used for embeddings and VLM when routing through OpenRouter)
# OPENROUTER_API_KEY=

# Euros per 1 USD used to compare EUR budget limits against the USD costs
# OpenRouter reports per generation (org budgets default: 10 EUR/day, 100 EUR/month).
# GRID_BUDGET_EUR_PER_USD=0.86

# NVIDIA API key for NIM inference models (set to OpenRouter key when routing through OpenRouter)
NVIDIA_API_KEY=

# Grid admin token (change in production)
GRID_ADMIN_TOKEN=change-me-in-production

# Web search (Required)
TAVILY_API_KEY=

# Paper search (Optional)
# SERPER_API_KEY=   # to enable, set API key and update the relevant config in configs/ directory


# -----------------------------------------------------------------------------
# Job store (async jobs)
# SQLite: sqlite+aiosqlite:///./data/jobs.db
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/aiq_jobs
# -----------------------------------------------------------------------------
# NAT_JOB_STORE_DB_URL=
# NAT_CONFIG_FILE=
# NAT_DASK_SCHEDULER_ADDRESS=
# Reduce Dask log noise (optional)
DASK_DISTRIBUTED__LOGGING__DISTRIBUTED=warning

# -----------------------------------------------------------------------------
# Checkpoint DB (LangGraph state)
# SQLite: ./checkpoints.db  |  PostgreSQL: postgresql://user:pass@host:5432/aiq_checkpoints
# -----------------------------------------------------------------------------
# AIQ_CHECKPOINT_DB=

# -----------------------------------------------------------------------------
# Summary DB (document summaries for agents)
# SQLite: sqlite+aiosqlite:///./summaries.db  |  PostgreSQL: postgresql+psycopg://...
# -----------------------------------------------------------------------------
# AIQ_SUMMARY_DB=

# -----------------------------------------------------------------------------
# Intake consistency-check LLM (POST /v1/consistency-check)
# Each var falls back to the generic LLM_MODEL/LLM_API_KEY/LLM_BASE_URL, then to
# a default pair chosen by whether OPENROUTER_API_KEY is set: openai/gpt-5.6-luna
# @ openrouter.ai when it is, gpt-4o-mini @ api.openai.com when it is not.
# NOTE: model, base URL and key resolve INDEPENDENTLY — setting one does not move
# the others, so an explicit model must be one the explicit base URL serves (and
# the key must be for that provider). Best-effort:
# with no key resolvable the endpoint returns error=llm_not_configured and the
# wizard still saves. Usually leave unset to reuse OPENROUTER_API_KEY.
# CONSISTENCY_LLM_MODEL=openai/gpt-5.6-luna
# CONSISTENCY_LLM_API_KEY=
# CONSISTENCY_LLM_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Tag backfill script (scripts/backfill_document_tags.py) — one-off, runs
# OUTSIDE the NAT runtime, so it builds its own OpenAI-compatible client. These
# MUST match the summary_llm block in configs/config_*.yml.
#   BACKFILL_SUMMARY_API_KEY — required (falls back to NVIDIA_API_KEY); missing
#     -> the script exits 2. Exit 1 = a real run finished with per-row failures.
#   BACKFILL_SUMMARY_BASE_URL — default https://integrate.api.nvidia.com/v1
#   BACKFILL_SUMMARY_MODEL    — default nvidia/nemotron-mini-4b-instruct
# BACKFILL_SUMMARY_API_KEY=
# BACKFILL_SUMMARY_BASE_URL=https://integrate.api.nvidia.com/v1
# BACKFILL_SUMMARY_MODEL=nvidia/nemotron-mini-4b-instruct

# -----------------------------------------------------------------------------
# Environment Variables for Modal Sandbox for Skills Execution (optional)
# -----------------------------------------------------------------------------
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Observability / Tracing (optional)
# -----------------------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=aiq-research
# WANDB_API_KEY=

# -----------------------------------------------------------------------------
# Langfuse — durable LLM observability (ADR-0044), self-hosted OSS
# -----------------------------------------------------------------------------
# OPT-IN in compose. Nothing below is read unless you start the profile:
#
#   cd deploy/compose
#   docker compose --env-file ../.env -f docker-compose.yaml --profile langfuse up -d
#
# Then http://localhost:3100, signing in with LANGFUSE_INIT_USER_* below.
#
# Every value here has a working laptop default in docker-compose.yaml, so the
# profile runs with none of them set. Set them for anything shared — and note
# that on Kubernetes NONE of these apply: that tier is configured through
# `pulumi config set grid-oib:langfuse*` (see deploy/pulumi/README.md), where
# they are required rather than defaulted, because the tier is not deployed at
# all until they exist.
#
# Note the free/OSS build has no data-retention policy (that is an Enterprise
# feature), so a long-lived local stack grows until you drop the volume.
#
# There is deliberately NO LANGFUSE_DB_PASSWORD here. The `langfuse_app` role is
# created by `deploy/compose/init-db.sql`, which Postgres runs VERBATIM — it is
# a .sql file, not a template, so nothing substitutes an environment variable
# into it. A variable the DSN honoured and the role did not would break the
# profile with `password authentication failed`, on a fresh volume, for someone
# who did exactly what this file told them to. The compose password is fixed at
# `langfuse_dev`; change it in init-db.sql if you need to, and remember that
# only takes effect on a fresh volume.
# ClickHouse login. URL-SAFE CHARACTERS ONLY (A-Za-z0-9._~-) — Langfuse's
# ClickHouse migrator interpolates this into a connection-string query parameter
# without encoding it, so a `+` or the `=` that `openssl rand -base64 32` always
# ends with breaks the migration and crash-loops langfuse-web. Use:
#   openssl rand -hex 32
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_NEXTAUTH_SECRET=        # openssl rand -base64 32
# LANGFUSE_SALT=                   # openssl rand -base64 32
#
# ENCRYPTION_KEY is the ONE secret here that is HEX, not base64 — 64 characters
# exactly. A base64 value is 44 characters and makes Langfuse crash-loop at
# startup without naming the variable, so it is worth getting right first time:
#   openssl rand -hex 32
# LANGFUSE_ENCRYPTION_KEY=
#
# Project API keys, pre-seeded at first boot (headless initialization). The
# prefixes are validated by Langfuse — `pk-lf-` and `sk-lf-` are not decorative:
#   echo "pk-lf-$(openssl rand -hex 16)"; echo "sk-lf-$(openssl rand -hex 16)"
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
#
# The account the local UI signs in with.
# LANGFUSE_INIT_USER_EMAIL=dev@grid.local
# LANGFUSE_INIT_USER_PASSWORD=
#
# S3 identity for the trace archive. Scoped to the `langfuse` bucket alone —
# keep it DISTINCT from SEAWEED_SECRET_KEY, or the Langfuse tier authenticates
# as the root identity and gains every bucket in the deployment.
# SEAWEED_LANGFUSE_ACCESS_KEY=grid-langfuse
# SEAWEED_LANGFUSE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Evaluation (optional)
# -----------------------------------------------------------------------------
# JINA_API_KEY=

# -----------------------------------------------------------------------------
# Frontend File Upload Configuration
# -----------------------------------------------------------------------------
# These settings control file upload validation in the knowledge layer.
# Values should match backend limits for consistent user experience.

# Accepted file extensions (comma-separated, include leading dots).
# Default matches LlamaIndex backend. For Foundational RAG, add .pptx:
#   FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.docx,.pptx,.txt,.md
# This list governs NON-image types only. Image types (.png,.jpg,.jpeg) are
# handled automatically: they are offered whenever the WorkOS `image-upload`
# flag allows AND a VLM is configured (AIQ_VLM_* below) — you no longer add
# them here. Listing images here has no effect without a VLM (they stay
# excluded), and is unnecessary with one. See the AIQ_VLM_* note below.
FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.docx,.txt,.md

# Maximum total file size in MB
FILE_UPLOAD_MAX_SIZE_MB=100

# Maximum number of files per session
FILE_UPLOAD_MAX_FILE_COUNT=10

# Hours after upload before files may expire on the backend (0 = no expiry shown),
#this should ideally match TTL of the files on the backend (e.g. 12 hours)
FILE_EXPIRATION_CHECK_INTERVAL_HOURS=0

# -----------------------------------------------------------------------------
# Embedding Model Environment Variables (optional, NVIDIA hosted models are used by default)
# -----------------------------------------------------------------------------
# AIQ_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
# AIQ_EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
#
# VLM Model Environment Variables (optional, defaults route through NVIDIA)
# To use OpenRouter instead, set AIQ_VLM_BASE_URL, AIQ_VLM_MODEL, and AIQ_VLM_API_KEY.
# NOTE: docker compose env_file does NOT interpolate ${VAR} references — never
# write AIQ_VLM_API_KEY=${OPENROUTER_API_KEY} here; paste the actual key value.
# AIQ_VLM_MODEL=nvidia/nemotron-nano-12b-v2-vl
# AIQ_VLM_BASE_URL=https://integrate.api.nvidia.com/v1
# AIQ_VLM_API_KEY=
#
# Visual/vector-drawing pages: when a VLM key is set, text-sparse or
# vector-heavy PDF pages (architectural plans, sections, elevations,
# perspectives) are rendered to a full-page image and VLM-captioned so their
# drawing type, scale and spatial relationships are captured — and the document
# summary describes the drawing instead of a licence watermark. On by default;
# fires only on pages the heuristic flags as visual, so text PDFs cost nothing.
# Tunables (defaults shown):
# AIQ_RENDER_VISUAL_PAGES=true
# AIQ_PAGE_RENDER_MAX_DIM=2048
# AIQ_VISUAL_PAGE_MIN_TEXT_CHARS=200
# AIQ_VISUAL_PAGE_MIN_PATHS=300
# AIQ_MAX_RENDERED_PAGES=20
#
# Ingestion pipeline tuning (defaults shown):
# AIQ_VLM_BATCH_WORKERS=4        # concurrent VLM caption calls per file
# AIQ_VLM_TIMEOUT_SECONDS=180    # per-request VLM timeout (single retry)
# AIQ_EMBED_BATCH_SIZE=64        # texts per embedding HTTP call
#
# Standalone image upload (.png/.jpg/.jpeg) becomes available AUTOMATICALLY when
# both hold: a VLM is configured here (AIQ_VLM_*) AND the WorkOS `image-upload`
# feature flag (FB-15a) is enabled for the org. The backend derives a
# `vlm_available` capability from the VLM key and the frontend offers image
# types only when flag AND capability are true — no manual FILE_UPLOAD_ACCEPTED_
# TYPES opt-in is required (and adding images there without a VLM keeps them
# excluded, so a VLM-less deployment can never accept an upload that would fail
# ingestion). The accepted-types env override still applies to non-image types.
#
# Set to true to force re-ingestion of all OIB PDFs on next startup (removes registry)
# OIB_FORCE_REINGEST=true
#
# Image Extraction Environment Variables (optional)
# AIQ_EXTRACT_TABLES=false
# AIQ_EXTRACT_IMAGES=false
# AIQ_EXTRACT_CHARTS=false
#
# -----------------------------------------------------------------------------
# RAG Server and Ingestor URLs (required for knowledge layer)
# -----------------------------------------------------------------------------

# RAG_SERVER_URL=http://localhost:8081/v1
# RAG_INGEST_URL=http://localhost:8082/v1


# -----------------------------------------------------------------------------
# SeaweedFS / S3-compatible object storage (Docker Compose)
# -----------------------------------------------------------------------------
# The SECRET keys below have no default in docker-compose.yaml — the stack
# refuses to start without them, rather than falling back to a literal shared by
# every install that never set one. Generate all three at once:
#
#   for v in SEAWEED_SECRET_KEY SEAWEED_READONLY_SECRET_KEY \
#            SEAWEED_TENANT_ADMIN_SECRET_KEY; do
#     echo "$v=$(openssl rand -hex 24)" >> deploy/.env
#   done
#
# The ACCESS keys do have defaults, and can stay commented out: they are identity
# names matched against the generated s3.json, not credentials.
# SEAWEED_ENDPOINT=http://seaweedfs:8333
# SEAWEED_ACCESS_KEY=seaweedadmin
# SEAWEED_SECRET_KEY=<generate one>
# SEAWEED_BUCKET=grid-documents
# SEAWEED_PRESIGNED_URL_TTL_SECONDS=600

# ── Storage quota (ADR-0042) ─────────────────────────────────────────────────
# Fleet-wide default quota in bytes, applied to any organization with no value of
# its own. Unset means UNLIMITED, which is what every deployment has until an
# operator chooses otherwise — introducing quotas must not retroactively block
# tenants who were never given a limit. A per-org value always wins.
# GRID_DEFAULT_STORAGE_QUOTA_BYTES=53687091200

# Share of the quota at which an organization is warned in its inbox, so the
# first person to learn the limit exists is not whoever's upload happens to
# break. Escalates again at 90% and 100%. Swept hourly by the `storage-alerts`
# CronJob via the token-guarded POST /api/internal/storage/alerts.
# GRID_STORAGE_ALERT_THRESHOLD_PERCENT=80

# Per-organization buckets (ADR-0043). `true` writes each org's objects into its
# own bucket instead of a key prefix inside SEAWEED_BUCKET. Safe to flip: the
# bucket is recorded on every document row, so existing objects stay readable
# where they are and only new writes move. Frontend only: the purge reads which
# buckets a project's documents recorded rather than deriving them, so it needs
# no naming rule and no flag — which is also why a rollback cannot make it miss
# a tenant bucket.
# SEAWEED_PER_ORG_BUCKETS=false
# SEAWEED_TENANT_BUCKET_PREFIX=grid-org-

# Read-only credential for the agent tier (ADR-0039). `view_knowledge_image`
# only ever calls get_object, so it gets an identity with Read and nothing else —
# not the keys above, which carry Write and Tagging on every document bucket.
# `agent-worker` inherits this through `extends`.
# SEAWEED_READONLY_ACCESS_KEY=grid-backend-read
# SEAWEED_READONLY_SECRET_KEY=<generate one>

# Credential allowed to CREATE and DROP tenant buckets — separate from the keys
# above because SeaweedFS grants CreateBucket and DeleteBucket as one action.
# Frontend only; the purger is deliberately not given it — an unattended queue
# worker is the last process that should be able to drop a bucket. Unset falls
# back to SEAWEED_ACCESS_KEY / SEAWEED_SECRET_KEY, which has no Admin grant at
# all, so bucket creation FAILS rather than proceeding with wider authority than
# intended — fine while per-org buckets are off, and a clear error when they are
# not.
#
# No default value here on purpose: a working credential in a committed example
# is a credential, and this one can drop a tenant's entire bucket. Generate one
# (`openssl rand -base64 24`) per environment. In Compose the secret half is
# required outright — the fallback described above is the FRONTEND's, for
# deployments (Kubernetes) where the variable can legitimately be absent.
# SEAWEED_TENANT_ADMIN_ACCESS_KEY=grid-tenant-admin
# SEAWEED_TENANT_ADMIN_SECRET_KEY=<generate one>

# -----------------------------------------------------------------------------
# Frontend (UI) runtime configuration (Docker Compose)
# -----------------------------------------------------------------------------
# These variables are consumed by docker-compose.yaml.
# The compose files map them into the UI container as REQUIRE_AUTH and BACKEND_URL.

# Set to true to require WorkOS AuthKit login. False (default) uses a default user.
# REQUIRE_AUTH=false

# Backend URL used by the UI container.
# BACKEND_URL=http://aiq-agent:8000

# Grid application database used by the Next.js BFF and both workers.
#
# This connects as grid_app_rw — the LEAST-PRIVILEGE role: DML only, no DDL, and
# subject to row-level security, so a query that loses its organization filter
# returns no rows instead of another tenant's (ADR-0041). Do not point it at the
# owner credential; RLS does not apply to a table's owner and enforcement would
# silently stop.
# GRID_APP_DATABASE_URL=postgresql://grid_app_rw:grid_app_rw_dev@postgres:5432/grid_app  # pragma: allowlist secret (local compose default, same class as aiq_dev above)

# Password for grid_app_rw. init-db.sql sets this on the role at container start
# (dev default: grid_app_rw_dev). Set a real one outside local development.
# GRID_APP_RUNTIME_PASSWORD=grid_app_rw_dev

# Owner credential, used ONLY by whatever runs `drizzle-kit migrate` (the
# `grid-migrate` service, or the Kubernetes migration Job). DDL needs the schema
# owner, and a data backfill run as grid_app_rw would silently update zero rows.
#
# REQUIRED for any deployment. drizzle.config.ts does fall back to
# GRID_APP_DATABASE_URL, but that fallback only works when that URL still holds a
# legacy OWNER credential — pointed at grid_app_rw as documented above, a
# migration cannot run DDL at all. Treat it as a single-credential-local-database
# convenience, not as a supported deployment shape.
# GRID_APP_MIGRATION_DATABASE_URL=postgresql://aiq:aiq_dev@postgres:5432/grid_app

# Max number of PostgreSQL connections the BFF connection pool holds open.
# Bounds resource use and makes connection acquisition fail fast under load
# instead of piling requests up behind a saturated/unreachable database.
# Default 10. Raise only if you also raise Postgres' max_connections headroom.
# GRID_DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# Internal service API (backend `remember` tool -> frontend BFF write path)
# -----------------------------------------------------------------------------
# Shared service token guarding POST /api/internal/memory and
# GET /api/internal/health. It MUST be identical on all three services that use
# it: aiq-agent, frontend, and purger. Behavior of the frontend guard:
#   - mismatch (agent value != frontend value) -> 403 (the `remember` tool fails)
#   - unset, OR the well-known dev default ("grid-internal-dev-token") in a
#     non-dev environment (APP_ENV not development/dev/local) -> 503 (disabled)
# NOTE: the frontend service does NOT read this .env file — its value is supplied
# via compose interpolation (${GRID_INTERNAL_API_TOKEN}) in docker-compose.yaml.
# Setting it here feeds that interpolation for all services at once.
# GRID_INTERNAL_API_TOKEN=grid-internal-dev-token

# Allow the agent's `remember` tool to write ORGANIZATION-scoped (firm-wide)
# memory via the internal API. Default false (audit finding S1 default-deny):
# an org item lands in every project's digest across the tenant and the service
# token cannot verify the human's org role, so autonomous/prompt-injected org
# writes are refused with 403 ORG_MEMORY_DISABLED. Set true ONLY if you accept
# that risk; org-wide findings are otherwise added by hand in the org-memory panel.
# GRID_ALLOW_AGENT_ORG_MEMORY=false

# WorkOS AuthKit settings (required when REQUIRE_AUTH=true)
# WORKOS_CLIENT_ID=client_xxx
# WORKOS_API_KEY=sk_test_xxx
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# WORKOS_COOKIE_PASSWORD=replace-with-32-byte-random-string

# Base URL of the public landing site (frontends/web). When REQUIRE_AUTH=true,
# the signed-out root of the app redirects here instead of showing the retired
# in-app marketing page. Unset = fall back to the WorkOS sign-in URL.
# GRID_LANDING_URL=https://dev.piloti.at


# -----------------------------------------------------------------------------
# Backend configuration (Docker Compose)
# -----------------------------------------------------------------------------
# Workflow config file used by the backend server in Docker Compose.
# The compose stacks mount `configs/` into the container at `/app/configs`.
#
# Examples:
# - /app/configs/config_web_default_llamaindex.yml
# - /app/configs/config_web_kimi.yml
# - /app/configs/config_oib_openrouter.yml (OpenRouter; the model for each AGENT
#   GROUP comes from the database — platform default, org override. summary_llm
#   and rerank_llm have no agent group and always use this file.)
BACKEND_CONFIG=/app/configs/config_oib_openrouter.yml
#
# Chroma collection and persistence
COLLECTION_NAME=oib_knowledge
AIQ_CHROMA_DIR=/app/data/chroma_data
#
# Optional NAT span request tag enrichment for aiq_api auth middleware:
# AIQ_TRACE_USER_IDENTITY_MODE=none
# AIQ_TRACE_USER_IDENTITY_HMAC_SECRET=
# AIQ_TRACE_CLIENT_ID_MODE=none
# AIQ_TRACE_CLIENT_ID_HMAC_SECRET=
# AIQ_TRACE_CLIENT_IP_HEADERS=x-real-ip,x-forwarded-for

# Platform tier (ADR-0016)
# Break-glass bootstrap: comma-separated emails treated as platform owner
# before/without WorkOS provisioning. Leave empty in steady state.
# GRID_PLATFORM_OWNER_EMAILS=
# External id of the GRID Platform organization in WorkOS (default grid-platform).
# GRID_PLATFORM_ORG_EXTERNAL_ID=grid-platform
# Set true to disable self-service organization creation (invite-only platform).
# GRID_DISABLE_SELF_SERVE_ORGS=false
# Feature flags (WorkOS-native). Set true ONLY after the flag slugs
# (runtime-model-config, deep-research, byok-llm, web-search) exist in WorkOS
# and orgs are targeted; while false, all features stay available. Enforced
# tokens without the feature_flags claim fail closed until the user signs in
# again.
# GRID_ENFORCE_FEATURE_FLAGS=false
# Collaboration (ADR-0032..0035): shared chats, @-mentions with the agent
# hand-off, and the inbox. Dark-launched and DEFAULT-DENY (not fail-open like
# an ordinary flag) because it changes who can see a conversation: while
# GRID_ENFORCE_FEATURE_FLAGS is false this is the only switch that shows the
# inbox nav entry, the share surfaces and the mention picker, and that enables
# the /api/inbox/*, /api/sharing/*, /api/mentions/* and /api/stream routes.
# With enforcement on, the per-org `collaboration` WorkOS flag decides instead.
# GRID_COLLABORATION_ENABLED=false

# IFC/BIM models (ADR-0045): .ifc upload, the model workspace, the WebGPU
# viewer, the Pruefbuch and the agent's ifc_query tool. ON by default. While
# GRID_ENFORCE_FEATURE_FLAGS is false this is the switch that puts .ifc in the
# upload accept-list, shows the Model nav entry and page, and enables the
# /api/**/bim/* routes and the agent's model queries; set it to false to
# withdraw the feature WITHOUT turning on flag enforcement for everything else.
# With enforcement on, the per-org `ifc-models` WorkOS flag decides instead.
# GRID_IFC_MODELS_ENABLED=true

# Whether Piloti may file the documents it writes (a finished Recherchebericht, a
# drawn diagram) into a project. ON unless set to a falsey value. The per-TENANT
# lever is the `project:documents:generate` permission; this one is the
# operator's, and stops filing for every organization at once.
# GRID_AGENT_AUTHORED_DOCUMENTS_ENABLED=true

# IFC bounds. Both optional; the defaults below are the built-ins.
# BIM_MAX_IFC_BYTES is BOTH the upload ceiling for a .ifc AND the largest file
# the BFF will parse -- one number, so the two layers cannot disagree. It is
# deliberately independent of FILE_UPLOAD_MAX_SIZE_MB (100 MB), which is sized
# for documents: an Einreichung model is routinely 50-500 MB, and measuring one
# against the document limit refused it for being a big FILE. Parsing runs in
# the Node process, so raise it only alongside moving extraction out of the
# request path. BIM_ELEMENT_LIMIT caps bim_elements rows per model; the
# summary's counts stay EXACT above the cap and summary.truncatedAt records
# that the element LIST was cut.
# BIM_MAX_IFC_BYTES=262144000
# BIM_ELEMENT_LIMIT=200000

# BYOK LLM credentials (ADR-0022). Where tenant API keys are stored:
# 'vault' (WorkOS Vault, per-org envelope encryption -- the production path,
# default when WORKOS_API_KEY is set) or 'local' (AES-256-GCM under the KEK
# below; anonymous/dev deployments). Generate a KEK with:
#   openssl rand -base64 32
# GRID_BYOK_SECRET_BACKEND=
# GRID_BYOK_LOCAL_KEK=
# Allow org admins to point BYOK base URLs at private-network hosts (only for
# deployments fronting a self-hosted OpenAI-compatible gateway).
# GRID_BYOK_ALLOW_PRIVATE_BASE_URLS=false

# Shared cache + scaling knobs (ADR-0019/0020, scaling review 2026-07)
# Redis-protocol URL of the shared cache. Compose wires this to the dragonfly
# service automatically; unset = per-process in-memory fallback.
# REDIS_URL=redis://dragonfly:6379/0
# Max WebSocket upgrades per client IP per minute at the gateway (0 disables).
# GRID_WS_UPGRADE_RATE_LIMIT=30
# Admission control for async research jobs: global and per-org caps on
# non-terminal jobs (0 disables).
# GRID_MAX_ACTIVE_JOBS=8
# GRID_MAX_ACTIVE_JOBS_PER_ORG=3
# Max concurrent document-ingestion jobs per backend process.
# AIQ_INGEST_MAX_WORKERS=2
# Post-answer stage bounds per backend process, shared across ALL stages
# (memory reflection and follow-up questions). The resource under pressure is
# the event loop that is also delivering live answers, so the cap is one pool,
# not one per stage.
# GRID_STAGE_MAX_CONCURRENCY=4
# GRID_STAGE_MAX_PENDING=16
# Reflection runtime gate when GRID_ENFORCE_FEATURE_FLAGS is off (default ON;
# with enforcement on, the WorkOS `memory-reflection` flag decides instead).
# GRID_MEMORY_REFLECTION_ENABLED=true
# Follow-up-questions stage gate when GRID_ENFORCE_FEATURE_FLAGS is off
# (default ON; with enforcement on, the WorkOS `post-answer-follow-ups` flag
# decides instead). It shipped OFF, as every new stage does, and now defaults ON
# because the in-answer `follow_ups` CARD it replaces has been retired: this
# stage is the only thing that produces follow-up questions, so leaving the
# default OFF would mean a deployment with none at all. Set it to `false` to
# turn the rail off; the answer is unaffected either way.
# GRID_STAGE_FOLLOW_UPS_ENABLED=true
