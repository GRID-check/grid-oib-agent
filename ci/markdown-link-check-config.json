{
    "ignorePatterns": [
        {
            "pattern": "^https?://"
        },
        {
            "pattern": "^mailto:"
        }
    ],
    "replacementPatterns": [
        {
            "pattern": "^/",
            "replacement": "{{BASEURL}}/"
        }
    ],
    "timeout": "20s",
    "retryOn429": true,
    "retryCount": 3,
    "fallbackRetryDelay": "30s"
}
